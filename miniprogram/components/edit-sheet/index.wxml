<!-- 底部编辑表单 -->
<!-- catchtouchmove：阻断拖动穿透到宿主页滚动/下拉（report 页 enablePullDownRefresh，无拦截时表单打开下拉会刷新报告） -->
<view class="overlay" wx:if="{{visible}}" catchtap="onClose" catchtouchmove="onNoop" aria-label="关闭表单">
  <!-- catchtap：阻止 sheet 内 tap 冒泡到 overlay onClose（原缺失导致点击表单字段/picker 栏即关闭——report 页其他 sheet 均有 onSheetNoop 守卫，此处遗漏） -->
  <view class="sheet" catchtap="onNoop">
    <view class="sheet-header">
      <text class="sheet-title">{{title}}</text>
      <view class="sheet-close pressable" bindtap="onClose" aria-label="关闭"><image class="sheet-close-icon" src="/images/close.svg" mode="aspectFit" /></view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <block wx:for="{{fields}}" wx:key="key">
        <!-- 信息分组标题（与识别卡片 sheet 分组结构一致，view/edit 两态通用） -->
        <view wx:if="{{item.isGroup}}" class="form-group-title">{{item.label}}</view>
        <!-- 查看态：label + value 横排只读（置信度低字段保留 ⚠️ 与底色） -->
        <view wx:elif="{{mode === 'view'}}" class="form-row form-row--view {{item.tone ? 'tone-' + item.tone : ''}}">
          <text class="form-label">{{item.label}}<text wx:if="{{item.required}}" class="req">*</text><text wx:if="{{item.tone && !item.modified}}" class="tone-badge">⚠️</text></text>
          <text class="form-view-val {{item.value ? '' : 'form-view-val--empty'}}">{{item.value || '--'}}</text>
        </view>
        <!-- 编辑态：横排 label + input/picker -->
        <view wx:else class="form-row form-row-{{item.key}} {{item.error ? 'has-error' : ''}} {{item.tone ? 'tone-' + item.tone : ''}} {{item.modified ? 'tone-modified' : ''}}">
          <text class="form-label">{{item.label}}<text wx:if="{{item.required}}" class="req">*</text><text wx:if="{{item.tone && !item.modified}}" class="tone-badge">⚠️</text></text>
          <!-- 原生 picker 分支（原生组件审计）：selector=固定枚举（角色/险种/负债类型）、date=生效日期 -->
          <picker wx:if="{{item.type === 'selector'}}" mode="selector" range="{{item.options}}" data-key="{{item.key}}" bindchange="onFieldPicker" aria-label="{{item.label}}">
            <view class="form-input form-picker">
              <text wx:if="{{item.value}}" class="form-picker-text">{{item.value}}</text>
              <text wx:else class="form-picker-placeholder">{{item.placeholder}}</text>
              <text class="form-picker-arrow">▾</text>
            </view>
          </picker>
          <picker wx:elif="{{item.type === 'date'}}" mode="date" value="{{item.value}}" start="1900-01-01" end="2099-12-31" data-key="{{item.key}}" bindchange="onFieldPicker" aria-label="{{item.label}}">
            <view class="form-input form-picker">
              <text wx:if="{{item.value}}" class="form-picker-text">{{item.value}}</text>
              <text wx:else class="form-picker-placeholder">{{item.placeholder}}</text>
              <text class="form-picker-arrow">▾</text>
            </view>
          </picker>
          <input wx:else class="form-input" value="{{item.value}}" placeholder="{{item.placeholder}}" data-key="{{item.key}}" type="{{item.type || 'text'}}" bindinput="onFieldInput" bindblur="onFieldBlur" aria-label="{{item.label}}" />
          <text wx:if="{{item.helper}}" class="form-helper">{{item.helper}}</text>
          <text wx:if="{{item.error}}" class="form-error" role="alert">{{item.error}}</text>
        </view>
      </block>
    </scroll-view>
    <view class="sheet-actions">
      <!-- 取消按钮（两态共用） -->
      <button class="cancel-btn pressable" bindtap="onClose" disabled="{{saving}}" aria-label="取消">取消</button>
      <!-- 查看态：编辑按钮；编辑态：保存按钮（互斥切换） -->
      <button wx:if="{{mode === 'view'}}" class="edit-btn pressable" bindtap="onSwitchEdit" disabled="{{saving}}" aria-label="编辑">编辑</button>
      <button wx:else class="save-btn pressable {{saving ? 'is-loading' : ''}}" bindtap="onSave" disabled="{{saving}}" aria-label="保存">{{saving ? '保存中...' : '保存'}}</button>
    </view>
  </view>
</view>
