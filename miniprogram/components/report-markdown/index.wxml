<view class="md-root">
  <!-- V1.5 吸顶目录（2026-09-12）：长报告一键跳转，降低滑动疲劳；章节 id 复用现有 id="ch-{{key}}"
       2026-10-18：加**激活态** —— 高亮"当前正在读哪一章"（IntersectionObserver 判定），
       并用 scroll-into-view 把高亮标签自动滚进可视区（章节多时标签会滚出屏幕）。
       外层由 view 改为 scroll-view：原 overflow-x:auto 无法程序化滚动。 -->
  <scroll-view class="toc" wx:if="{{toc.length > 1}}" scroll-x enhanced show-scrollbar="{{false}}"
               scroll-into-view="{{tocInto}}" scroll-with-animation>
    <view class="toc-inner">
      <view class="toc-item {{activeKey === item.key ? 'is-active' : ''}}"
            id="toc-{{item.key}}"
            wx:for="{{toc}}" wx:key="key" data-k="{{item.key}}" catchtap="onTocTap"
            aria-current="{{activeKey === item.key ? 'true' : 'false'}}">{{item.num ? item.num + ' ' : ''}}{{item.title}}</view>
    </view>
  </scroll-view>
  <view class="md-card" wx:for="{{cards}}" wx:key="key" id="ch-{{item.key}}" style="{{item.style}}">
    <view wx:if="{{item.collapsible}}" class="fold-hd" catchtap="toggleChapter" data-k="{{item.key}}">
      <text class="fold-title">{{item.num ? item.num + ' ' : ''}}{{item.title}}{{item.unit ? '（' + item.unit + '）' : ''}}</text>
      <text class="fold-arrow" aria-label="{{item.collapsed ? '展开章节' : '收起章节'}}">{{item.collapsed ? '展开 ▾' : '收起 ▴'}}</text>
    </view>
    <block wx:if="{{!item.collapsed}}">
    <view class="h1n" wx:if="{{!item.collapsible}}">
      <text class="h1n-digit" wx:if="{{item.num}}">{{item.num}}</text><text class="h1n-title">{{item.title}}</text>
      <text class="h1n-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
      <text class="h1n-edit pressable" wx:if="{{item.edit && !readonly}}" catchtap="onChapterEdit" data-mode="{{item.edit}}" aria-label="编辑本章">[编辑]</text>
    </view>
      <!-- 2026-09-18 布局审计：删去冗余 wx:if——wx:for 遍历空数组/undefined 本就不产生任何节点，
           该条件因此恒等价于「数组非空」，却与 wx:for 挤在同一节点。删掉即消除同节点组合，渲染结果不变。 -->
      <view wx:for="{{item.customBlocks}}" wx:for-index="bi" wx:for-item="block" wx:key="bi">
        <view wx:if="{{block.section}}" class="h2">{{block.section}}</view>
        <view wx:if="{{block.t==='panorama'}}" class="pano-wrap">
          <view class="pano-hd"><text class="pano-hd-cell pano-hd-first">{{block.heads[0]}}</text><text class="pano-hd-cell" wx:for="{{block.cats}}" wx:for-item="h" wx:key="index">{{h}}</text></view>
          <view class="pano-row" wx:for="{{block.rows}}" wx:for-item="row" wx:for-index="ri" wx:key="name">
            <text class="pano-cell pano-name {{row.name === '合计' ? 'pano-name-total' : ''}}">{{row.name}}</text>
            <view class="pano-cell pano-status ps-{{c.s}}" wx:for="{{row.cells}}" wx:for-item="c" wx:for-index="ci" wx:key="ci"><text class="pano-val">{{c.v}}</text></view>
          </view>
        </view>
        <!-- 保障期间甘特图（2026-10-13，报告结构 v2.0 ③）：横轴时间、纵轴分人分产品、条长=保障期间。
             数据侧已算好百分比（gantt-builder.js），此处只渲染 —— 渲染层不做任何时间计算，
             避免"同一张保单在页面与 PDF 到期年不同"那类口径分裂（见 report-pdf-notes 的历史教训）。
             ⛔ 不标注空白期/重叠区/断档：缺字段依据（理由见 gantt-builder.js 头注释）。 -->
        <view wx:if="{{block.t==='gantt'}}" class="gt-wrap">
          <!-- 三列栅格：谁/哪个产品 ｜ 时间条 ｜ 到期与保额。
               到期文案独立成列（而非跟在条尾），避免"条到底右端"时文字溢出卡片被裁。 -->
          <view class="gt-axis">
            <!-- 年龄行的基准人：不写清楚"这是谁的 62 岁"，读者会默认当成自己的 -->
            <view class="gt-label"><text class="gt-ref" wx:if="{{block.refAge}}">{{block.refName || '户主'}} 年龄</text></view>
            <view class="gt-track gt-track--axis">
              <!-- 2026-10-18：刻度两行 = 年份 + 户主年龄。几何不变（全家同龄化），只多一行标签 -->
              <view class="gt-tick {{index === 0 ? 'gt-tick--first' : ''}} {{index === block.ticks.length - 1 ? 'gt-tick--last' : ''}}" wx:for="{{block.ticks}}" wx:for-item="tk" wx:key="y" style="left:{{tk.pct}}%">
                <text class="gt-tick-y">{{tk.y}}</text>
                <text class="gt-tick-age" wx:if="{{tk.age}}">{{tk.age}}岁</text>
              </view>
              <!-- "今天"标记（稿子：让客户看到当前处在哪）。越界（保单尚未生效）时 nowPct 为 null，不画 -->
              <text class="gt-now-label" wx:if="{{block.nowPct !== null}}" style="left:{{block.nowPct}}%">今天</text>
            </view>
            <view class="gt-side"></view>
          </view>
          <!-- 2026-10-17：按成员分组 —— 成员名只在组头出现一次（原实现逐行重复，
               把产品名挤到第二行且只能 tiny 字号）。 -->
          <block wx:for="{{block.rows}}" wx:for-item="r" wx:key="rowKey">
            <view class="gt-group" wx:if="{{r.firstOfMember}}"><text class="gt-name">{{r.name}}</text></view>
            <view class="gt-row">
              <view class="gt-label">
                <!-- 一年期标记放在产品行尾（该行本就 ellipsis，窄屏自动省略），
                     不放到右侧到期列 —— 到期列只留"年份/终身"，宽度才压得下来 -->
                <text class="gt-prod">{{r.product}}{{r.cat ? ' · ' + r.cat : ''}}{{r.oneYear ? ' · 1年期' : ''}}{{r.singlePay ? ' · 趸交' : ''}}{{r.riderCount ? ' · 含附加' + r.riderCount + '项' : ''}}</text>
              </view>
              <view class="gt-track">
                <view class="gt-now" wx:if="{{block.nowPct !== null}}" style="left:{{block.nowPct}}%"></view>
                <view class="gt-bar {{r.lifetime ? 'gt-bar--life' : ''}} {{r.oneYear ? 'gt-bar--short' : ''}}" style="left:{{r.startPct}}%;width:{{r.widthPct}}%"></view>
                <!-- 2026-10-18：缴费期满标记（替代原条内斜纹）。按时间轴百分比定位，
                     只在"缴费期满早于保障期满"时出现 —— 两者同时结束时画在条尾是噪音。 -->
                <view class="gt-payend" wx:if="{{r.payEndPct !== null}}" style="left:{{r.payEndPct}}%"></view>
              </view>
              <!-- 右侧压成两行（原来三行在 160rpx 里挤成一团）：
                   行1 = 到期年/终身 + 该成员到期时的年龄；行2 = 保额 -->
              <view class="gt-side">
                <text class="gt-end {{r.lifetime ? 'gt-end--life' : ''}}">{{r.lifetime ? '终身' : r.endY + '年'}}{{r.endAge ? ' · ' + r.endAge + '岁' : ''}}</text>
                <text class="gt-amt" wx:if="{{r.sumAssured}}">{{r.sumAssured}}万</text>
              </view>
            </view>
          </block>
          <view class="gt-note" wx:for="{{block.notes}}" wx:key="*this">· {{item}}</view>
        </view>
        <view wx:if="{{block.t==='timeline'}}" class="tl-wrap">
          <!-- 2026-09-09：红/绿点原无说明，用户无法区分「保障期满」与「交费期满」 -->
          <view class="tl-legend">
            <text class="tl-legend-dot tl-green"></text><text class="tl-legend-txt">交费期满</text>
            <text class="tl-legend-dot tl-red"></text><text class="tl-legend-txt">保障期满</text>
          </view>
          <!-- 年份为第一层节点；年份下多产品归类；单产品同年多节点 note 以/分隔 -->
          <view class="tl-item" wx:for="{{block.items}}" wx:for-item="e" wx:key="y">
            <view class="tl-dot {{e.type === 'expiry' ? 'tl-red' : 'tl-green'}}"></view>
            <view class="tl-content">
              <text class="tl-year">{{e.date || (e.y + '年')}}</text>
              <view class="tl-prod" wx:for="{{e.policies}}" wx:for-item="p" wx:key="name">
                <text class="tl-label">{{p.name}}</text>
                <text class="tl-note">{{p.note}}</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{block.t==='calendar'}}" class="cal-grid">
          <view class="cal-cell {{item.h === 2 ? 'cal-peak' : ''}}" wx:for="{{block.items}}" wx:key="m">
            <text class="cal-m">{{item.m}}月</text>
            <text class="cal-v {{item.h ? '' : 'cal-none'}}">{{item.v}}</text>
          </view>
        </view>
        <!-- 家庭结构：成员卡片平铺流动布局（去代际分层） -->
        <!-- 年度保费柱（2026-10-18）：缴费与现金流的"跨年"维度 —— 哪几年压力大、哪一年掉一档。
             不画折线（每年一个柱、柱数不超过 40 年）：柱高即金额，掉档处用一枚小三角 + 竖线标出。
             精确金额不标在柱上（会挤），由章节文字给"X 年起降至 Y 万"。 -->
        <view wx:if="{{block.t==='premium_trend' && block.years.length}}" class="pt-wrap">
          <view class="pt-head">
            <text class="pt-title">长期险年缴保费</text>
            <text class="pt-scope">一年期按年续保、趸交不计入</text>
          </view>
          <scroll-view class="pt-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="pt-bars">
              <view class="pt-col {{item.isNow ? 'is-now' : ''}}" wx:for="{{block.years}}" wx:key="y">
                <view class="pt-bar-wrap">
                  <!-- 掉档标记：该年保费比上一年低 → 柱顶一枚小三角，含义由下方图注给 -->
                  <text class="pt-drop" wx:if="{{item.isDrop}}">▾</text>
                  <view class="pt-bar" style="height:{{item.pct}}%"></view>
                </view>
                <text class="pt-year" wx:if="{{item.showLabel}}">{{item.y}}</text>
              </view>
            </view>
          </scroll-view>
          <view class="pt-legend">
            <text class="pt-lg-item"><text class="pt-lg-dot pt-lg-dot--now"></text>当前</text>
            <text class="pt-lg-item">▾ 缴费期满、保费降一档</text>
          </view>
        </view>

        <view wx:if="{{block.t==='family_tree'}}" class="ft-wrap">
          <view class="ft-nodes">
            <view class="ft-node {{node.role}} {{readonly ? '' : 'pressable'}}" wx:for="{{block.nodes}}" wx:for-item="node" wx:key="key" data-mode="member" data-mid="{{node.member_id}}" catchtap="onChapterEdit" aria-label="编辑成员">
              <view class="ft-info">
                <text class="ft-name">{{node.name}}</text>
                <text class="ft-role">{{node.display}}</text>
                <!-- 2026-10-18 第二步 IA：原页面「按成员整理」的规模并到这里（同一件事的不同侧面） -->
                <text class="ft-scale" wx:if="{{node.scaleText}}">{{node.scaleText}}</text>
              </view>
            </view>
          </view>
        </view>
        <!-- 家庭财务：独立 block 卡（R2 从 family_tree 拆分） -->
        <view wx:if="{{block.t==='finance'}}" class="fin-wrap">
          <view class="fin-grid">
            <!-- 2026-09-18 报告页审计：income 为 null = 家庭/成员收入均未填写（chapter-builder 传 null），
                 不再渲染成"0万"（与⑦缴费月历章"家庭年收入未填写"口径对齐）。debt 不这样处理——"0万"准确 -->
            <view class="num-cell"><text class="num-lbl">年收入</text><text class="num-val">{{block.income ? block.income + '万' : '未填写'}}</text></view>
            <view class="num-cell"><text class="num-lbl">总负债</text><text class="num-val">{{block.debt}}万</text></view>
          </view>
        </view>
        <!-- 特别提醒：置信度告警（免责声明已移至页面底部 .report-disclaimer） -->
        <view wx:if="{{block.t==='risk_alerts'}}" class="risk-wrap">
          <view class="risk-alerts" wx:if="{{block.items.length}}">
            <view class="risk-title">置信度告警</view>
            <view class="risk-item" wx:for="{{block.items}}" wx:for-item="a" wx:key="name">
              <text class="risk-name">· {{a.name}}：</text>
              <text class="risk-issue">{{a.issue}}</text>
              <view wx:if="{{a.policy_id && !readonly}}" class="risk-check pressable" data-pid="{{a.policy_id}}" data-field="{{a.field || ''}}" catchtap="onRiskCheck" aria-label="核对保单信息">核对</view>
            </view>
          </view>
        </view>
        <!-- 附录保单卡片（按成员分组，点击弹明细） -->
        <!-- 异常与待核验 A1–A6（2026-10-21）：编号固定，AI 导读与面谈按编号引用。
             每行一条事实（成员 · 保单 · 具体到什么状态/哪天到期），点「查看」直达保单明细。 -->
        <view wx:if="{{block.t==='anomaly_list'}}" class="an-wrap">
          <view class="an-group" wx:for="{{block.items}}" wx:key="code" wx:for-item="g">
            <view class="an-head">
              <text class="an-code">{{g.code}}</text>
              <text class="an-title">{{g.title}}</text>
              <text class="an-count">{{g.count}} 项</text>
            </view>
            <view class="an-item" wx:for="{{g.items}}" wx:key="policyId" wx:for-item="it">
              <view class="an-line">
                <text class="an-who">{{it.member}}</text>
                <text class="an-prod">{{it.product}}</text>
                <text class="an-act pressable" wx:if="{{it.policyId && !readonly}}" data-id="{{it.policyId}}" catchtap="onPolicyTap">查看</text>
              </view>
              <text class="an-detail">{{it.detail}}</text>
            </view>
          </view>
        </view>

        <!-- 待完善清单（2026-10-18 第二步 IA）：原页面级「待完善」，按保单聚合后进正文最后一章。
             每张保单一行 +「去补」直达该保单的编辑 Sheet（复用 policytap 事件，不新增链路）。 -->
        <view wx:if="{{block.t==='pending_list'}}" class="pd-wrap">
          <view class="pd-item" wx:for="{{block.items}}" wx:key="policyId">
            <view class="pd-head">
              <text class="pd-name">{{item.productName || '未命名保单'}}</text>
              <text class="pd-act pressable" wx:if="{{item.policyId && !readonly}}" data-id="{{item.policyId}}" catchtap="onPolicyTap" aria-label="补充该保单信息">去补</text>
            </view>
            <text class="pd-detail" wx:for="{{item.details}}" wx:for-item="d" wx:key="*this">{{d}}</text>
          </view>
        </view>

        <!-- 概览块（2026-10-18 IA 重构）：原页面级「整理汇总卡 + 保障覆盖与风险卡」合并为正文第 1 章。
             合并的意义：同一批信息不再出现两套排版、缺口不再在 3 处重复、目录能索引到它。
             数据全部由 chapter-builder 备好（本组件不做计算）。 -->
        <view wx:if="{{block.t==='overview'}}" class="ov-wrap">
          <view class="ov-meta">{{block.policyCount}} 张保单 · {{block.memberCount}} 位成员 · 年保费 {{block.premiumText}}</view>
          <view class="ov-pair">
            <view class="ov-pair-item">
              <view class="ov-pair-val">{{block.payoutText}}</view>
              <view class="ov-pair-lbl">给付型 · 寿险 / 重疾</view>
            </view>
            <view class="ov-pair-item">
              <view class="ov-pair-val">{{block.quotaText}}</view>
              <view class="ov-pair-lbl">报销额度 · 医疗 / 意外</view>
            </view>
          </view>
          <!-- 2026-10-18 修（真机）：原每个 chip 都写"已覆盖"，5 个险种就重复 5 次；
               "已覆盖"是这一组的标题，chips 只放险种名。 -->
          <view class="ov-cat-row" wx:if="{{block.categories.length}}">
            <text class="ov-cat-label">已覆盖险种</text>
            <text class="ov-chip" wx:for="{{block.categories}}" wx:key="*this">{{item}}</text>
          </view>
          <view class="ov-note" wx:if="{{block.savingsText}}">储蓄型（年金 / 增额寿 / 终身寿）合计 {{block.savingsText}}，与上述分列</view>
          <view class="ov-note" wx:if="{{block.unknownText}}">{{block.unknownText}} 的保单未标注险种，未计入上述分类</view>
          <view class="ov-note" wx:if="{{block.inactiveNote}}">{{block.inactiveNote}}</view>

          <view class="ov-check" wx:if="{{block.alerts.length}}">
            <view class="ov-check-lead">{{block.summaryLead}}</view>
            <view class="ov-alert {{item.ok ? 'is-ok' : (item.blocked ? 'is-unknown' : 'is-warn')}}" wx:for="{{block.alerts}}" wx:key="name">
              <text class="ov-dot"></text>
              <text class="ov-alert-text">{{item.name}} {{item.display}}</text>
            </view>
            <!-- 2026-10-21：行动建议已移出规则层（现阶段不做诊断）。覆盖检查只到"谁缺什么"为止。 -->
          </view>

          <view class="ov-risks" wx:if="{{block.risks.length}}">
            <view class="ov-risk ov-risk--{{item.level}}" wx:for="{{block.risks}}" wx:key="key">
              <view class="ov-risk-head">
                <text class="ov-risk-level">{{item.levelLabel}}</text>
                <text class="ov-risk-title">{{item.title}}</text>
              </view>
              <text class="ov-risk-detail">{{item.detail}}</text>
              <!-- 依据直接展开（组件内无交互态）：红/黄必须可追溯，达标项不铺开以免噪音 -->
              <text class="ov-risk-basis" wx:if="{{item.basis && item.level !== 'ok'}}">依据：{{item.basis}}</text>
            </view>
            <view class="ov-note" wx:if="{{block.risksMore}}">另有 {{block.risksMore}} 项未展开，共 {{block.risksTotal}} 项</view>
          </view>
        </view>

        <view wx:if="{{block.t==='policy_cards'}}" class="pc-wrap">
          <!-- 二级分组：被保人 → 保险公司 → 保单卡片 -->
          <view class="pc-group" wx:for="{{block.groups}}" wx:for-item="g" wx:key="name">
            <view class="pc-group-name">{{g.name}}</view>
            <view class="pc-subgroup" wx:for="{{g.subgroups}}" wx:for-item="sg" wx:key="name">
              <view class="pc-subgroup-name">{{sg.name}}</view>
              <!-- 2026-10-21：附加险缩进挂在主险下（项目按产品入库 → 两者本是独立文档，
                   报告侧用同保单号推断关系；主险行尾标"含附加 N 项"）。 -->
              <view class="pc-card {{p.status && p.status !== 'active' ? 'pc-card--inactive ' : ''}}{{p.isRider ? 'pc-card--rider ' : ''}}{{readonly ? '' : 'pressable'}}" wx:for="{{sg.policies}}" wx:for-item="p" wx:key="policy_id" data-id="{{p.policy_id}}" catchtap="onPolicyTap" aria-label="{{readonly ? '' : '查看' + p.product_name + '保单明细'}}">
                <view class="pc-card-top">
                  <view class="pc-name-wrap">
                    <text class="pc-name"><text wx:if="{{p.isRider}}" class="pc-rider-mark">└ 附加</text>{{p.product_name}}<text wx:if="{{p.category}}" class="pc-cat">（{{p.category}}）</text></text>
                    <text class="pc-rider-count" wx:if="{{!p.isRider && p.rider_count}}">含附加 {{p.rider_count}} 项</text>
                  </view>
                    <text class="pc-status pc-status--{{p.status}} {{readonly ? '' : 'pressable'}}" data-id="{{p.policy_id}}" catchtap="onStatusTap" aria-label="{{readonly ? '' : '快速更改' + p.product_name + '状态'}}">{{p.status_label}}</text>

                </view>
                <!-- 三行简写：产品 / 保障信息 / 缴费信息，纯数据无字段名；缺失项在数据侧以「未知」占位 -->
                <view class="pc-meta-row">{{p.meta1}}</view>
                <view class="pc-meta-row">{{p.meta2}}</view>
                <!-- 2026-09-18 报告页审计：保单号/投保人/受益人（数据侧只拼有值项；全缺为空串故整行不渲染） -->
                <view class="pc-meta-row" wx:if="{{p.meta3}}">{{p.meta3}}</view>
                <!-- 当前年份现金价值（储蓄型保单；代理人/客户均展示） -->
                <view class="pc-meta-row" wx:if="{{p.cash_display}}">{{p.cash_display}}</view>
                <!-- 2026-10-18（v2.0 结论可溯源）：OCR 时 AI 摘录的原文片段。
                     只给 owner（客户版看的是一个"数字从哪抄的"，属内部核对口径）；
                     无出处（老数据/未通过校验）则整行不渲染。 -->
                <view class="pc-meta-row pc-evidence" wx:if="{{p.evidence && !readonly}}">原文：{{p.evidence}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{item.pre}}" class="md-pre"><text>{{item.pre}}</text></view>
      <view wx:if="{{item.note}}" class="md-note"><text>{{item.note}}</text></view>
      <markdown-render wx:if="{{item.content}}" content="{{item.content}}" bind:linkTap="onLinkTap" />
    </block>
  </view>
</view>
