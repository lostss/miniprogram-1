/* UI 审计 #③：--green-report 收敛为全局 --ok（app.wxss） */
/* UI 审计 视觉 S5：局部 --missing-bg/--covered-bg 与全局 --red-dim/--ok-dim 语义重复，收敛为全局 token */
.md-root { padding:var(--sp-5) var(--sp-5) var(--sp-7); word-break:break-word; overflow-wrap:break-word; --missing-bg:var(--red-dim); --covered-bg:var(--ok-dim); }

/* V1.5 吸顶目录（2026-09-12）：滚动时吸附在报告内容顶部；横向可滑动，中低端机同样可用。
   左右负 margin 抵消 .md-root padding，使吸顶条背景横向铺满。 */
/* 2026-09-12：横向可滑但滚动条被下行 :8 隐藏，章节多时唯一线索是右侧被裁一半的 chip
   （有时正好对齐，完全看不出还有内容）。加右侧渐隐遮罩：内容延伸到右缘时自然淡出。 */
/* 2026-10-18：容器改 scroll-view（为了 scroll-into-view 把高亮标签滚进可视区）。
   flex 移到内层 .toc-inner —— scroll-view 自身不宜做 flex 行容器（其滚动内容需要一个子节点）。 */
.toc { position:sticky; top:0; z-index:20; white-space:nowrap; padding:0; margin:calc(-1 * var(--sp-5)) calc(-1 * var(--sp-5)) var(--sp-5); background:var(--bg-root); border-bottom:1rpx solid var(--border); -webkit-mask-image:linear-gradient(to right, #000 calc(100% - 48rpx), transparent); mask-image:linear-gradient(to right, #000 calc(100% - 48rpx), transparent); }
.toc-inner { display:inline-flex; gap:var(--sp-2); padding:var(--sp-3) var(--sp-5); }
.toc::-webkit-scrollbar { display:none; }
.toc-item { flex-shrink:0; font-size:var(--fs-caption); color:var(--text-secondary); background:var(--bg-input); border-radius:var(--r-full); padding:var(--sp-2) var(--sp-4); transition:background 0.2s var(--ease-out), color 0.2s var(--ease-out); }
.toc-item:active { opacity:0.6; }
/* 激活态（2026-10-18）：实底深金 + 白字 —— 与"当前章节"这一强语义匹配；
   刻意不用浅色描边：目录是横向吸顶条，浅色在滚动中看不出来。 */
.toc-item.is-active { background:var(--accent-deep); color:var(--color-on-accent, #FFFFFF); font-weight:var(--fw-semi); }
/* 2026-09-06 宽屏行宽约束：与报告页正文区同宽居中（手机 <768px 不受影响） */
@media (min-width: 768px) {
  .md-root { width: 720px; max-width: calc(100vw - 96px); margin-left: auto; margin-right: auto; box-sizing: border-box; }
}

/* 章节卡：细边框 + 宽松节奏 + 入场动画 */
/* 正文卡片间距：sp-8（卡间 > 卡内 padding，强化分块感；summary-card 与 md-card 相邻处同值） */
.md-card { background:var(--bg-card); border-radius:var(--r-lg); padding:var(--sp-6); margin-bottom:var(--sp-8); border:1rpx solid var(--border); animation:cardReveal var(--dur-glacial) var(--ease-out-expo) both; }

/* 标题：衬线体章节号 + 暖金分割线 */
/* UI 打磨：章节号 44→32rpx + accent→accent-deep 降权降饱和，章节标题为视觉第一 */
.h1n { display:flex; align-items:baseline; gap:var(--sp-4); margin:0 0 var(--sp-6); padding-bottom:var(--sp-5); border-bottom:1rpx solid var(--border-accent); }
.h1n-digit { font-size:var(--fs-lg); font-weight:var(--fw-bold); color:var(--accent-deep); line-height:var(--lh-none); font-family:var(--font-serif); font-variant-numeric:tabular-nums; }
.h1n-title { font-size:var(--fs-xl); font-weight:var(--fw-bold); color:var(--text-primary); flex:1; font-family:var(--font-serif); letter-spacing:var(--ls-wide); }
/* UI 审计 V-S1：--fw-regular 未定义（app.wxss 仅 normal/medium/semi/bold），改 --fw-normal */
.h1n-unit { font-size:var(--fs-caption); color:var(--text-secondary); flex-shrink:0; margin-right:var(--sp-2); font-weight:var(--fw-normal); }
/* 编辑入口：视觉保持小 pill（88rpx 大底色有"补丁感"，已回退），触控热区由伪元素透明外扩至 ≥88rpx */
.h1n-edit { position:relative; display:inline-flex; align-items:center; font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); border-radius:var(--r-full); padding:var(--sp-2) var(--sp-4); flex-shrink:0; line-height:var(--lh-none); }
.h1n-edit::after { content:''; position:absolute; left:-24rpx; right:-24rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.h1n-edit:active { opacity:0.6 }

.h2 { font-size:var(--fs-body); font-weight:var(--fw-bold); color:var(--text-primary); margin:var(--sp-5) 0 var(--sp-3); padding-left:var(--sp-4); border-left:4rpx solid var(--accent-muted); }

.cal-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--sp-3); margin:var(--sp-4) 0; }
.cal-cell { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:var(--sp-4) var(--sp-2); min-height:96rpx; background:var(--bg-input); border-radius:var(--r-md); box-sizing:border-box; }
.cal-m { font-size:var(--fs-tiny); color:var(--text-secondary); margin-bottom:var(--sp-2); font-family:var(--font-serif); letter-spacing:var(--ls-wide); }
.cal-v { font-size:var(--fs-caption); font-weight:var(--fw-bold); color:var(--text-primary); font-variant-numeric:tabular-nums; }
.cal-none { color:var(--text-disabled); font-weight:var(--fw-normal); }

/* 保障关键时点 时间轴
   UI 打磨（对齐审计修复）：dot 绝对定位相对 item，left 减去 wrap padding（sp-7）使 dot 中心
   精确落在 wrap 坐标 --tl-axis 处；轴线 top/bottom 按 dot 几何推导（首末 dot 中心），消除裸轴与魔法数对。
   几何：item 左缘 = wrap padding-left(sp-7=40rpx)；dot 中心(相对 wrap) = 40 + left + 半宽。
   要中心=13rpx → left = 13 - 40 = calc(var(--tl-axis) - var(--sp-7)) = -27rpx。 */
.tl-wrap {
  --tl-axis: 13rpx;                 /* 轴线 left（相对 wrap） */
  --tl-dot-size: var(--sp-4);       /* dot 直径 16rpx（含 2rpx 边框，border-box；UI 打磨 24→16 克制化） */
  --tl-dot-mt: 10rpx;               /* dot 垂直偏移（对齐 tl-year 首行文字基线：(36-16)/2=10rpx） */
  position:relative; padding-left:var(--sp-7); margin:var(--sp-4) 0;
}
/* 轴线：left=--tl-axis，translateX(-1rpx) 使 2rpx 宽轴线中心=--tl-axis；top/bottom=首末 dot 中心 */
.tl-wrap::before {
  content:''; position:absolute; left:var(--tl-axis); width:2rpx; transform:translateX(-1rpx);
  top:calc(var(--sp-3) + var(--tl-dot-mt) + var(--tl-dot-size) / 2);
  bottom:calc(var(--sp-3) + var(--tl-dot-mt) + var(--tl-dot-size) / 2);
  background:var(--border-accent);
}
.tl-item { display:flex; align-items:flex-start; gap:var(--sp-5); padding:var(--sp-3) 0; position:relative; }
/* dot 中心精确对齐轴心：left 相对 item 减 wrap padding，translateX(-50%) 居中 */
.tl-dot {
  width:var(--tl-dot-size); height:var(--tl-dot-size); border-radius:50%; flex-shrink:0;
  position:absolute; left:calc(var(--tl-axis) - var(--sp-7)); transform:translateX(-50%);
  margin-top:var(--tl-dot-mt); z-index:1; border:2rpx solid var(--bg-card); background:var(--accent-muted);
}
.tl-red { background:var(--red); }
.tl-green { background:var(--ok); }
.tl-yellow { background:var(--amber); }
.tl-content { flex:1; min-width:0; display:flex; flex-direction:column; gap:var(--sp-1); }
/* 年份组内产品行：名称 + 节点（/分隔）同行基线对齐，多产品纵向堆叠 */
.tl-prod { display:flex; align-items:baseline; flex-wrap:wrap; gap:0 var(--sp-2); }
.tl-prod + .tl-prod { margin-top:var(--sp-1); }
.tl-year { font-size:var(--fs-caption); font-weight:var(--fw-bold); color:var(--accent-deep); font-family:var(--font-serif); font-variant-numeric:tabular-nums; }
.tl-label { font-size:var(--fs-caption); color:var(--text-primary); line-height:var(--lh-body); }
/* soon 高亮：从 dot 中心左侧（覆盖整圆）延伸，item 自身不移位 → dot 恒居轴线 */
.tl-soon { position:relative; padding:var(--sp-3) var(--sp-4); }
.tl-soon::before {
  content:''; position:absolute; top:0; bottom:0; z-index:0;
  left:calc(-1 * var(--sp-7) + var(--tl-axis) - var(--tl-dot-size) / 2);
  right:0; background:linear-gradient(90deg, var(--red-dim), transparent); border-radius:var(--r-sm);
}
.tl-soon .tl-year { color:var(--red); }

/* 时间线图例（2026-09-09）：说明红/绿点含义，避免"红绿无语义" */
.tl-legend { display:flex; align-items:center; margin-bottom:var(--sp-3); }
.tl-legend-dot { width:12rpx; height:12rpx; border-radius:50%; flex-shrink:0; margin-right:var(--sp-2); }
.tl-legend-dot.tl-green { background:var(--ok); }
.tl-legend-dot.tl-red { background:var(--red); }
.tl-legend-txt { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.tl-legend-txt + .tl-legend-dot { margin-left:var(--sp-5); }

/* ===== 保障期间甘特图（2026-10-13，报告结构 v2.0 ③）=====
   三列栅格：label（谁/哪个产品）｜ track（时间条，百分比定位）｜ side（到期与保额）。
   百分比全部来自 gantt-builder，渲染层不做时间计算（防"页面与 PDF 到期年不同"的口径分裂）。
   到期文案独立成列而非跟在条尾：条到 100% 时文字会溢出卡片被裁。 */
.gt-wrap { margin:var(--sp-4) 0; }
.gt-axis, .gt-row { display:flex; align-items:center; gap:var(--sp-3); }
.gt-row { padding:var(--sp-1) 0; }
/* 列宽收紧（2026-10-13 调优）：原 label/side 各 190rpx，两台加起来 380rpx，
   窄屏（375pt ≈ 750rpx）里留给时间条的只剩 ~330rpx → 条短、刻度挤。
   现各 160rpx；代价是左侧产品名更早省略号 —— 该行本就 ellipsis，属可接受的降级。
   右侧"到期"列只显示"年份/终身"（一年期标记移到左侧产品行尾），故 160rpx 足够。 */
/* 2026-10-17：成员组头（成员名只出现一次）。上间距比行距大，形成"分组"的视觉断点；
   首个组头不加上间距，避免甘特图顶部多出一块空白。 */
.gt-group { margin-top:var(--sp-3); padding-bottom:2rpx; }
.gt-group:first-child { margin-top:0; }
.gt-label { flex:0 0 160rpx; min-width:0; display:flex; flex-direction:column; gap:2rpx; }
.gt-name { font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--text-primary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.gt-prod { font-size:var(--fs-tiny); color:var(--text-tertiary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.gt-track { position:relative; flex:1; min-width:0; height:36rpx; }
/* 2026-10-18：轴高 28 → 44rpx —— 刻度改成两行（年份 + 户主年龄） */
.gt-track--axis { height:44rpx; border-bottom:1rpx solid var(--border); }
/* 刻度：中间刻度以自身中心对齐位置；首尾刻度贴边（transform 翻转），避免被卡片裁掉 */
.gt-tick { position:absolute; bottom:2rpx; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:1rpx; color:var(--text-tertiary); white-space:nowrap; font-variant-numeric:tabular-nums; }
.gt-tick--first { transform:none; align-items:flex-start; }
.gt-tick--last { transform:translateX(-100%); align-items:flex-end; }
.gt-tick-y { font-size:var(--fs-tiny); }
/* 年龄行更弱一档：它是"帮助理解"的第二语义，不该和年份抢注意力 */
.gt-tick-age { font-size:var(--fs-tiny); color:var(--text-tertiary); opacity:0.75; }
/* 轴左侧的基准人标注（"李阳勇 年龄"）：不标的话读者会把"62岁"当成自己的 */
.gt-ref { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.gt-bar { position:absolute; top:8rpx; height:20rpx; min-width:6rpx; border-radius:999rpx; background:var(--accent-deep); }
/* 缴费期满竖线（2026-10-18 替代条内斜纹）：20rpx 条高下斜纹在真机不可读；
   一根 2rpx 竖线 + 图例说明"其后只保留保障"，信息不减、噪声近零。
   用白色半透明压深金色条，两种条色（金 / 琥珀）上都可见。 */
.gt-payend { position:absolute; top:6rpx; height:24rpx; width:2rpx; background:rgba(255,255,255,0.9); }
/* "今天"竖线：每行一条（虚线感，弱于时间条本身）；轴上一枚"今天"标签 */
.gt-now { position:absolute; top:0; bottom:0; width:0; border-left:1rpx dashed var(--text-tertiary); opacity:0.55; }
.gt-now-label { position:absolute; bottom:0; transform:translateX(-50%); font-size:var(--fs-tiny); color:var(--text-tertiary); white-space:nowrap; }
.gt-age { font-size:var(--fs-tiny); color:var(--text-tertiary); }
/* 终身：右端渐隐示意"无固定到期日"（不做 2130 年那种假终点） */
.gt-bar--life { background:linear-gradient(90deg, var(--accent-deep) 0%, var(--accent-deep) 55%, var(--border-accent) 100%); }
/* 一年期短险：琥珀色（每年需续保，与长期险区分；沿用项目"琥珀 = 需留意"的语义） */
.gt-bar--short { background:var(--amber-deep); }
/* 失效 / 退保 / 理赔终止（2026-10-21）：灰条 + 虚线描边 —— 形状仍是"曾经保障到哪一年"，
   但一眼能看出它已经不作数（不计入汇总与缺口）。 */
.gt-bar--inactive { background:var(--border); border:1rpx dashed var(--text-tertiary); }
.gt-bar--inactive::after { content:''; }
.gt-side { flex:0 0 160rpx; display:flex; flex-direction:column; align-items:flex-end; gap:2rpx; }
.gt-end { font-size:var(--fs-tiny); color:var(--text-secondary); font-variant-numeric:tabular-nums; }
.gt-end--life { color:var(--accent-deep); }
.gt-amt { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.gt-note { margin-top:var(--sp-3); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-body); }

/* 保障全景矩阵（浅金表头 + 覆盖浅绿/缺失浅红） */
/* UI 打磨：金色语义分流——数据表头/峰值不再用品牌实底 accent，改浅金底 accent-dim + 深金字 */
/* UI 审计 V-S6：overflow:hidden 裁剪窄屏/多成员溢出内容，改 overflow-x:auto */
.pano-wrap { margin:var(--sp-4) 0; border-radius:var(--r-md); overflow-x:auto; border:1rpx solid var(--border); }
.pano-hd { display:flex; background:var(--accent-dim); }
/* 2026-09-12 修复：数值列原为纯 flex:1（basis 0、无 min-width）→ 只会被压扁，永远撑不开
   容器，.pano-wrap 的 overflow-x:auto 形同虚设（注释里的"改 overflow-x:auto"没落地）。
   加 min-width:132rpx：空间充足时仍按 flex-grow 等分（3 险种不横滑），列多时撑开容器触发横滑。
   ⚠️ 表头与数据行必须同宽，.pano-hd-cell 与 .pano-cell 需同步改。 */
.pano-hd-cell { flex:1; min-width:148rpx; padding:var(--sp-4) var(--sp-2); font-size:var(--fs-caption); color:var(--accent-deep); font-weight:var(--fw-semi); text-align:center; letter-spacing:var(--ls-wide); }
/* 2026-10-17：成员列（首列）left 冻结。7 列（5 险种 + 年金 + 年保费）在 375pt 屏必然横滑，
   而横滑后成员名滚出视野 → 剩下几个数字不知道是谁的（真机截图里就是这个观感）。
   sticky 在 overflow-x 容器内可用；不支持时退化为普通单元格，无副作用。
   首列必须有不透明底色，否则滚动时数字会从底下透出来（偶数行另有底色，单独覆盖）。 */
/* 2026-10-18 修（真机）：首列 84rpx（42px）装不下 3 个汉字 —— sticky 生效后姓名被裁成单字
   （"李阳勇"只显示"勇"）。加宽到 128rpx，并允许换行兜底（4 字名如"欧阳娜娜"也不会截断）。 */
.pano-hd-first { flex:0 0 128rpx; position:sticky; left:0; z-index:2; background:var(--accent-dim); }
.pano-row { display:flex; }
.pano-row:nth-child(even) { background:var(--bg-input); }
.pano-cell { flex:1; min-width:148rpx; padding:var(--sp-3) var(--sp-2); font-size:var(--fs-caption); text-align:center; display:flex; align-items:center; justify-content:center; }
.pano-name { flex:0 0 128rpx; font-weight:var(--fw-semi); color:var(--text-primary); position:sticky; left:0; z-index:2; background:var(--bg-card); line-height:var(--lh-tight); padding-right:var(--sp-1); }
.pano-row:nth-child(even) .pano-name { background:var(--bg-input); }
.pano-name-total { color:var(--accent-deep); }
.pano-status { min-height:56rpx; border-radius:var(--r-sm); margin:var(--sp-1); font-weight:var(--fw-semi); }
.pano-val { font-size:var(--fs-caption); line-height:var(--lh-tight); font-variant-numeric:tabular-nums; }
.ps-ok { background:var(--covered-bg); } .ps-ok .pano-val { color:var(--ok-deep); }
.ps-partial { background:var(--amber-dim); } .ps-partial .pano-val { color:var(--amber-deep); }
/* 2026-09-09：缺失态整格红底在汇总表里面积过大（医疗险整列全红）→ 视觉噪音盖过真缺口；
   改为中性底 + 红字，告警语义由文字承载，红色留给「保障缺口」章的金额 */
.ps-missing { background:var(--bg-input); } .ps-missing .pano-val { color:var(--red-deep); }
.ps-hold { background:var(--accent-dim); } .ps-hold .pano-val { color:var(--accent-deep); }
.ps-blocked { background:var(--accent-dim); } .ps-blocked .pano-val { color:var(--text-secondary); }
.ps-na { background:var(--bg-input); } .ps-na .pano-val { color:var(--text-disabled); }
.ps-total { background:var(--accent-dim); } .ps-total .pano-val { color:var(--accent-deep); font-weight:var(--fw-bold); }
.ps-grand { background:var(--accent-dim); } .ps-grand .pano-val { color:var(--accent-deep); font-weight:var(--fw-bold); }

/* 缴费月历峰值高亮（浅金底 + 深金字，与表头语义分流） */
.cal-peak { background:var(--accent-dim); }
.cal-peak .cal-m { color:var(--accent-deep); }
.cal-peak .cal-v { color:var(--accent-deep); }

/* 时间轴增强：日期/保费/节点备注 */
.tl-note { font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-body); }
.tl-note-expiry { color:var(--red); }

/* 家庭结构：层级列表（父母一层/子女一层）+ 财务 */
.ft-wrap { margin:var(--sp-4) 0; padding:0 var(--sp-1); }
.ft-nodes { display:flex; flex-wrap:wrap; gap:var(--sp-3); width:100%; box-sizing:border-box; }
/* 家庭结构：方形圆角卡片，自适应内容宽度，平铺流动排列 */
.ft-node { display:flex; align-items:center; justify-content:center; padding:var(--sp-4) var(--sp-6); background:var(--bg-input); border-radius:var(--r-lg); }
.ft-node:active { opacity:0.6 }
.ft-info { display:flex; flex-direction:column; align-items:center; gap:0; min-width:0; }
.ft-name { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); }
.ft-role { font-size:var(--fs-tiny); color:var(--text-tertiary); margin-top:2rpx; }
/* 家庭财务：block 容器无卡样式（章卡 md-card 即卡） */
.fin-wrap { margin:var(--sp-4) 0 0; }
.fin-grid { display:flex; gap:var(--sp-3); }
/* 数字块（组件隔离：app.wxss 全局类不作用于组件，需组件内自持；与 app.wxss .num-cell 同源，改一处须同步另一处） */
.num-cell { flex:1; min-width:0; display:flex; flex-wrap:wrap; align-items:baseline; justify-content:center; gap:var(--sp-1); background:var(--bg-root); border-radius:var(--r-lg); padding:var(--sp-4) var(--sp-3); }
.num-val { font-size:var(--fs-2xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); line-height:var(--lh-none); font-variant-numeric:tabular-nums; }
.num-unit { font-size:var(--fs-tiny); color:var(--text-secondary); }
.num-lbl { width:100%; text-align:center; font-size:var(--fs-tiny); color:var(--text-tertiary); margin-top:var(--sp-2); letter-spacing:var(--ls-wide); }

/* 特别提醒：置信度告警 */
.risk-wrap { margin:var(--sp-4) 0; }
.risk-alerts { display:flex; flex-direction:column; gap:var(--sp-3); }
.risk-title { font-size:var(--fs-caption); font-weight:var(--fw-bold); color:var(--red-deep); margin-bottom:var(--sp-2); }
.risk-item { font-size:var(--fs-base); color:var(--text-primary); line-height:var(--lh-body); background:var(--missing-bg); border-radius:var(--r-sm); padding:var(--sp-3) var(--sp-4); }
.risk-name { color:var(--text-primary); font-weight:var(--fw-medium); }
.risk-issue { color:var(--red-deep); }
/* UI 打磨：核对入口统一 pill（与章节卡 [编辑] 同构），行内右对齐；热区同 h1n-edit 伪元素外扩 */
.risk-check { position:relative; display:inline-flex; align-items:center; font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); border-radius:var(--r-full); padding:var(--sp-1) var(--sp-4); margin-left:var(--sp-3); line-height:var(--lh-body); }
.risk-check::after { content:''; position:absolute; left:-24rpx; right:-24rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.risk-check:active { opacity:0.6 }

/* 附录保单卡片（二级分组：被保人 → 保司） */
.pc-wrap { margin:var(--sp-4) 0; }
.pc-group { margin-bottom:var(--sp-6); }
.pc-group-name { font-size:var(--fs-caption); font-weight:var(--fw-bold); color:var(--accent-deep); font-family:var(--font-serif); margin-bottom:var(--sp-3); padding-left:var(--sp-3); border-left:4rpx solid var(--accent); }
/* 保司子组：小标题降一级（正文字色 + 细左边线），与被保人组名拉开层级 */
.pc-subgroup { margin-bottom:var(--sp-4); }
.pc-subgroup-name { font-size:var(--fs-tiny); font-weight:var(--fw-semi); color:var(--text-secondary); letter-spacing:var(--ls-wide); margin-bottom:var(--sp-2); padding-left:var(--sp-3); border-left:2rpx solid var(--border-accent); }
.pc-card { background:var(--bg-input); border:1rpx solid var(--border); border-radius:var(--r-md); padding:var(--sp-5); margin-bottom:var(--sp-3); }
.pc-card:active { opacity:0.6 }
.pc-card-top { display:flex; align-items:center; justify-content:space-between; gap:var(--sp-3); }
.pc-name-wrap { display:flex; align-items:center; gap:var(--sp-2); flex:1; min-width:0; }
/* 2026-10-21：附加险缩进挂主险下。用左缩进 + 左侧细线表示从属关系（不是另一份独立合同）；
   主险行尾标"含附加 N 项"，让"份数按主险计"在视觉上说得通。 */
.pc-card--rider { margin-left:var(--sp-6); border-left:3rpx solid var(--border-accent); border-radius:0 var(--r-md) var(--r-md) 0; }
.pc-rider-mark { font-size:var(--fs-tiny); color:var(--text-tertiary); margin-right:var(--sp-2); }
.pc-rider-count { flex-shrink:0; font-size:var(--fs-tiny); color:var(--text-tertiary); }

.pc-name { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); min-width:0; }
.pc-cat { font-size:var(--fs-tiny); color:var(--text-secondary); font-weight:var(--fw-normal); }
.pc-top-right { display:flex; align-items:center; gap:var(--sp-2); flex-shrink:0; }
.pc-status { font-size:var(--fs-tiny); padding:var(--sp-1) var(--sp-3); border-radius:var(--r-full); white-space:nowrap; flex-shrink:0; }
.pc-status.pressable:active { opacity:0.6; }
.pc-status--active { color:var(--ok-deep); background:var(--ok-dim); }
.pc-status--lapsed { color:var(--amber-deep); background:var(--amber-dim); }
.pc-status--surrendered { color:var(--text-secondary); background:var(--bg-input); }
.pc-status--claim_terminated { color:var(--accent-deep); background:var(--accent-dim); }
.pc-status--expired { color:var(--red); background:var(--red-dim); }
.pc-status--cancelled { color:var(--text-secondary); background:var(--bg-input); }
.pc-status--suspicious { color:var(--amber-deep); background:var(--amber-dim); }
.pc-card--inactive { opacity:0.72; }

/* 三行简写：横排数据行，无字段名（单位自带语义），分隔线区分产品行 */
/* ========== 年度保费柱（2026-10-18）==========
   横滑（最多 40 年，一屏放不下）；柱宽固定 36rpx，间距由 gap 控制 —— 用 flex:1 会随年数变化，
   40 年时柱细如发丝、3 年时柱胖成块，两种都读不出"形状"。 */
.pt-wrap { margin:var(--sp-3) 0 var(--sp-5); }
.pt-head { display:flex; align-items:baseline; justify-content:space-between; gap:var(--sp-3); }
.pt-title { font-size:var(--fs-caption); color:var(--text-primary); font-weight:var(--fw-semi); }
.pt-scope { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.pt-scroll { width:100%; margin-top:var(--sp-3); }
.pt-bars { display:inline-flex; align-items:flex-end; gap:var(--sp-1); padding-bottom:2rpx; }
.pt-col { display:flex; flex-direction:column; align-items:center; width:36rpx; flex-shrink:0; }
/* 柱区固定高度：柱高用百分比（相对本区），空年（0 万）自然是一条贴底线 */
.pt-bar-wrap { position:relative; width:100%; height:160rpx; display:flex; align-items:flex-end; justify-content:center; }
.pt-bar { width:100%; min-height:2rpx; border-radius:3rpx 3rpx 0 0; background:var(--accent-dim); }
/* 当前年：实色强调（读者第一眼要找到"我现在在哪一档"） */
.pt-col.is-now .pt-bar { background:var(--accent-deep); }
.pt-drop { position:absolute; top:-6rpx; left:50%; transform:translateX(-50%); font-size:var(--fs-tiny); color:var(--accent-deep); line-height:1; }
/* 年份标签：每 5 年才显示（40 列全标会糊成一团），当前年强制显示 */
.pt-year { margin-top:var(--sp-1); font-size:20rpx; color:var(--text-tertiary); font-variant-numeric:tabular-nums; transform:scale(0.9); }
.pt-col.is-now .pt-year { color:var(--accent-deep); }
.pt-legend { display:flex; align-items:center; gap:var(--sp-5); margin-top:var(--sp-3); font-size:var(--fs-tiny); color:var(--text-tertiary); }
.pt-lg-item { display:inline-flex; align-items:center; gap:var(--sp-2); }
.pt-lg-dot { width:16rpx; height:16rpx; border-radius:2rpx; background:var(--accent-deep); }

/* ========== 保费分布 7a/7b（2026-10-21）==========
   两张表共用一份数据：成员×险种（横滑，列多）+ 按公司（条形，纵向少）。
   表格刻意不画竖线：8 列在 375pt 上画网格会压掉字，靠列宽与右对齐读。 */
.ps-wrap { margin:var(--sp-3) 0 var(--sp-5); }
.ps-sec-head { display:flex; align-items:baseline; justify-content:space-between; gap:var(--sp-3); }
.ps-sec-head--gap { margin-top:var(--sp-6); }
.ps-sec-title { font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--text-primary); }
.ps-sec-unit { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.ps-scroll { width:100%; margin-top:var(--sp-3); }
.ps-table { display:inline-block; min-width:100%; }
.ps-tr { display:flex; align-items:center; }
.ps-tr--head { border-bottom:1rpx solid var(--border); }
.ps-tr--total { border-top:1rpx solid var(--border); }
.ps-th { flex:0 0 104rpx; padding:var(--sp-2) var(--sp-1); font-size:var(--fs-tiny); color:var(--text-tertiary); text-align:right; }
.ps-th--first { flex:0 0 132rpx; text-align:left; }
.ps-td { flex:0 0 104rpx; padding:var(--sp-2) var(--sp-1); font-size:var(--fs-tiny); color:var(--text-secondary); text-align:right; font-variant-numeric:tabular-nums; }
.ps-td--first { flex:0 0 132rpx; text-align:left; color:var(--text-primary); }
.ps-td--empty { color:var(--text-tertiary); }
.ps-td--total { font-weight:var(--fw-semi); color:var(--text-primary); }
.ps-ins { margin-top:var(--sp-4); }
.ps-ins-line { display:flex; align-items:baseline; justify-content:space-between; gap:var(--sp-3); }
.ps-ins-name { flex:1; min-width:0; font-size:var(--fs-caption); color:var(--text-primary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ps-ins-num { flex-shrink:0; font-size:var(--fs-tiny); color:var(--text-tertiary); font-variant-numeric:tabular-nums; }
.ps-ins-bar-wrap { margin-top:var(--sp-1); height:8rpx; background:var(--bg-input); border-radius:var(--r-full); overflow:hidden; }
.ps-ins-bar { height:100%; background:var(--accent-deep); border-radius:var(--r-full); }
.ps-note { display:block; margin-top:var(--sp-3); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-snug); }

/* ========== 异常与待核验 A1–A6（2026-10-21）==========
   编号用等宽 + 深金，便于口头引用（"看 A3"）；每条只占两行（谁·哪张 / 具体事实），
   不画卡片描边 —— 一屏能同时看到 6 类，才谈得上"清单"。 */
.an-wrap { padding:var(--sp-1) 0; }
.an-group { padding:var(--sp-4) 0; border-bottom:1rpx solid var(--border); }
.an-group:last-child { border-bottom:none; }
.an-head { display:flex; align-items:baseline; gap:var(--sp-2); }
.an-code { font-size:var(--fs-tiny); font-weight:var(--fw-semi); color:var(--accent-deep); font-variant-numeric:tabular-nums; letter-spacing:0.5rpx; }
.an-title { flex:1; font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--text-primary); }
.an-count { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.an-item { margin-top:var(--sp-3); }
.an-line { display:flex; align-items:baseline; gap:var(--sp-2); }
.an-who { flex-shrink:0; font-size:var(--fs-caption); color:var(--text-primary); }
.an-prod { flex:1; min-width:0; font-size:var(--fs-caption); color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.an-act { flex-shrink:0; font-size:var(--fs-tiny); color:var(--accent-deep); padding:var(--sp-1) var(--sp-2); }
.an-detail { display:block; margin-top:var(--sp-1); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-snug); }

/* ========== 成员卡片（2026-10-24）==========
   5 列在 375pt 上必然紧：险种 88rpx、保额 130rpx、保费 120rpx、两个期间各 flex:1 且允许换行。
   金额一律右对齐 + tabular-nums，否则 300/6,000 会跳来跳去。 */
.mc-wrap { margin-top:var(--sp-2); }
.mc-card { padding:var(--sp-5) 0; border-bottom:1rpx solid var(--border); }
.mc-card:last-child { border-bottom:none; }
.mc-head { display:flex; align-items:baseline; gap:var(--sp-2); margin-bottom:var(--sp-3); }
.mc-name { font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--text-primary); }
.mc-role { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.mc-total { margin-left:auto; font-size:var(--fs-tiny); color:var(--accent-deep); font-variant-numeric:tabular-nums; }
.mc-tr { display:flex; align-items:flex-start; }
.mc-tr--head { border-bottom:1rpx solid var(--border); padding-bottom:var(--sp-2); }
.mc-tr--inactive .mc-td { color:var(--text-tertiary); }
.mc-th { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.mc-td { font-size:var(--fs-tiny); color:var(--text-secondary); padding:var(--sp-2) 0; font-variant-numeric:tabular-nums; line-height:var(--lh-snug); }
.mc-th--cat, .mc-td--cat { flex:0 0 92rpx; color:var(--text-primary); }
.mc-th--sum, .mc-td--sum { flex:0 0 132rpx; text-align:right; font-weight:var(--fw-semi); }
.mc-th--prem, .mc-td--prem { flex:0 0 120rpx; text-align:right; }
.mc-th--period, .mc-td--period { flex:1; min-width:0; padding-left:var(--sp-3); }
.mc-th--pay, .mc-td--pay { flex:1; min-width:0; padding-left:var(--sp-3); }
.mc-foot { display:block; margin-top:var(--sp-2); font-size:var(--fs-tiny); color:var(--text-tertiary); }

/* ========== 分险种保额合计（2026-10-21）==========
   4 列固定宽度 + 备注行。备注不占列（否则"报销型不可加总"会把表挤爆），
   而是作为该行下方一行 tiny 说明 —— 它解释的是"为什么这里是 —"。 */
.ct-wrap { margin-top:var(--sp-6); padding-top:var(--sp-4); border-top:1rpx solid var(--border); }
.ct-tr { display:flex; align-items:baseline; }
.ct-tr--head { border-bottom:1rpx solid var(--border); padding-bottom:var(--sp-2); }
.ct-row { padding:var(--sp-3) 0; border-bottom:1rpx solid var(--border); }
.ct-row:last-child { border-bottom:none; }
.ct-th { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.ct-td { font-size:var(--fs-caption); color:var(--text-primary); font-variant-numeric:tabular-nums; }
.ct-th--cat, .ct-td--cat { flex:0 0 120rpx; }
.ct-th--sum, .ct-td--sum { flex:0 0 140rpx; text-align:right; font-weight:var(--fw-semi); }
.ct-th--mem, .ct-td--mem { flex:1; min-width:0; padding-left:var(--sp-3); color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ct-th--cnt, .ct-td--cnt { flex:0 0 150rpx; text-align:right; color:var(--text-secondary); }
.ct-note { display:block; margin-top:var(--sp-1); font-size:var(--fs-tiny); color:var(--text-tertiary); }

/* 时间线分组标题（2026-10-21）：比年份更弱、比正文更小，只起分隔作用 */
.tl-group { margin-top:var(--sp-5); }
.tl-group:first-child { margin-top:0; }
.tl-group-title { display:block; margin-bottom:var(--sp-2); font-size:var(--fs-tiny); color:var(--accent-deep); letter-spacing:var(--ls-wide); }

/* ========== 待完善清单（2026-10-18 第二步 IA）==========
   密度接近表格：一行保单 + 若干问题点；不画卡片描边（一章里可能有 5~10 条，
   每条都描边会比数据本身更重）。 */
.pd-wrap { padding:var(--sp-1) 0; }
.pd-item { padding:var(--sp-4) 0; border-bottom:1rpx solid var(--border); }
.pd-item:last-child { border-bottom:none; }
.pd-head { display:flex; align-items:baseline; justify-content:space-between; gap:var(--sp-3); }
.pd-name { flex:1; min-width:0; font-size:var(--fs-caption); color:var(--text-primary); font-weight:var(--fw-semi); }
.pd-act { flex-shrink:0; font-size:var(--fs-tiny); color:var(--accent-deep); padding:var(--sp-1) var(--sp-2); }
.pd-detail { display:block; margin-top:var(--sp-1); font-size:var(--fs-tiny); color:var(--text-secondary); line-height:var(--lh-snug); }

/* 家庭结构里的成员规模（张数 · 保额）：比角色更弱一档，不抢姓名 */
.ft-scale { display:block; margin-top:2rpx; font-size:var(--fs-tiny); color:var(--text-tertiary); }

/* ========== 概览块（2026-10-18 IA 重构）==========
   与章节正文同一套排版：无独立卡底（章节本身就是卡片），只用分隔线分组。
   刻意不再画"第二张摘要卡" —— 那正是本次消除的重复。 */
.ov-wrap { padding:var(--sp-2) 0 var(--sp-3); }
.ov-meta { font-size:var(--fs-caption); color:var(--text-secondary); }
.ov-pair { display:flex; gap:var(--sp-6); margin-top:var(--sp-4); }
.ov-pair-item { flex:1; min-width:0; }
.ov-pair-val { font-size:var(--fs-xl); font-weight:var(--fw-bold); color:var(--text-primary); letter-spacing:var(--ls-wide); }
.ov-pair-lbl { margin-top:2rpx; font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:1.4; }
.ov-cat-row { display:flex; flex-wrap:wrap; align-items:center; gap:var(--sp-2); margin-top:var(--sp-4); }
.ov-cat-label { font-size:var(--fs-tiny); color:var(--text-tertiary); margin-right:var(--sp-1); }
.ov-chip { font-size:var(--fs-tiny); color:var(--text-secondary); background:var(--bg-input); padding:var(--sp-1) var(--sp-3); border-radius:var(--r-full); }
.ov-note { margin-top:var(--sp-2); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-snug); }
/* "无任何保单：母亲"是硬事实，不是脚注 —— 用深一档颜色，避免被下面的口径声明淹没 */
.ov-note--alert { color:var(--text-secondary); font-weight:var(--fw-semi); }
/* 保障型 / 储蓄型构成（2026-10-24）：两段横条 + 图例（替代环形图，见 wxml 注释） */
.ov-mix { margin-top:var(--sp-4); }
.ov-mix-bar { display:flex; height:14rpx; border-radius:var(--r-full); overflow:hidden; background:var(--bg-input); }
.ov-mix-seg--prot { background:var(--accent-deep); }
.ov-mix-seg--sav { background:var(--border-accent); }
.ov-mix-legend { display:flex; gap:var(--sp-5); margin-top:var(--sp-2); }
.ov-mix-item { display:flex; align-items:baseline; gap:var(--sp-1); font-size:var(--fs-tiny); }
.ov-mix-dot { width:12rpx; height:12rpx; border-radius:2rpx; }
.ov-mix-dot--prot { background:var(--accent-deep); }
.ov-mix-dot--sav { background:var(--border-accent); }
.ov-mix-name { color:var(--text-secondary); }
.ov-mix-val { color:var(--text-tertiary); font-variant-numeric:tabular-nums; }

/* 覆盖检查：与风险条之间用分隔线，避免两块结论挤在一起（2026-10-24 已移出概览，样式保留供旧数据） */
.ov-check { margin-top:var(--sp-5); padding-top:var(--sp-4); border-top:1rpx solid var(--border); }
.ov-check-lead { font-size:var(--fs-caption); color:var(--text-primary); margin-bottom:var(--sp-3); }
.ov-alert { display:flex; align-items:flex-start; gap:var(--sp-2); margin-top:var(--sp-2); }
.ov-dot { flex-shrink:0; width:10rpx; height:10rpx; border-radius:50%; margin-top:14rpx; background:var(--text-tertiary); }
.ov-alert.is-warn .ov-dot { background:var(--red); }
.ov-alert.is-ok .ov-dot { background:var(--ok-deep); }
.ov-alert.is-unknown .ov-dot { background:var(--text-tertiary); }
.ov-alert-text { font-size:var(--fs-caption); color:var(--text-secondary); line-height:var(--lh-snug); }
.ov-advice { margin-top:var(--sp-3); font-size:var(--fs-caption); color:var(--accent-deep); line-height:var(--lh-snug); }
.ov-risks { margin-top:var(--sp-5); padding-top:var(--sp-4); border-top:1rpx solid var(--border); }
.ov-risk { margin-top:var(--sp-4); }
.ov-risk:first-child { margin-top:0; }
.ov-risk-head { display:flex; align-items:baseline; gap:var(--sp-2); }
.ov-risk-level { flex-shrink:0; font-size:var(--fs-tiny); font-weight:var(--fw-semi); }
.ov-risk--red .ov-risk-level { color:var(--red); }
.ov-risk--yellow .ov-risk-level { color:var(--accent-deep); }
.ov-risk--ok .ov-risk-level { color:var(--ok-deep); }
.ov-risk-title { font-size:var(--fs-caption); color:var(--text-primary); font-weight:var(--fw-semi); }
.ov-risk-detail { display:block; margin-top:var(--sp-1); font-size:var(--fs-caption); color:var(--text-secondary); line-height:var(--lh-snug); }
.ov-risk-basis { display:block; margin-top:var(--sp-1); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-snug); }

.pc-meta-row { font-size:var(--fs-caption); color:var(--text-secondary); font-variant-numeric:tabular-nums; margin-top:var(--sp-1); }
.pc-meta-row:first-of-type { margin-top:var(--sp-3); padding-top:var(--sp-3); border-top:1rpx solid var(--border); }
/* 原文出处（2026-10-18）：比普通元信息更弱一档（tiny + tertiary），
   它是"核对用的脚注"而不是保单事实本身，不该与保额/保费抢注意力。 */
.pc-evidence { font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-snug); }

/* 章节前言（保障汇总缺失提示）：告警语义——浅红底 + 红字，与「特别提醒」risk-item 同构；
   区别于中性灰注释 .md-note（当前无章节使用）。此前无样式定义，默认字号 32rpx 比正文还大 */
.md-pre { font-size:var(--fs-base); color:var(--red-deep); line-height:var(--lh-body); margin:var(--sp-4) 0 0; padding:var(--sp-3) var(--sp-4); background:var(--red-dim); border-radius:var(--r-sm); }

/* 章节内注释 */
.md-note { font-size:var(--fs-tiny); color:var(--text-tertiary); margin-top:var(--sp-3); text-align:right; }

/* 章节折叠（附录默认收起，编辑风折叠头） */
.fold-hd { display:flex; align-items:center; justify-content:space-between; padding:var(--sp-5) var(--sp-1); margin-bottom:var(--sp-2); border-bottom:1rpx solid var(--border-accent); }
.fold-title { font-size:var(--fs-lg); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); }
.fold-arrow { display:inline-flex; align-items:center; justify-content:center; min-height:88rpx; font-size:var(--fs-caption); color:var(--accent-deep); padding:var(--sp-2) var(--sp-3); box-sizing:border-box; transition:transform var(--dur-base) var(--ease-out); }
