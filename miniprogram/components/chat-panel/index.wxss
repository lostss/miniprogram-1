.chat-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-dim); z-index:var(--z-overlay); animation:fadeIn var(--dur-base) var(--ease-out); -webkit-backdrop-filter:blur(8rpx); backdrop-filter:blur(8rpx); }
.chat-panel { position:fixed; left:0; right:0; bottom:0; height:70vh; background:var(--bg-surface); border-radius:var(--r-2xl) var(--r-2xl) 0 0; display:flex; flex-direction:column; z-index:var(--z-panel); animation:slideUp var(--dur-base) var(--ease-spring); box-shadow:var(--shadow-sheet); }
/* FAB 栏全高（88rpx 输入框 + 上下 sp-4×2 内边距），消息底部预留依赖此变量（消除 120rpx 魔法数） */
.drag-bar { width:56rpx; height:6rpx; background:var(--accent-muted); border-radius:3rpx; margin:var(--sp-6) auto var(--sp-5); flex-shrink:0 }
/* UI 打磨：标题区与消息区分层（底部金色细线呼应报告页 h1n 分割线语言） */
.chat-title { text-align:center; margin-bottom:var(--sp-5); flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:var(--sp-1); padding-bottom:var(--sp-5); border-bottom:1rpx solid var(--border-accent); }
.chat-title-text { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide) }
.chat-title-sub { font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:var(--ls-wider) }
.msg-list { flex:1; min-height:0; }
/* 底部预留 = FAB 栏全高(88rpx 输入框 + 上下 sp-4×2 内边距) + sp-6 呼吸间距；此前漏算 fab-bar padding 致消息贴栏 */
.msg-inner { padding:var(--sp-3) var(--sp-5) calc(var(--sp-6) + 120rpx + env(safe-area-inset-bottom)) }
.msg-row { margin-bottom:var(--sp-6) }
.msg-row.assistant { text-align:left }
.msg-row.user { text-align:right }

/* UX-3 修复：AI 气泡格式（浅色背景 + 左上角小圆角，与 thinking-bubble 一致，与用户气泡右上角小圆角对称） */
.ai-msg { display:block; max-width:88%; font-size:var(--fs-body); line-height:var(--lh-loose); color:var(--text-primary); text-align:left; box-sizing:border-box; animation:fadeIn var(--dur-base) var(--ease-out); background:var(--bg-card); border-radius:6rpx 18rpx 18rpx 18rpx; padding:var(--sp-4) var(--sp-5) }
/* 错误提示审计 #7：AI 错误消息独立视觉（红色调背景区别于正常回复） */
.ai-msg--err { background:var(--red-dim) }
.ai-msg-time { font-size:var(--fs-tiny); color:var(--text-disabled); margin-top:var(--sp-2); line-height:var(--lh-none); }

/* UI 打磨：气泡入场去回弹缓动（与 ai-msg fadeIn 统一） */
.bubble { display:inline-block; max-width:82%; padding:var(--sp-4) var(--sp-5); font-size:var(--fs-base); line-height:var(--lh-body); word-break:break-word; text-align:left; box-sizing:border-box; animation:fadeUp var(--dur-slow) var(--ease-out) }
/* UI 审计 #②：用户气泡 accent 白字 2.24:1 不达标，改深色文字（7.62:1） */
.bubble.user { background:var(--accent); color:var(--btn-text-on-accent); border-radius:18rpx 6rpx 18rpx 18rpx; }

.retry-btn { display:inline-flex; align-items:center; justify-content:center; margin-top:var(--sp-3); padding:var(--sp-2) var(--sp-5); border:1rpx solid var(--accent-muted); border-radius:var(--r-full); font-size:var(--fs-caption); color:var(--accent-deep); background:transparent }
.retry-btn:active { opacity:0.6 }

/* 默认执行+撤销（②）：执行结果 + 撤销按钮 */
.undo-bar { margin-top:var(--sp-5); display:flex; flex-direction:column; gap:var(--sp-3); }
.undo-item { display:flex; align-items:center; justify-content:space-between; gap:var(--sp-4); background:var(--accent-dim); border-radius:var(--r-md); padding:var(--sp-3) var(--sp-5); }
.undo-text { font-size:var(--fs-caption); color:var(--accent-deep); flex:1; }
.undo-btn { flex-shrink:0; display:inline-flex; align-items:center; justify-content:center; padding:var(--sp-2) var(--sp-5); border:1rpx solid var(--accent); border-radius:var(--r-full); font-size:var(--fs-caption); color:var(--accent-deep); background:transparent; }
.undo-btn:active { opacity:0.6 }

/* AI 处理中占位：气泡样式（无边框线，背景色即可区分气泡；与用户气泡 bubble.user 视觉语言一致） */
.thinking-bubble { display:inline-flex; align-items:center; gap:var(--sp-3); padding:var(--sp-4) var(--sp-5); background:var(--bg-card); border-radius:6rpx 18rpx 18rpx 18rpx; max-width:82%; box-sizing:border-box; animation:fadeUp var(--dur-slow) var(--ease-out) }
.thinking-bubble .thinking-dots { padding:0 }
.streaming-text { font-size:var(--fs-caption); color:var(--text-tertiary); }

/* 确认卡（单通道 v10：写入成员/财务/保单类工具待代理人确认） */
.confirm-card { margin-top:var(--sp-5); display:flex; flex-direction:column; gap:var(--sp-4); }
.confirm-card-item { background:var(--bg-card); border:1rpx solid var(--border); border-left:6rpx solid var(--accent); border-radius:var(--r-lg); padding:var(--sp-4) var(--sp-5); display:flex; flex-direction:column; gap:var(--sp-3); }
.confirm-card-head { display:flex; align-items:center; justify-content:space-between; }
.confirm-card-target { font-size:var(--fs-base); font-weight:var(--fw-semi); color:var(--text-primary); }
.confirm-card-badge { font-size:var(--fs-tiny); color:var(--accent-deep); background:var(--accent-dim); border-radius:var(--r-full); padding:var(--sp-1) var(--sp-4); letter-spacing:var(--ls-wide); }
.confirm-card-summary { font-size:var(--fs-base); line-height:var(--lh-body); color:var(--text-secondary); word-break:break-all; }
.confirm-card-actions { display:flex; justify-content:flex-end; gap:var(--sp-3); }
.confirm-btn { display:inline-flex; align-items:center; justify-content:center; min-width:120rpx; padding:var(--sp-3) var(--sp-6); border-radius:var(--r-full); font-size:var(--fs-caption); letter-spacing:var(--ls-wide); }
.confirm-btn--cancel { background:transparent; border:1rpx solid var(--border); color:var(--text-tertiary); }
.confirm-btn--cancel:active { background:var(--bg-input); }
.confirm-btn--ok { background:var(--accent); color:var(--btn-text-on-accent); }
.confirm-btn--ok:active { opacity:0.7; }

/* 空态引导 */
.msg-empty { display:flex; flex-direction:column; gap:var(--sp-4); padding:var(--sp-8) var(--sp-5) var(--sp-6); align-items:flex-start; }
.msg-empty-title { font-size:var(--fs-base); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); }
.msg-empty-sub { font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:var(--ls-wide); margin-top:calc(var(--sp-4) * -1); }
.msg-empty-chip { display:inline-flex; align-items:center; justify-content:center; font-size:var(--fs-base); color:var(--text-secondary); background:var(--bg-card); border:1rpx solid var(--border); border-radius:var(--r-full); padding:var(--sp-2) var(--sp-5); }
.msg-empty-chip:active { opacity:0.6 }
.thinking-dots { display:flex; gap:var(--sp-2); padding:var(--sp-2) 0; opacity:0; animation:dotFadeIn var(--dur-base) var(--ease-out) .1s forwards }
.thinking-dot { width:10rpx; height:10rpx; border-radius:50%; background:var(--accent); animation:dotBounce 1.4s var(--ease-out) infinite }
.thinking-dot:nth-child(2){animation-delay:.2s}.thinking-dot:nth-child(3){animation-delay:.4s}


