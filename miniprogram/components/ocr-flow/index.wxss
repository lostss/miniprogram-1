/* ========== 遮罩与卡片 ========== */
.ocr-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-strong); z-index:var(--z-modal); display:flex; align-items:center; justify-content:center; padding:var(--sp-6) }
.ocr-card { width:100%; max-width:640rpx; max-height:78vh; min-height:44vh; overflow-y:auto; background:var(--bg-surface); border-radius:var(--r-lg); padding:var(--sp-5) var(--sp-5) var(--sp-4); box-sizing:border-box; display:flex; flex-direction:column; align-items:center; animation:popIn var(--dur-fast) var(--ease-spring) }

/* ========== 处理中 ========== */
.proc-head { width:100%; text-align:center }
.proc-phase { font-size:var(--fs-caption); color:var(--text-tertiary); margin-top:var(--sp-2); text-align:center }
/* UI 审计 状态 S1：进行中取消按钮 */
.proc-cancel { display:inline-block; margin-top:var(--sp-5); padding:var(--sp-2) var(--sp-7); border:1rpx solid var(--border-accent); border-radius:var(--r-full); color:var(--accent-deep); font-size:var(--fs-caption); background:transparent }
.proc-cancel:active { background:var(--bg-input) }
.proc-progress-bar { width:100%; height:6rpx; background:var(--bg-input); border-radius:3rpx; overflow:hidden; margin-top:var(--sp-5) }
.proc-progress-fill { height:100%; background:var(--accent); border-radius:3rpx; transition:width 0.3s var(--ease-out) }
/* UI 审计 V-S3：--ease-in-out 未定义，改 --ease-out */
.proc-progress-fill--indef { width:40%; animation:indefLoad 1.2s var(--ease-out) infinite }
@keyframes indefLoad { 0% { transform:translateX(-120%) } 100% { transform:translateX(320%) } }
.proc-pending-cards { width:100%; margin-top:var(--sp-4); display:flex; flex-wrap:wrap; gap:var(--sp-3) }
.proc-pending-card { position:relative; width:100%; display:flex; align-items:center; padding:var(--sp-3) var(--sp-3-5); background:var(--bg-input); border-radius:var(--r-md); box-sizing:border-box }
.proc-pending-state { flex-shrink:0; font-size:var(--fs-tiny); color:var(--text-tertiary) }
.stream-pulse-bar { flex:1; height:26rpx; border-radius:var(--sp-1); background:var(--border); position:relative; overflow:hidden }
.stream-pulse-bar::after { content:''; position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent); transform:translateX(-100%); animation:skeleton-shimmer 1.4s infinite }
.stream-pulse-bar.is-error { background:var(--red-dim) }
.stream-pulse-bar.is-ok { background:var(--green-dim, #e8eddf) }
/* UI 审计 交互 L3：识别结果空态兜底 */
.proc-empty { padding:var(--sp-10) 0; text-align:center; font-size:var(--fs-caption); color:var(--text-tertiary) }
@keyframes skeleton-shimmer { 100% { transform:translateX(100%) } }

/* ========== 三组列表 ========== */
.proc-list { width:100%; max-height:56vh; margin:var(--sp-4) 0 var(--sp-3) }
.proc-group-head { display:flex; align-items:center; justify-content:space-between; font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:var(--ls-wide); margin:var(--sp-4) 0 var(--sp-2) }
.proc-group-head:first-child { margin-top:0 }
.proc-group-head--err { color:var(--red) }
.proc-retry-all { display:inline-flex; align-items:center; justify-content:center; min-height:88rpx; color:var(--accent-deep); padding:var(--sp-1) var(--sp-3); border-radius:var(--r-full); background:var(--accent-dim) }
.proc-retry-all:active { opacity:0.6 }
/* 等高：thumb 为 wx:if 条件渲染，无缩略图卡片高度缩水 → 固定 min-height = thumb(72) + padding(2×12)，三组卡片统一等高 */
.proc-card { display:flex; align-items:center; padding:var(--sp-3) var(--sp-3-5); background:var(--bg-input); border-radius:var(--r-md); margin-bottom:var(--sp-2); border-left:8rpx solid var(--green); min-height:96rpx }
.proc-card--review { border-left-color:var(--amber-deep) }
.proc-card--err { border-left-color:var(--red); background:var(--bg-error-soft) }
.proc-thumb { width:72rpx; height:72rpx; border-radius:var(--r-sm); flex-shrink:0; margin-right:var(--sp-3); background:var(--border) }
.proc-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:var(--sp-1) }
.proc-name { font-size:var(--fs-base); font-weight:var(--fw-semi); color:var(--text-primary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap }
.proc-cat { font-size:var(--fs-caption); color:var(--text-tertiary); font-weight:var(--fw-normal) }
.proc-date { font-size:var(--fs-tiny); color:var(--text-tertiary) }
/* 失败原因横滚容器：flex:1 占满剩余宽度，内层 nowrap 滚动展示完整文案 */
.proc-err-scroll { flex:1; min-width:0; white-space:nowrap; }
.proc-err { font-size:var(--fs-caption); color:var(--red); white-space:nowrap; display:inline-block; }
.proc-side { flex-shrink:0; display:flex; align-items:center; gap:var(--sp-2) }
/* 移除按钮：弱化次级（灰字无底），点击二次确认 */
.proc-ignore-btn { display:inline-flex; align-items:center; justify-content:center; min-height:88rpx; font-size:var(--fs-caption); color:var(--text-tertiary); padding:var(--sp-1-5) var(--sp-3); border-radius:var(--r-full) }
/* UI 审计 #②：#③：accent 背景改深色文字达标；badge-ok 收敛为全局 --ok 系 */
/* UI 审计：重试按钮降权——异常卡内次级操作，accent 实底(主按钮级) 改浅金底 accent-dim */
.proc-retry-btn { display:inline-flex; align-items:center; justify-content:center; min-height:88rpx; font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); padding:var(--sp-1-5) var(--sp-4); border-radius:var(--r-full) }
.proc-retry-btn:active { opacity:0.6 }
.proc-retry-btn.is-busy { opacity:0.6 }
.ocr-badge { font-size:var(--fs-tiny); padding:var(--sp-1) var(--sp-2); border-radius:var(--r-full) }
.ocr-badge.badge-ok { color:var(--ok-deep, #1a7f4f); background:var(--ok-dim, #e6f4ec) }
.ocr-badge.badge-warn { color:var(--amber-deep); background:var(--amber-dim, #f7eedb) }
.ocr-badge.badge-cash { color:var(--accent-deep); background:var(--accent-dim) }

/* ========== 匹配弹窗 ========== */
.match-card { display:flex; align-items:center; padding:var(--sp-4) var(--sp-3-5); background:var(--bg-input); border-radius:var(--r-md); margin-bottom:var(--sp-2); border:2rpx solid transparent; transition:border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out) }
.match-card--on { border-color:var(--accent); background:var(--accent-dim) }
/* UI 审计 视觉 S4：#c9c2b6 硬编码 → --border */
.match-radio { width:36rpx; height:36rpx; border-radius:50%; border:2rpx solid var(--border); flex-shrink:0; display:flex; align-items:center; justify-content:center }
.match-card--on .match-radio { border-color:var(--accent); background:var(--accent) }
.match-card--on .match-radio::after { content:''; width:14rpx; height:14rpx; border-radius:50%; background:var(--color-on-accent) }
.match-body { flex:1; min-width:0; display:flex; flex-direction:column; gap:var(--sp-1); margin-left:var(--sp-3) }
.match-name { font-size:var(--fs-base); font-weight:var(--fw-semi); color:var(--text-primary) }
.match-members { font-size:var(--fs-tiny); color:var(--text-tertiary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap }

/* ========== 按钮 ========== */
.ocr-actions-row { width:100%; display:flex; gap:var(--sp-3) }
.ocr-modify-btn { flex:1; height:88rpx; background:var(--bg-surface); color:var(--text-tertiary); font-size:var(--fs-body); font-weight:var(--fw-medium); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:1rpx solid var(--border) }
.ocr-modify-btn::after { border:none }
/* UI 审计 #②：组件内定义覆盖 app.wxss 全局（app.wxss 改动对此不生效），一并改深色文字 */
.ocr-confirm-btn { flex:1; height:88rpx; background:var(--accent); color:var(--btn-text-on-accent); font-size:var(--fs-lg); font-weight:var(--fw-semi); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:none }
.ocr-confirm-btn::after { border:none }
.ocr-confirm-btn.is-loading { background:var(--accent-dim) }
.ocr-confirm-btn[disabled] { opacity:0.7 }

/* ========== 文案态 ========== */
/* UI 审计：popIn 组件内仍用 ease-spring（app.wxss 全局改 expo 因组件样式隔离未生效），此处收敛 */
.ocr-done-title { font-size:var(--fs-2xl); font-weight:var(--fw-semi); color:var(--text-primary); font-family:var(--font-serif); margin-bottom:var(--sp-2); animation:popIn 0.4s var(--ease-out-expo); text-align:center }
.done-gold { color:var(--accent-deep) }
.done-green { color:var(--green, #6B8E6B) }
.done-red { color:var(--red) }
.ocr-done-sub { font-size:var(--fs-caption); color:var(--text-tertiary); margin-bottom:var(--sp-5); text-align:center }
.ocr-phase-sub { font-size:var(--fs-tiny); color:var(--text-disabled); text-align:center; margin-top:var(--sp-2) }
.ocr-saved-head { width:100%; display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--sp-2) }
.ocr-saved-progress { height:4rpx; background:var(--accent-dim); border-radius:2rpx; margin-top:var(--sp-4); overflow:hidden; width:100% }
.ocr-saved-progress::after { content:''; display:block; height:100%; width:100%; background:var(--accent); animation:savedCountdown 2s linear forwards }
@keyframes savedCountdown { from { width:100% } to { width:0% } }

/* ========== 角色卡 ========== */
.role-row { display:flex; align-items:center; padding:var(--sp-3) 0 }
.role-row + .role-row { border-top:1rpx solid var(--border) }
.role-name { width:100rpx; font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); flex-shrink:0 }
.role-opts { display:flex; gap:var(--sp-2); flex-wrap:wrap }
/* UI 审计：role-opt 触控目标扩大（padding sp-1-5→sp-3，48rpx→72rpx 高，高频成员角色选择防误触） */
.role-opt { font-size:var(--fs-caption); color:var(--text-tertiary); padding:var(--sp-3) var(--sp-5); border-radius:var(--r-full); background:var(--bg-input); transition:background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out) }
.role-opt:active { transform:scale(0.94) }
.role-opt--on { color:var(--color-on-accent); background:var(--accent-deep); font-weight:var(--fw-semi) }
/* 被占用角色：置灰提示（仍可点击触发替换确认） */
.role-opt--off { color:var(--text-disabled); background:var(--bg-disabled); opacity:0.75 }
.role-opt-holder { font-size:var(--fs-tiny); margin-left:var(--sp-1) }
.role-tip { margin-top:var(--sp-4); text-align:center }

/* ========== 编辑 sheet（统一 edit-sheet 组件承载，样式见 edit-sheet/index.wxss） ========== */
