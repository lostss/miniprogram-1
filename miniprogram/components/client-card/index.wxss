.card {
  display: flex; align-items: center;
  padding: var(--sp-5) var(--sp-5) var(--sp-5) 0; margin-bottom:0;
  background: var(--bg-card); border-radius: var(--r-xl);
  border: 1rpx solid var(--border);
  transition: transform var(--dur-fast) var(--ease-out);
  position: relative; overflow: hidden;
}
.card::before {
  content: ''; position: absolute; left: 0; top: var(--sp-3); bottom: var(--sp-3);
  width: 4rpx; border-radius: 0 var(--r-sm) var(--r-sm) 0;
  background: var(--accent);
}

.card:active { transform: scale(0.98) }
.card-body { flex: 1; min-width: 0; padding-left: var(--sp-5); }
.card-row { display: flex; align-items: baseline; line-height: var(--lh-snug); }
.card-name { font-size: var(--fs-lg); font-weight: var(--fw-semi); color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 2026-09-12：原 .card-label（family_label 死字段，前后端均不存在）已移除渲染，样式改为成交标记 */
.card-deal { font-size: var(--fs-caption); color: var(--ok-deep); background: var(--ok-dim); padding: 2rpx var(--sp-3); border-radius: var(--r-full); margin-left: var(--sp-3); flex-shrink: 0; line-height:1.6 }
.card-time { font-size: var(--fs-caption); color: var(--text-secondary); margin-top: var(--sp-1-5); }
/* 超过 30 天未更新：用强调色提示"该跟进了"（金色=提示，不用红色报警语义） */
.card-time.is-stale { color: var(--accent-deep); }
/* 2026-10-17 移除：.card-right / .ring-wrap / .ring / .ring-hole / .ring-text
   —— 资料完整度圆环不再呈现（用户决策），保留空样式只会是死代码。 */
