/* ============================================================
   保小秘 — Luxury/Refined 暖色主题（v2 高级感优化）
   暖米白底 | 暖金点缀 | 深蓝黑文字 | 折纸质感 | 衬线标题
   降饱和状态色 · 克制阴影 · 留白节奏
   ============================================================ */

page {
  box-sizing: border-box;

  /* 背景 — 暖奶油白，与 window 栏 #F5F0EB 一致 */
  --bg-root: #F5F0EB;
  --bg-surface: #FBF8F3;
  /* 纯白→极淡暖白（审计 P2：暖米白底上纯白偏冷，暖白统一折纸质感） */
  --bg-card: #FFFDF9;
  --bg-input: #F5F0EB;

  /* 边框 */
  --border: #E8E0D5;
  --border-accent: rgba(201, 169, 110, 0.5);

  /* 强调色 — 暖金 */
  --accent: #C9A96E;
  --accent-deep: #8B6F3C;
  --accent-dim: rgba(201, 169, 110, 0.12);
  --accent-glow: rgba(201, 169, 110, 0.35);
  --accent-muted: #E0D4BD;
  --color-on-accent: #FFFFFF;
  --color-on-accent-soft: #F5EBD8;

  /* 状态色（amber 偏黄拉开与金色强调的距离） */
  --green: #6B8E6B;
  --amber: #B8912E;
  --amber-deep: #7C5E1C;
  --red: #B85450;
  --green-dim: #E8EDDF;
  --amber-dim: #F5ECCE;
  --red-dim: #EBD8D2;

  /* UI 审计：置信度底色 token（ocr-flow/edit-sheet 原两处硬编码 #FFF8E1 等，收敛复用） */
  --tone-mid: #FFF8E1;
  --tone-low: #FFF0E0;
  --tone-modified: #E3F2FD;

  /* UI 审计 #③：报告/OCR 绿色收敛（原 --green-report/--green-deep 分散定义，统一为 --ok 系） */
  --ok: #4A9C6D;
  --ok-deep: #1a7f4f;
  --ok-dim: #e6f4ec;

  /* 文字 */
  --text-primary: #1A1A2E;
  --text-secondary: #6E5A3E;
  --text-tertiary: #6B5A3F;
  --text-disabled: #9A8B7C;

  /* 字体 */
  --font: 'PingFang SC', 'HarmonyOS Sans SC', 'Noto Sans CJK SC', -apple-system, 'Microsoft YaHei', sans-serif;
  --font-serif: 'Songti SC', 'STSong', 'Source Han Serif SC', 'Noto Serif SC', serif;
  --font-mono: 'SF Mono', Monaco, 'Cascadia Code', monospace;

  /* 字号阶梯（UI 打磨：消除 26/30 两档 2rpx 重复，层级 20→24→28→32→36→40→44→52 每档 ≥4rpx） */
  --fs-tiny: 20rpx;
  --fs-caption: 24rpx;
  --fs-base: 28rpx;
  --fs-body: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 36rpx;
  --fs-2xl: 40rpx;
  --fs-display: 44rpx;
  --fs-3xl: 52rpx;
  --fs-hero: 52rpx;

  --fw-normal: 400;
  --fw-medium: 500;
  --fw-semi: 600;
  --fw-bold: 700;

  --lh-none: 1;
  --lh-tight: 1.2;
  --lh-snug: 1.35;
  --lh-body: 1.7;
  --lh-loose: 1.85;

  --ls-tight: -0.5rpx;
  --ls-normal: 0;
  --ls-wide: 1rpx;
  --ls-wider: 4rpx;

  /* 间距 */
  --sp-1: 4rpx; --sp-1-5: 6rpx; --sp-2: 8rpx; --sp-3: 12rpx;
  /* 全链路审计 UC1：--sp-3-5 原缺失导致 ocr-flow padding shorthand 整体失效回退 0 */
  --sp-3-5: 14rpx;
  --sp-4: 16rpx; --sp-4-5: 20rpx; --sp-5: 24rpx;
  --sp-6: 32rpx; --sp-7: 40rpx; --sp-8: 48rpx; --sp-9: 52rpx; --sp-10: 56rpx;

  /* 圆角 */
  --r-sm: 8rpx; --r-md: 16rpx; --r-lg: 20rpx;
  --r-xl: 24rpx; --r-2xl: 32rpx; --r-full: 9999rpx;

  /* 动画 */
  --dur-fast: 0.15s; --dur-base: 0.25s; --dur-slow: 0.3s; --dur-glacial: 0.5s;
  --ease-out: cubic-bezier(0.25, 0.1, 0.25, 1);
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in: cubic-bezier(0.42, 0, 1, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* 阴影 — 暖色调多层级 */
  --shadow-sm: 0 1rpx 3rpx rgba(60,50,30,0.04);
  --shadow-md: 0 2rpx 8rpx rgba(60,50,30,0.05);
  --shadow-lg: 0 4rpx 16rpx rgba(60,50,30,0.07);
  --shadow-sheet: 0 -4rpx 24rpx rgba(60,50,30,0.08);

  --z-base: 1; --z-overlay: 90; --z-panel: 100;
  --z-sheet: 200; --z-modal: 300; --z-sheet-inner: 310; --z-sheet-inner-top: 311; --z-toast: 400;
  /* 弹层叠加审计：表格全屏（原组件内硬编码 1000）纳入 token 体系，防未来全局层被意外盖住 */
  --z-fullscreen: 1000;

  --overlay-dim: rgba(26,26,46,0.35);
  --overlay-strong: rgba(26,26,46,0.6);
  /* 弹层叠加审计：ocr-sheet-mask 原硬编码 rgba(0,0,0,0.4)（层中层遮罩），收敛为 token（0.4 介于 dim/strong 之间，语义=次顶层遮罩） */
  --overlay-inner: rgba(26,26,46,0.4);

  background: var(--bg-root);
  font-family: var(--font);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;

  /* ② 全局选中色：暖金替代系统蓝 */
  -webkit-tap-highlight-color: rgba(201,169,110,0.15);
}

page ::selection { background: rgba(201,169,110,0.25); color: var(--text-primary); }

/* 全局页面容器动画（不放在 page 选择器上，避免破坏 position:fixed） */
.page-view { animation: pageEnter 0.35s var(--ease-spring) both; }
@keyframes pageEnter {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   集中 keyframes（统一动画定义，避免各组件重复声明）
   ============================================================ */
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes cardUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes cardReveal {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}
@keyframes breathe {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.04); }
}
@keyframes dotFadeIn { from { opacity: 0 } to { opacity: 1 } }
@keyframes dotBounce { 0%, 80%, 100% { transform: scale(0.6) } 40% { transform: scale(1) } }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes shimmer { 0% { background-position: 200% 0 } 100% { background-position: -200% 0 } }
@keyframes popIn {
  0% { opacity: 0; transform: scale(0.85); }
  60% { transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes numberCountUp {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.anim-number { animation: numberCountUp var(--dur-base) var(--ease-out) forwards; }

/* 卡片入场交错（通用工具类） */
.card-stagger { animation: cardReveal var(--dur-glacial) var(--ease-out-expo) both; }
.card-stagger:nth-child(1) { animation-delay: 0s; }
.card-stagger:nth-child(2) { animation-delay: 0.08s; }
.card-stagger:nth-child(3) { animation-delay: 0.16s; }
.card-stagger:nth-child(4) { animation-delay: 0.22s; }
.card-stagger:nth-child(5) { animation-delay: 0.28s; }
.card-stagger:nth-child(6) { animation-delay: 0.34s; }

/* 阅读卡片：纯功能，无装饰 */
.paper-card {
  border-radius: var(--r-xl); background: var(--bg-surface);
  box-shadow: var(--shadow-sm);
}

/* 数字块共享类（审计 P3：report 页 .sc-cell 与 report-markdown .fin-item 同构合并）：
   衬线大字 + 全宽小标，bg-root 内嵌于卡片 */
.num-cell { flex:1; min-width:0; display:flex; flex-wrap:wrap; align-items:baseline; justify-content:center; gap:var(--sp-1); background:var(--bg-root); border-radius:var(--r-lg); padding:var(--sp-4) var(--sp-3); }
.num-val { font-size:var(--fs-2xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); line-height:var(--lh-none); font-variant-numeric:tabular-nums; }
.num-unit { font-size:var(--fs-tiny); color:var(--text-secondary); }
.num-lbl { width:100%; text-align:center; font-size:var(--fs-tiny); color:var(--text-tertiary); margin-top:var(--sp-2); letter-spacing:var(--ls-wide); }

/* 工具 */
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.safe-bottom { padding-bottom: 0px; padding-bottom: env(safe-area-inset-bottom); }
.pressable { transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
.pressable:active { opacity: 0.85; transform: scale(0.98); }

/* ⑤ 全局隐藏滚动条：小程序不支持 overflow: overlay，降级隐藏 */
::-webkit-scrollbar { width: 0; height: 0; background: transparent; }

/* ============================================================
   OCR 进度蒙层（全局共享，避免 index / report 重复定义）
   ============================================================ */
.ocr-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-strong); z-index:var(--z-modal); display:flex; align-items:center; justify-content:center; animation:fadeIn var(--dur-base) var(--ease-out) }
.ocr-card { width:600rpx; max-height:80vh; padding:var(--sp-10) var(--sp-7); display:flex; flex-direction:column; align-items:center; background:var(--bg-surface); border-radius:var(--r-xl); box-shadow:var(--shadow-lg); animation:cardUp var(--dur-base) var(--ease-out) }

/* 进度条 */
.ocr-bar-wrap { width:100%; margin-bottom:var(--sp-6); }
.ocr-bar { width:100%; height:6rpx; background:var(--bg-input); border-radius:3rpx; overflow:hidden; }
.ocr-bar-fill { height:100%; background:var(--accent); border-radius:3rpx; transition:width 0.3s var(--ease-out); }

/* 进度数字：大号衬线体 */
.ocr-phase-num { font-size:var(--fs-3xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); line-height:var(--lh-none); margin-bottom:var(--sp-4); font-variant-numeric:tabular-nums; }
.ocr-phase-of { font-size:var(--fs-2xl); font-weight:var(--fw-normal); color:var(--text-tertiary); }

.ocr-phase-title { font-size:var(--fs-xl); font-weight:var(--fw-semi); color:var(--text-primary); margin-bottom:var(--sp-3); text-align:center }
.ocr-phase-sub { font-size:var(--fs-caption); color:var(--text-tertiary); text-align:center }

/* 动画点：金/绿双色区分阶段，呼吸感替代脉冲 */


/* UI 打磨：状态动画不用回弹缓动（过冲在 popIn keyframe 内已含），改 ease-out-expo */
.ocr-done-title { font-size:var(--fs-2xl); font-weight:var(--fw-semi); color:var(--text-primary); margin-bottom:var(--sp-2); animation:popIn 0.4s var(--ease-out-expo) }
.ocr-done-sub { font-size:var(--fs-caption); color:var(--text-tertiary); margin-bottom:var(--sp-5); text-align:center }
.ocr-fail-tip { color:var(--amber); font-size:var(--fs-tiny); margin-top:var(--sp-1) }
.ocr-summary-list { width:100%; max-height:300rpx; margin-bottom:var(--sp-6) }
.ocr-actions-row { width:100%; display:flex; gap:var(--sp-3) }
/* UI 审计 #②：accent 白字 2.24:1 不达标，改深色主文字色（7.62:1） */
.ocr-confirm-btn { flex:1; height:88rpx; background:var(--accent); color:var(--text-primary); font-size:var(--fs-lg); font-weight:var(--fw-semi); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:none }
.ocr-confirm-btn::after { border:none }
.ocr-confirm-btn.is-loading { background:var(--accent-dim); }
.ocr-confirm-btn[disabled] { opacity:0.7; }

/* OCR 结果：低置信度保单标注 — 统一为深琥珀文字（对比度≥4.5:1），背景由容器自持 */
.low-conf { color: var(--amber-deep); }

/* 尊重减少动效偏好 */
@media (prefers-reduced-motion: reduce) {
  .anim-fade-in,
  .thinking-dot,
  .thinking-dots,
  .refresh-icon,
  .sk-shimmer,
  .bubble,
  .ocr-card,
  .chat-panel,
  .sheet,
  .pressable {
    animation: none !important;
    transition: none !important;
  }
}
