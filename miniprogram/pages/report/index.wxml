<!-- 报告页 v1.3 -->
<view class="page page-view">
  <view class="loading" wx:if="{{loading}}">
    <view class="skeleton-wrap">
      <view class="sk-title-bar"><view class="sk-title sk-shimmer"></view><view class="sk-btn sk-shimmer"></view></view>
      <view class="sk-summary sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer" style="height:280rpx"></view>
      <view class="sk-block-card sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer" style="height:320rpx"></view>
      <view class="loading-text">{{loadingText}}</view>
    </view>
  </view>

  <!-- UI 审计 R-S1：加载失败错误态（原 loading=false && family=null 时页面全空白无出口） -->
  <view class="load-error" wx:if="{{!loading && !family && loadError}}">
    <text class="load-error-title">报告加载失败</text>
    <text class="load-error-sub">网络异常或客户档案不存在</text>
    <button class="load-error-btn pressable" bindtap="onRetryReport">重新加载</button>
    <button class="load-error-btn load-error-btn--ghost pressable" bindtap="onGoHome">返回首页</button>
  </view>

  <!-- 2026-09-06：主体为 scroll-view，页面级下拉被吞 → 改用 scroll-view 原生 refresher 承载下拉刷新 -->
  <!-- 2026-09-12 客户版预览条：明确当前是预览态，并提供一键回到编辑视角。
       修复（2026-09-12）：从 scroll-view 内移出为页面级固定条——它与组件内 .toc 都吸附
       top:0，而 z-index 30 > 20，导致吸顶目录被完全覆盖且点不到（V1.5 两个新功能互相抵消）。
       移出后常驻顶部不参与滚动，目录正常吸附在 scroll-view 顶部。 -->
  <view class="preview-bar" wx:if="{{!loading && family && isPreview}}">
    <text class="preview-bar-text">客户版预览 · 这是客户看到的样子</text>
    <text class="preview-bar-exit pressable" bindtap="onExitPreview">返回编辑视角</text>
  </view>

  <scroll-view class="content" scroll-y wx:if="{{!loading && family}}" refresher-enabled refresher-triggered="{{pullDownTriggered}}" refresher-default-style="black" bindrefresherrefresh="onScrollRefresh" scroll-top="{{scrollTop}}" scroll-with-animation bindscroll="onReportScroll">
    <view class="title-bar">
      <view class="report-title">
        <text class="title-name">{{family.name}}</text>
        <!-- 副标题行：标题与报告更新时间两端对齐（2026-09-12：familyTag 已移除，分析时间不占主 meta 位） -->
        <view class="title-subrow">
          <text class="title-sub">家庭保障检视报告</text>
          <!-- 2026-09-18 报告页审计：`dataAt` 早在 report-share.js L38 构造（注释自述"页头时效标识"）
               却从未被渲染 → 页头只有一个无标签的时间戳。此处接线给出语义（updated_at = 数据更新；
               AI 分析新鲜度由 deep 区的 analysisAt 承担，两个时间不再语义打架）。 -->
          <text class="title-meta" wx:if="{{reportMeta.dataAt}}">{{reportMeta.dataAt}}</text>
        </view>
        <!-- 时效标识（owner）：数据已更新但报告尚未刷新 -->
        <view class="title-stale" wx:if="{{staleTag}}">{{staleTag}}</view>
        <!-- 2026-09-18 报告页审计：定性模式常驻披露（tier=degraded → 本报告不含缺口金额/回本年限）。
             此前该状态只出现在生成前的 readiness 弹层里，弹层关闭即消失；报告内仅有"待澄清项"
             说"完善信息可深化分析"，属可选优化语气，用户无从得知当前报告**缺**了量化部分。 -->
        <view class="title-qual" wx:if="{{qualitativeMode}}">
          <text class="title-qual-text">本报告为定性分析：家庭年收入未填写，未做缺口金额、回本年限等量化测算</text>
          <text class="title-qual-act pressable" wx:if="{{!isShared}}" data-mode="financials" data-id="" bindtap="onClarifyFix" aria-label="补充家庭年收入，重新生成量化报告">去补全</text>
        </view>
        <!-- 2026-10-13 合规前置（报告结构 v2.0 评审第 4 条）：页头一行轻提示 + 页尾完整声明。
             动机：免责是"以条款为准"的可追溯锚点，只放末页等于"没翻到就没有"；前置一行不打断叙事。
             文案与页尾 DISCLAIMER_FALLBACK 同源（pages/report/index.js:22 静态常量，不依赖 AI 输出，
             故 AI 未生成/生成失败时依然成立）。owner 与客户版都显示 —— 合规声明不应分版本。 -->
        <view class="title-ai-note">AI 辅助生成 · 仅供参考 · 以保险公司条款为准</view>
      </view>
    </view>
    <!-- 标题区域与正文分隔线 -->
    <view class="title-divider"></view>
    <!-- ===== 阶段一报告主体：保单整理（2026-10-13 决策「当前报告降级成保单整理报告」）=====
         红线：只做归集/汇总/标注——不出建议、不加形容词、不确定就标出来（见 utils/checkup/organize.js）。
         数据与正文同源（_applyReportData 一处构建）→ 下拉刷新/客户版预览自动一致。 -->
    <block wx:if="{{hasPolicy && checkup}}">
      <view class="sum-card">
        <view class="sum-grid">
          <view class="sum-item"><view class="sum-label">保单张数</view><view class="sum-value">{{checkup.summary.policyCount}}</view></view>
          <view class="sum-item"><view class="sum-label">年缴保费合计</view><view class="sum-value">{{checkup.summary.annualPremiumText}}</view></view>
        </view>
        <view class="sum-note" wx:if="{{checkup.summary.premiumNote}}">{{checkup.summary.premiumNote}}</view>
        <view class="sum-wide">
          <view class="sum-label">保额合计</view>
          <view class="sum-value-lg">{{checkup.summary.totalSumAssuredText}}</view>
          <view class="sum-note" wx:if="{{checkup.summary.shortTermCount > 0}}">其中一年期 {{checkup.summary.shortTermCount}} 张 · {{checkup.summary.shortTermSumAssuredText}}（每年需续保）</view>
        </view>
        <view class="sum-wide">
          <view class="sum-label">已覆盖险种</view>
          <view class="tags">
            <view class="tag" wx:for="{{checkup.summary.categories}}" wx:key="*this">{{item}}</view>
            <view class="tag-empty" wx:if="{{checkup.summary.categories.length === 0}}">暂无</view>
          </view>
        </view>
        <view class="sum-note" wx:if="{{checkup.summary.memberNote}}">{{checkup.summary.memberNote}}</view>
      </view>

      <view class="sec-title">按成员整理</view>
      <view class="sum-card" wx:for="{{checkup.groups}}" wx:key="memberId" wx:for-item="g">
        <view class="mem-hd">
          <view class="mem-name">{{g.name}}</view>
          <view class="mem-role" wx:if="{{g.role}}">{{g.role}}</view>
          <view class="mem-src">{{g.source}}</view>
        </view>
        <view class="mem-meta">{{g.policyCount}} 张保单 · 保额 {{g.sumAssuredText}}</view>
        <view class="pol-empty" wx:if="{{g.policyCount === 0}}">这 1 位成员名下暂无保单记录</view>
        <view class="pol" wx:for="{{g.policies}}" wx:key="id" wx:for-item="p">
          <view class="pol-title"><text class="pol-name">{{p.productName}}</text><text class="pol-cat">{{p.category}}</text></view>
          <view class="pol-row"><text class="k">保额</text><text class="v">{{p.sumAssuredText}}</text></view>
          <view class="pol-row"><text class="k">{{p.premiumLabel}}</text><text class="v">{{p.annualPremiumText}}</text></view>
          <view class="pol-row"><text class="k">保障期间</text><text class="v">{{p.period}}</text></view>
          <view class="pol-row"><text class="k">生效日</text><text class="v">{{p.effectiveDate}}</text></view>
          <view class="pol-flags">
            <text class="flag flag-term" wx:if="{{p.shortTerm}}">一年期 · 每年需续保</text>
            <text class="flag flag-low" wx:if="{{p.lowConfidence}}">含待核对字段</text>
          </view>
        </view>
      </view>

      <block wx:if="{{checkup.unassigned.length > 0}}">
        <view class="sec-title">未归入成员（被保人不在成员名单）</view>
        <view class="sum-card">
          <view class="pol" wx:for="{{checkup.unassigned}}" wx:key="id" wx:for-item="p">
            <view class="pol-title"><text class="pol-name">{{p.productName}}</text><text class="pol-cat">{{p.category}}</text></view>
            <view class="pol-row"><text class="k">被保人</text><text class="v">{{p.insuredName}}</text></view>
            <view class="pol-row"><text class="k">保额</text><text class="v">{{p.sumAssuredText}}</text></view>
          </view>
        </view>
      </block>

      <block wx:if="{{checkup.pending.length > 0}}">
        <view class="sec-title">待完善（{{checkup.pending.length}} 项）</view>
        <view class="sum-card">
          <view class="pend" wx:for="{{checkup.pending}}" wx:key="index">
            <view class="pend-name">{{item.productName}}</view>
            <view class="pend-detail">{{item.detail}}</view>
          </view>
        </view>
      </block>
    </block>

    <!-- 原 AI 分析报告（保障摘要/覆盖检查/缺口成因/配置建议…）：结构保留、**默认收起**，
         一行可展开对照；内容一字未删 → 阶段一验完再决定是否删除（可回退）。 -->
    <view class="legacy-toggle pressable" wx:if="{{hasPolicy && checkup}}" bindtap="onToggleLegacyBody">
      <text class="legacy-toggle-text">{{showLegacyBody ? '收起保障分析（AI 解读）' : '展开保障分析（AI 解读）'}}</text>
      <text class="legacy-toggle-go">{{showLegacyBody ? '⌃' : '⌄'}}</text>
    </view>
    <block wx:if="{{!hasPolicy || showLegacyBody}}">
    <!-- 全链路审计 UC4：无保单空状态（引导上传，替代零值数字+红色告警） -->
    <view class="empty-report" wx:if="{{!hasPolicy}}">
      <view class="empty-report-icon">📄</view>
      <view class="empty-report-title">暂无保单</view>
      <!-- 2026-09-18 报告页审计 布局P2-1：客户版（isShared）下方无金色上传按钮（FAB 条件含 !isShared，
           wxml:303），原文案指向一个不存在的控件 → 按视角分文案 -->
      <view class="empty-report-desc">{{isShared ? '请联系您的保险顾问上传保单，生成后即可查看保障检视报告' : '点击下方金色按钮上传保单，小秘自动识别并生成保障检视报告'}}</view>
    </view>
    <!-- 保障摘要 + 保障覆盖检查融合卡：数据在上，覆盖检查在下（同卡分层） -->
    <view class="summary-card" wx:if="{{hasPolicy}}">
      <view class="summary-card-title">保障摘要</view>
      <!-- 2026-09-12：移除 AI summary（familyTag）渲染——其设计用途是列表页/卡片预览场景（prompts.js summary 章目标），
           而报告中它与下方 hero.conclusion 同卡相邻、要素重叠（均含结构+最致命风险+负债），造成同义重复。
           摘要卡的一句话总结改由 hero.conclusion 独家承担；summary 仍写库，供将来列表预览使用 -->
      <view class="summary-card-grid">
        <view class="num-cell">
          <text class="num-val">{{summaryCards.premium}}</text>
          <text class="num-unit">万</text>
          <text class="num-lbl">年保费</text>
        </view>
        <view class="num-cell">
          <text class="num-val">{{summaryCards.protection}}</text>
          <text class="num-unit">万</text>
          <text class="num-lbl">保障型保额</text>
        </view>
        <view class="num-cell">
          <text class="num-val">{{summaryCards.count}}</text>
          <text class="num-unit">人</text>
          <text class="num-lbl">保障人数</text>
        </view>
      </view>
      <!-- 2026-10-14 用户决策：不再展示单一"总保额"，改按保障类型统计。
           理由：医疗险 400 万报销年限额 + 重疾 30 万保险金额相加没有意义 ——
           前者是报销上限、后者是给付金额，混算会让客户把报销额度当成"能拿到手的钱"。
           主数字＝保障型保额（真正赔钱的那部分），明细按险种列出，储蓄型（年金/增额寿/终身寿）另计。 -->
      <view class="summary-note summary-cats" wx:if="{{summaryCards.byCat.length}}">
        <text class="cat-chip" wx:for="{{summaryCards.byCat}}" wx:key="cat">{{item.cat}} {{item.w}}万</text>
      </view>
      <view class="summary-note" wx:if="{{summaryCards.savings !== '0'}}">储蓄型（年金 / 增额寿 / 终身寿）合计 {{summaryCards.savings}} 万，与上述保障型保额分列</view>
      <!-- 未标注险种的保额单列：不并入任何一类（并入会朝某一方向高估），同时是数据质量信号 -->
      <view class="summary-note" wx:if="{{summaryCards.unknown !== '0'}}">{{summaryCards.unknown}} 万的保单未标注险种，未计入上述分类（补充险种后即自动归类）</view>
      <!-- 审计·顾问视角（2026-09-04）：一年期短险单列（时效提醒，与"按险种拆"是两件事：
           400 万医疗险即便单列出来，它的性质仍是"报销年限额 + 明年需续保"） -->
      <view class="summary-note" wx:if="{{summaryCards.short}}">其中一年期短险 {{summaryCards.short}} 万（每年需续保）</view>
      <!-- 审计 C1（2026-09-02）：AI 一句话结论（此前死值）置于摘要卡内、覆盖检查前 -->
      <!-- P1-C（2026-09-05）：AI 结论与规则覆盖检查同卡并存，标注来源防止客户把 AI 解读误当系统计算 -->
      <!-- 2026-09-12：客户版不显示来源角标——「AI 解读」是 owner 侧的审计需要（防误当系统计算），
           搬到客户版只会让客户读成"机器猜的"；「自动生成」事实由页尾免责声明覆盖，不构成隐瞒 -->
      <view class="hero-conclusion" wx:if="{{hero.conclusion}}"><text class="hero-conclusion-tag" wx:if="{{!isShared}}">AI 解读</text>{{hero.conclusion}}</view>
      <!-- 保障覆盖检查（结论先行：汇总在上、逐条论据在下、行动建议收尾） -->
      <view class="summary-check" wx:if="{{hero.alerts.length}}">
        <view class="hero-summary-lead">{{hero.summary}}</view>
        <view class="hero-alert {{item.ok ? 'is-ok' : (item.blocked ? 'is-unknown' : 'is-warn')}}" wx:for="{{hero.alerts}}" wx:key="name">
          <text class="hero-alert-dot"></text>
          <text class="hero-alert-text">{{item.name}} {{item.display}}</text>
        </view>
        <view class="hero-advice" wx:if="{{hero.topAdvice}}">{{hero.topAdvice}}</view>
      </view>
      <!-- 风险预警 TOP-N（2026-10-13 报告结构 v2.0 ① 家庭总检结论）
           排序口径（report/risk-alerts-builder）：等级 → gapPriority → 敞口金额降序 → 成员档案顺序，
           **不按险种、不引入主观权重**；每条都可展开看依据（basis），给不出依据的结论不出现。
           达标项（绿）同样展示，建立信任、不只制造焦虑。 -->
      <view class="risk-list" wx:if="{{risks.items.length}}">
        <view class="risk-item risk-{{item.level}}" wx:for="{{risks.items}}" wx:key="key" catchtap="onRiskTap" data-idx="{{index}}">
          <view class="risk-head">
            <text class="risk-dot"></text>
            <text class="risk-level">{{item.levelLabel}}</text>
            <text class="risk-title">{{item.title}}</text>
          </view>
          <text class="risk-detail">{{item.detail}}</text>
          <!-- 依据：默认收起（避免首屏噪音），点击条目展开 —— 结论可追溯是"错误不对称"的落地方式 -->
          <text class="risk-basis" wx:if="{{item.expanded && item.basis}}">依据：{{item.basis}}</text>
        </view>
        <view class="risk-more" wx:if="{{risks.more}}">另有 {{risks.more}} 项未展开{{risks.moreRed ? '（含高危 ' + risks.moreRed + ' 项）' : ''}}，共 {{risks.total}} 项</view>
      </view>
    </view>
    <!-- 深度分析（可选项 2026-09-02）：未生成=结论下生成入口（owner）；已生成=折叠洞察摘要（owner）/完整展开（客户版叙事主内容） -->
    <!-- 审计 C4（2026-09-02）：hints 死区块已删除（report 契约无 hints 键，恒空） -->
    <view class="deep-entry" wx:if="{{hasPolicy && !deep && !isShared}}">
      <view class="deep-head">
        <text class="deep-title">保障分析</text>
        <text class="deep-badge">AI 解读</text>
        <text class="deep-tone pressable" bindtap="onToggleTone" aria-label="切换分析语气">{{reportTone === 'warm' ? '语气：共情' : '语气：直白'}}</text>
      </view>
      <text class="deep-entry-desc">系统会在信息更新后自动生成分析；也可点击立即生成。内容包括保障点评、缺口成因、配置建议与行动清单。</text>
      <button class="deep-entry-btn pressable" bindtap="onDeepAnalysis" aria-label="立即生成保障分析">立即生成分析</button>
    </view>
    <view class="deep-analysis" wx:if="{{hasPolicy && deep}}">
      <view class="deep-head">
        <text class="deep-title">保障分析</text>
        <!-- 2026-09-12：客户版不显示「AI 解读」角标（同 hero 结论标签，理由见上报文摘要卡） -->
        <text class="deep-badge" wx:if="{{!isShared}}">AI 解读</text>
        <text class="deep-tone pressable" wx:if="{{!isShared}}" bindtap="onToggleTone" aria-label="切换分析语气">{{reportTone === 'warm' ? '语气：共情' : '语气：直白'}}</text>
      </view>
      <!-- 保障分析生成时间（2026-09-06：主 meta 位为"报告更新"，此处作分析新鲜度说明） -->
      <text class="deep-meta" wx:if="{{reportMeta.analysisAt}}">{{reportMeta.analysisAt}}</text>
      <!-- 保障分析恒展开完整解读（2026-09-06：移除折叠/收起/更新，报告内容默认全部展开） -->
        <!-- 2026-09-18 报告页审计：insights 已在视图层包成 {key,text}（report-builder.buildDeepAnalysis），
             原 wx:key="*this" 遇两条相同洞察文本会产生重复 key -->
        <view class="deep-insights" wx:if="{{deep.insights.length}}">
          <view class="deep-insight" wx:for="{{deep.insights}}" wx:key="key">
            <text class="deep-insight-text">{{item.text}}</text>
          </view>
        </view>
        <!-- 审计 C2：AI 家庭画像（deep 首段，补齐分析叙事链） -->
        <view class="deep-sec" wx:if="{{deep.portrait}}">
          <view class="deep-sec-title">家庭画像</view>
          <markdown-render content="{{deep.portrait}}" variant="report" />
        </view>
        <view class="deep-sec" wx:if="{{deep.review}}">
          <view class="deep-sec-title">现有保障点评</view>
          <markdown-render content="{{deep.review}}" variant="report" />
        </view>
        <view class="deep-sec" wx:if="{{deep.analysis}}">
          <view class="deep-sec-title">保障缺口分析</view>
          <markdown-render content="{{deep.analysis}}" variant="report" />
        </view>
        <view class="deep-sec" wx:if="{{deep.plan}}">
          <view class="deep-sec-title">配置建议</view>
          <markdown-render content="{{deep.plan}}" variant="report" />
        </view>
        <view class="deep-sec" wx:if="{{deep.suggestions}}">
          <view class="deep-sec-title">行动清单</view>
          <markdown-render content="{{deep.suggestions}}" variant="report" />
        </view>
        <!-- 活报告模型（2026-09）：待澄清项（owner 展示；补全后随下一轮分析消失） -->
        <view class="deep-clarify" wx:if="{{!isShared && clarifications.length}}">
          <view class="deep-clarify-title">完善信息可深化分析</view>
          <view class="deep-clarify-item" wx:for="{{clarifications}}" wx:key="field" wx:for-item="cl">
            <text class="deep-clarify-label">{{cl.label}}</text>
            <text class="deep-clarify-act pressable" data-mode="{{cl.fix.mode}}" data-id="{{cl.fix.id}}" bindtap="onClarifyFix">去补全</text>
          </view>
        </view>
        <!-- 待关联现价表（2026-09-11）：自动匹配（产品名模糊+被保人）未中的现价表此前无任何补救入口，
             报告只读 matched:true → 数据在库但从不展示。此处提供人工关联闭环。 -->
        <view class="deep-clarify" wx:if="{{!isShared && unmatchedCashValues.length}}">
          <view class="deep-clarify-title">有 {{unmatchedCashValues.length}} 份现价表待关联保单</view>
          <view class="deep-clarify-item" wx:for="{{unmatchedCashValues}}" wx:key="_id" wx:for-item="cv" wx:for-index="ci">
            <text class="deep-clarify-label">{{cv.product_name || '现价表'}}{{cv.insured_name ? '（' + cv.insured_name + '）' : ''}}</text>
            <text class="deep-clarify-act pressable" data-idx="{{ci}}" bindtap="onLinkCashValue">去关联</text>
          </view>
        </view>
        <!-- 审计 C3（2026-09-02）：删除 deep 区 AI 免责（与页面底部静态免责双层重复，静态为合规唯一源） -->
    </view>
    <!-- 2026-09-14 客户档案：按「信息稳定性」分四档（关键属性 / 需要留意 / 待核实 / 记录时间线）。
         owner 与客户版都渲染，内容由 utils/facts-view.js 按 view 规则过滤（客户版不给线索与时间线）。
         默认折叠——首屏只保留结论与缺口，与 V1.5 的明细层折叠口径一致 -->
    <view class="facts-card" wx:if="{{factsView}}">
      <view class="facts-head pressable" bindtap="onToggleFacts">
        <text class="facts-title">客户档案</text>
        <text class="facts-count">{{factsView.total}} 条</text>
        <text class="facts-arrow">{{factsOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
      <view wx:if="{{factsOpen}}" class="facts-list">
        <block wx:if="{{factsView.members.length}}">
          <view class="facts-sec">关键属性</view>
          <view class="facts-member" wx:for="{{factsView.members}}" wx:key="key">
            <text class="facts-member-name">{{item.name}}</text>
            <text class="facts-member-text">{{item.text}}</text>
          </view>
        </block>
        <block wx:if="{{factsView.constraints.length}}">
          <view class="facts-sec">需要留意</view>
          <view class="facts-warn" wx:for="{{factsView.constraints}}" wx:key="key">
            <text class="facts-mark">{{'!'}}</text>
            <text class="facts-warn-text">{{item.text}}</text>
          </view>
        </block>
        <block wx:if="{{factsView.leads.length}}">
          <view class="facts-sec">待核实</view>
          <view class="facts-lead" wx:for="{{factsView.leads}}" wx:key="key">
            <text class="facts-mark facts-mark--muted">{{'?'}}</text>
            <text class="facts-lead-text">{{item.text}}</text>
            <text class="facts-lead-tag">未确认</text>
          </view>
        </block>
        <block wx:if="{{factsView.timeline.length}}">
          <view class="facts-sec">记录时间线</view>
          <view class="facts-item" wx:for="{{factsView.timeline}}" wx:key="key">
            <text class="facts-time">{{item.timeText}}</text>
            <text class="facts-text">{{item.text}}</text>
          </view>
          <view class="facts-more" wx:if="{{factsView.truncated}}">仅显示最近 {{factsView.timeline.length}} 条</view>
        </block>
      </view>
    </view>
    <report-markdown wx:if="{{hasPolicy}}" chapters="{{chapters}}" readonly="{{isShared}}" bind:policytap="onPolicyTap" bind:statuschange="onStatusChange" bind:chapteredit="onChapterEdit" bind:riskcheck="onRiskCheck" bind:tocnav="onTocNav" />
    <!-- 2026-09-12 客户版预览入口（owner，有保单时才有意义）：不占 footer 主按钮位 -->
    <view class="preview-entry" wx:if="{{!isShared && hasPolicy}}">
      <text class="preview-entry-btn pressable" bindtap="onPreviewShared" aria-label="预览客户版效果">预览客户版效果</text>
      <!-- 2026-09-12 MVP 验证：成交标记（手动登记，是"报告有没有帮他把单谈下来"的唯一真值来源） -->
      <text class="preview-entry-btn {{dealStatus === 'won' ? 'is-on' : ''}} pressable" bindtap="onToggleDeal" aria-label="标记成交">{{dealStatus === 'won' ? '已成交 ✓' : '标记已成交'}}</text>
    </view>
    <!-- 2026-09-12 MVP 验证：反馈入口——系统里唯一的主观信号；owner 与客户都问，口径按 view 区分 -->
    <view class="feedback-row" wx:if="{{hasPolicy && !feedbackGiven}}">
      <text class="feedback-q">{{isShared ? '这份报告看得清楚吗？' : '这份报告对你有帮助吗？'}}</text>
      <view class="feedback-btns">
        <text class="feedback-btn pressable" bindtap="onFeedbackYes">有帮助</text>
        <text class="feedback-btn pressable" bindtap="onFeedbackNo">没帮助</text>
      </view>
    </view>
    <!-- 免责声明：报告正文最末（附录之后、转发按钮之前）静态合规小字 -->
    <view class="report-disclaimer" wx:if="{{disclaimer}}">{{disclaimer}}</view>
    <!-- 2026-09-19（流程审计 UX4）：分享链接有效期可见（owner）。此前 owner 端完全看不到到期时间，
         客户过期后只看到"链接已失效"，代理人无法提前重发。复用免责声明的小字样式（同属页末小字，
         且该类已在校验过的宽屏 720px 名单内），避免为此新增 WXSS。 -->
    <view class="report-disclaimer" wx:if="{{!isShared && shareExpireHint}}">{{shareExpireHint}}</view>
    <!-- 2026-09-18 报告页审计：仅客户版补底部安全区（owner 模式下方 FAB 条已承担，见 wxss 说明） -->
    <view class="report-footer {{isShared ? 'report-footer--shared' : ''}}">
      <block wx:if="{{!isShared}}">
        <button class="footer-share pressable" open-type="share" aria-label="转发客户">转发报告给客户</button>
        <button class="footer-export pressable" bindtap="onExportPdf" aria-label="导出 PDF">导出 PDF</button>
      </block>
      <block wx:if="{{isShared}}">
        <!-- 活报告模型（2026-09）挂载点③：沟通桥正向引导（不新增客户自助录入） -->
        <!-- 2026-09-12：改真实表述。原句"重新生成"暗示需客户催办；且客户版无自助录入入口
             （见上注释），不能写成"随你提供的信息更新"。实际行为：顾问侧更新后客户重开即见新内容 → "自动刷新"成立 -->
        <view class="share-guide">报告会随家庭信息更新自动刷新；如需补充或更正信息，可联系您的服务顾问</view>
        <view class="share-watermark">由保小秘生成 · 数据仅供参考</view>
      </block>
    </view>
    </block>
  </scroll-view>

  <chat-panel id="chatpanel" wx:if="{{!loading && !loadError && !isShared}}" familyId="{{familyId}}" presetHints="{{presetHints}}" bindreportRefresh="onChatReportRefresh" bindcollapse="onChatCollapse" bindbusy="onChatBusy" />

  <!-- UI 审计 状态 S3：AI 深度分析中（可取消） -->
  <view class="analysis-mask" wx:if="{{analysisShow}}" catchtouchmove="onNoop">
    <view class="analysis-card">
      <view class="analysis-spinner"></view>
      <text class="analysis-title">AI 深度分析中</text>
      <text class="analysis-sec">已进行 {{analysisSec}}s，正在梳理保障缺口…</text>
      <button class="analysis-cancel pressable" bindtap="onAnalysisCancel">取消分析</button>
    </view>
  </view>

  <!-- 画像确认（2026-08-30）：深度分析前强制核对家庭信息——信息不完整或不真实将严重影响报告质量 -->
  <view class="readiness-mask" wx:if="{{readinessShow}}" catchtouchmove="onNoop" aria-label="核对家庭信息">
    <view class="readiness-card">
      <text class="readiness-title">核对家庭信息</text>
      <view class="readiness-warn">
        <text class="readiness-warn-text">请核对以下家庭信息。信息不完整或不真实将严重影响报告质量，请确认属实后再开始分析。</text>
      </view>
      <!-- V1.5 隐私说明（2026-09-12）：财务数据属敏感信息，明确用途与隔离方式，降低录入抵触 -->
      <view class="readiness-privacy">收入、负债等家庭财务信息仅用于生成你家庭的报告，按微信账号隔离存储，不会对外共享或用于其他用途。</view>
      <scroll-view class="readiness-body" scroll-y>
        <!-- 成员摘要 -->
        <view class="rd-dim">
          <view class="rd-dim-head">
            <text class="rd-dim-status rd-{{readiness.dimensions[0].status}}">{{readiness.dimensions[0].status === 'ok' ? '✓' : (readiness.dimensions[0].status === 'warn' ? '!' : '×')}}</text>
            <text class="rd-dim-title">家庭成员（{{readiness.portrait.members.length}} 人）</text>
          </view>
          <view class="rd-member" wx:for="{{readiness.portrait.members}}" wx:key="key" wx:for-item="m">
            <text class="rd-member-name">{{m.name}} · {{m.role}} · {{m.ageText}}</text>
            <text class="rd-member-sub">健康：{{m.health}} · 收入：{{m.income}}</text>
          </view>
          <view wx:if="{{readiness.portrait.members.length === 0}}" class="rd-empty">尚未添加家庭成员</view>
        </view>
        <!-- 财务摘要 -->
        <view class="rd-dim">
          <view class="rd-dim-head">
            <text class="rd-dim-status rd-{{readiness.dimensions[1].status}}">{{readiness.dimensions[1].status === 'ok' ? '✓' : (readiness.dimensions[1].status === 'warn' ? '!' : '×')}}</text>
            <text class="rd-dim-title">家庭财务</text>
          </view>
          <view class="rd-fin-row"><text class="rd-fin-label">家庭年收入</text><text class="rd-fin-val {{readiness.portrait.income === '未填写' ? 'rd-fin--missing' : ''}}">{{readiness.portrait.income}}</text></view>
          <view class="rd-fin-row"><text class="rd-fin-label">总负债</text><text class="rd-fin-val {{readiness.portrait.debt === '未填写' ? 'rd-fin--missing' : ''}}">{{readiness.portrait.debt}}</text></view>
        </view>
        <!-- 保障摘要 -->
        <view class="rd-dim">
          <view class="rd-dim-head">
            <text class="rd-dim-status rd-{{readiness.dimensions[2].status}}">{{readiness.dimensions[2].status === 'ok' ? '✓' : (readiness.dimensions[2].status === 'warn' ? '!' : '×')}}</text>
            <text class="rd-dim-title">已有保障（{{readiness.portrait.policyCount}} 份，有效 {{readiness.portrait.activePolicyCount}} 份）</text>
          </view>
          <view wx:if="{{readiness.portrait.policyCount === 0}}" class="rd-empty">尚未添加保单</view>
        </view>
        <!-- 缺口提醒（待完善项 + 去补全） -->
        <view wx:if="{{readiness.warnings.length > 0 || readiness.blockers.length > 0}}" class="rd-gap">
          <text class="rd-gap-title">待完善（{{readiness.blockers.length}} 必填 / {{readiness.warnings.length}} 建议）</text>
          <!-- 2026-09-18 布局审计：原外层 wrapper 与内层同用 .rd-item（= display:flex 行向）→ 内层各项
               被并排挤在同一行，与同 Sheet 的 .rd-member / .rd-fin-row（纵向逐行）不一致；且外层除"包一层"
               外无任何作用（既无标题也无计数）。改 <block> 拆开：① 消除同名类嵌套 ② 分离 wx:for 与 wx:if
               ③ <block> 不产生 DOM，行样式仍由内层 .rd-item 承担，故零结构副作用。 -->
          <block wx:for="{{readiness.dimensions}}" wx:key="key" wx:for-item="dim">
            <block wx:if="{{dim.status !== 'ok'}}">
              <view class="rd-item" wx:for="{{dim.items}}" wx:key="label" wx:for-item="it">
                <text class="rd-item-label">{{it.label}}</text>
                <button class="rd-fix pressable" bindtap="onReadinessFix" data-mode="{{it.fix.mode}}" data-id="{{it.fix.id}}" aria-label="去补全{{it.label}}">去补全</button>
              </view>
            </block>
          </block>
        </view>
      </scroll-view>
      <view class="readiness-actions">
        <button class="rd-btn rd-btn--primary pressable" bindtap="onReadinessConfirm" aria-label="信息属实，开始分析">信息属实，开始分析</button>
        <button class="rd-btn rd-btn--ghost pressable" bindtap="onReadinessClose" aria-label="取消">取消</button>
      </view>
    </view>
  </view>
  <!-- FAB 栏提到页面层，确保 position:fixed 相对视口生效 -->
  <view class="fab-wrap" wx:if="{{!loading && !isShared}}">
    <view class="fab-bar">
      <view class="fab-inner" catchtap="onFabTap">
        <view class="fab-upload pressable" catchtap="onUploadFab" aria-label="上传保单"><image class="fab-upload-icon" src="/images/upload.svg" mode="aspectFit" /></view>
        <view class="fab-input">
          <input class="fab-real-input" value="{{fabText}}" placeholder="问小秘..." bindinput="onFabInput" bindconfirm="onFabSend" confirm-type="send" bindfocus="onFabFocus" aria-label="输入消息" />
        </view>
        <view class="fab-send pressable {{(!fabText || chatBusy) ? 'is-disabled' : ''}}" bindtap="onFabSend" aria-label="发送消息"><text class="fab-arrow">→</text></view>
      </view>
    </view>
  </view>




  <!-- 成员管理 Sheet（家庭结构标题 [编辑] 进入） -->
  <view class="member-manage-overlay" wx:if="{{showMemberManage}}" catchtap="closeMemberManage" catchtouchmove="onNoop">
    <view class="member-manage" catchtap="onSheetNoop">
      <view class="mm-grabber"></view>
      <!-- UI 审计 #⑤：成员管理 Sheet 补显式关闭按钮（原仅遮罩 catchtap，可发现性弱） -->
      <view class="mm-close pressable" bindtap="closeMemberManage" aria-label="关闭"><image class="mm-close-icon" src="/images/close.svg" mode="aspectFit" /></view>
      <view class="mm-title">家庭成员</view>
      <scroll-view class="mm-list" scroll-y>
        <view class="mm-item pressable" wx:for="{{memberManageList}}" wx:key="member_id" data-mid="{{item.member_id}}" catchtap="onMemberManageEdit">
          <text class="mm-name">{{item.name}}</text>
          <text class="mm-role">{{item.display}}</text>
          <text class="mm-edit">编辑</text>
          <!-- 家庭结构可编辑性：删除成员（catchtap 阻止冒泡到行编辑；软删走 _syncMembers diff） -->
          <view class="mm-del pressable" catchtap="onMemberManageDelete" data-mid="{{item.member_id}}" aria-label="删除成员">删除</view>
        </view>
      </scroll-view>
      <view class="mm-divider"></view>
      <button class="mm-add pressable" bindtap="onMemberManageAdd" aria-label="添加成员">+ 添加成员</button>
    </view>
  </view>

  <!-- 保单明细 sheet：复用统一 edit-sheet（view 态只读 → [编辑] 切编辑态 → [保存]；与 OCR 结果 sheet 完全复用） -->
  <edit-sheet visible="{{showEdit}}" title="{{editTitle}}" fields="{{editFields}}" mode="{{sheetMode}}" saving="{{editSaving}}" bindclose="onCloseEdit" bindsave="onSaveEdit" />
</view>
  <!-- OCR 全流程组件（跳过家庭匹配，默认当前家庭）—— ⚠️ 同上：必须在 .page 之外（.page-view 的
       常驻 transform 会成为 position:fixed 的包含块，破坏 .ocr-mask 全屏遮罩），勿移入。 -->
  <ocr-flow id="ocrFlow" skipMatch familyId="{{familyId}}" bind:saved="onOcrFlowSaved" />
