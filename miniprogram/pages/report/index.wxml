<!-- 报告页 v1.3 -->
<view class="page page-view">
  <view class="loading" wx:if="{{loading}}">
    <view class="skeleton-wrap">
      <view class="sk-title-bar"><view class="sk-title sk-shimmer"></view><view class="sk-btn sk-shimmer"></view></view>
      <view class="sk-summary sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer" style="height:280rpx"></view>
      <view class="sk-block-card sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer" style="height:320rpx"></view>
      <view class="loading-text">{{loadingText}}</view>
    </view>
  </view>

  <scroll-view class="content" scroll-y scroll-into-view="{{focusAnchor}}" wx:if="{{!loading && family}}">
    <view class="update-toast {{reportUpdated && !refreshing ? 'show' : ''}}" catchtap="onRefreshReport">数据有更新，点击更新报告</view>
    <view class="title-bar">
      <view class="report-title">
        <text class="title-name">{{family.name}}</text>
        <text class="title-sub">家庭保障检视报告</text>
      </view>
    </view>
    <!-- 封面元数据：日期 / 编号 / 印章 -->
    <view class="report-meta" wx:if="{{reportMeta.no}}">
      <text class="report-meta-text">{{reportMeta.date}}</text>
      <view class="report-meta-line"></view>
      <text class="report-meta-text">No.{{reportMeta.no}}</text>
      <view class="report-seal">保小秘</view>
    </view>
    <view class="report-divider" wx:if="{{reportMeta.no}}"></view>
    <!-- 🟡 Hero 结论先行：保障覆盖检查 + 摘要数字卡 -->
    <view class="hero anim-fade-up" wx:if="{{hero.alerts.length}}">
      <view class="hero-title">保障覆盖检查</view>
      <view class="hero-alert {{item.ok ? 'is-ok' : 'is-warn'}}" wx:for="{{hero.alerts}}" wx:key="name">
        <text class="hero-alert-icon">{{item.ok ? '✅' : '⚠️'}}</text>
        <text class="hero-alert-text">{{item.name}} {{item.display}}</text>
      </view>
      <view class="hero-summary-line">{{hero.summary}}</view>
      <view class="hero-advice" wx:if="{{hero.topAdvice}}">💡 {{hero.topAdvice}}</view>
    </view>
    <view class="summary-cards anim-fade-up">
      <view class="sc-card">
        <text class="sc-val">{{summaryCards.premium}}</text>
        <text class="sc-unit">万</text>
        <text class="sc-lbl">总保费</text>
      </view>
      <view class="sc-card">
        <text class="sc-val">{{summaryCards.coverage}}</text>
        <text class="sc-unit">万</text>
        <text class="sc-lbl">总保额</text>
      </view>
      <view class="sc-card">
        <text class="sc-val">{{summaryCards.count}}</text>
        <text class="sc-unit">份</text>
        <text class="sc-lbl">保单数</text>
      </view>
    </view>
    <view class="hints" wx:if="{{hints.length}}">
      <view class="hint-chip pressable" wx:for="{{hints}}" wx:key="index" catchtap="onHintTap" data-q="{{item.q}}">{{item.text}}</view>
    </view>
    <report-markdown chapters="{{chapters}}" bind:policytap="onPolicyTap" />
    <view class="report-footer">
      <button class="footer-share pressable" open-type="share" aria-label="转发客户">转发报告给客户</button>
    </view>
    <view class="content-pad"></view>
  </scroll-view>

  <chat-panel id="chatpanel" wx:if="{{!loading}}" familyId="{{familyId}}" bindreportRefresh="onChatReportRefresh" />
  <!-- FAB 栏提到页面层，确保 position:fixed 相对视口生效 -->
  <view class="fab-wrap" wx:if="{{!loading}}">
    <view class="fab-bar">
      <view class="fab-inner" catchtap="onFabTap">
        <view class="fab-upload pressable" catchtap="onUploadFab" aria-label="上传保单"><text class="fab-plus">+</text><text class="fab-upload-label">保单</text></view>
        <view class="fab-input {{!fabCollapsed ? 'fab-input-active' : ''}}">
          <input class="fab-real-input" value="{{fabText}}" placeholder="问小秘..." bindinput="onFabInput" bindconfirm="onFabSend" confirm-type="send" bindfocus="onFabFocus" aria-label="输入消息" />
        </view>
        <view class="fab-send pressable {{(!fabText || false) ? 'is-disabled' : ''}}" bindtap="onFabSend" aria-label="发送消息"><text class="fab-arrow">→</text></view>
      </view>
    </view>
  </view>




  <!-- 成员管理 Sheet（家庭结构标题 [编辑] 进入） -->
  <view class="member-manage-overlay" wx:if="{{showMemberManage}}" catchtap="closeMemberManage">
    <view class="member-manage" catchtap="onSheetNoop">
      <view class="mm-grabber"></view>
      <view class="mm-title">家庭成员</view>
      <view class="mm-list">
        <view class="mm-item pressable" wx:for="{{memberManageList}}" wx:key="member_id" data-mid="{{item.member_id}}" catchtap="onMemberManageEdit">
          <text class="mm-name">{{item.name}}</text>
          <text class="mm-role">{{item.display}}</text>
          <text class="mm-edit">编辑</text>
        </view>
      </view>
      <view class="mm-divider"></view>
      <button class="mm-add pressable" bindtap="onMemberManageAdd" aria-label="添加成员">+ 添加成员</button>
    </view>
  </view>

  <!-- 保单明细只读 Sheet（点击附录卡片弹出，底部编辑入口） -->
  <view class="policy-sheet-overlay" wx:if="{{showPolicySheet}}" catchtap="onPolicySheetClose">
    <view class="policy-sheet" catchtap="onSheetNoop">
      <view class="ps-grabber"></view>
      <view class="ps-title">{{currentPolicy.product_name}} · {{policyCat}}</view>
      <view class="ps-body">
        <view class="ps-row" wx:for="{{policyRows}}" wx:key="label">
          <text class="ps-row-lbl">{{item.label}}</text>
          <text class="ps-row-val">{{item.value}}</text>
        </view>
      </view>
      <view class="ps-divider"></view>
      <button class="ps-edit-btn pressable" bindtap="onPolicySheetEdit" aria-label="编辑保单">编辑</button>
    </view>
  </view>

  <edit-sheet visible="{{showEdit}}" title="{{editTitle}}" fields="{{editFields}}" saving="{{editSaving}}" bindclose="onCloseEdit" bindsave="onSaveEdit" />
</view>
  <!-- OCR 全流程组件（跳过家庭匹配，默认当前家庭） -->
  <ocr-flow id="ocrFlow" skipMatch familyId="{{familyId}}" bind:saved="onOcrFlowSaved" />
