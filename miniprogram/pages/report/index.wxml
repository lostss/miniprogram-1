<!-- 报告页 v1.3 -->
<view class="page page-view">
  <view class="loading" wx:if="{{loading}}">
    <view class="skeleton-wrap">
      <view class="sk-title-bar"><view class="sk-title sk-shimmer"></view><view class="sk-btn sk-shimmer"></view></view>
      <view class="sk-summary sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer" style="height:280rpx"></view>
      <view class="sk-block-card sk-shimmer"></view>
      <view class="sk-block-card sk-shimmer" style="height:320rpx"></view>
      <view class="loading-text">{{loadingText}}</view>
    </view>
  </view>

  <!-- UI 审计 R-S1：加载失败错误态（原 loading=false && family=null 时页面全空白无出口） -->
  <view class="load-error" wx:if="{{!loading && !family && loadError}}">
    <text class="load-error-title">报告加载失败</text>
    <text class="load-error-sub">网络异常或客户档案不存在</text>
    <button class="load-error-btn pressable" bindtap="onRetryReport">重新加载</button>
    <button class="load-error-btn load-error-btn--ghost pressable" bindtap="onGoHome">返回首页</button>
  </view>

  <scroll-view class="content" scroll-y wx:if="{{!loading && family}}">
    <view class="title-bar">
      <view class="report-title">
        <text class="title-name">{{family.name}}</text>
        <!-- 副标题行：标题与生成时间并排两端分散对齐 -->
        <view class="title-subrow">
          <text class="title-sub">家庭保障检视报告</text>
          <text class="title-meta" wx:if="{{reportMeta.dateTime}}">{{reportMeta.dateTime}}</text>
        </view>
      </view>
    </view>
    <!-- 标题区域与正文分隔线 -->
    <view class="title-divider"></view>
    <!-- 全链路审计 UC4：无保单空状态（引导上传，替代零值数字+红色告警） -->
    <view class="empty-report" wx:if="{{!hasPolicy}}">
      <view class="empty-report-icon">📄</view>
      <view class="empty-report-title">暂无保单</view>
      <view class="empty-report-desc">点击下方金色按钮上传保单，小秘自动识别并生成保障检视报告</view>
    </view>
    <!-- 保障摘要 + 保障覆盖检查融合卡：数据在上，覆盖检查在下（同卡分层） -->
    <view class="summary-card" wx:if="{{hasPolicy}}">
      <view class="summary-card-title">保障摘要</view>
      <view class="summary-card-grid">
        <view class="num-cell">
          <text class="num-val">{{summaryCards.premium}}</text>
          <text class="num-unit">万</text>
          <text class="num-lbl">年保费</text>
        </view>
        <view class="num-cell">
          <text class="num-val">{{summaryCards.coverage}}</text>
          <text class="num-unit">万</text>
          <text class="num-lbl">总保额</text>
        </view>
        <view class="num-cell">
          <text class="num-val">{{summaryCards.count}}</text>
          <text class="num-unit">人</text>
          <text class="num-lbl">保障人数</text>
        </view>
      </view>
      <!-- 保障覆盖检查（结论先行：汇总在上、逐条论据在下、行动建议收尾） -->
      <view class="summary-check" wx:if="{{hero.alerts.length}}">
        <view class="hero-summary-lead">{{hero.summary}}</view>
        <view class="hero-alert {{item.ok ? 'is-ok' : 'is-warn'}}" wx:for="{{hero.alerts}}" wx:key="name">
          <text class="hero-alert-icon">{{item.ok ? '✅' : '⚠️'}}</text>
          <text class="hero-alert-text">{{item.name}} {{item.display}}</text>
        </view>
        <view class="hero-advice" wx:if="{{hero.topAdvice}}">💡 {{hero.topAdvice}}</view>
      </view>
    </view>
    <view class="hints" wx:if="{{hasPolicy && hints.length}}">
      <view class="hint-chip pressable" wx:for="{{hints}}" wx:key="index" catchtap="onHintTap" data-q="{{item.q}}" aria-label="问小秘：{{item.text}}">{{item.text}}</view>
    </view>
    <report-markdown wx:if="{{hasPolicy}}" chapters="{{chapters}}" readonly="{{isShared}}" bind:policytap="onPolicyTap" bind:statuschange="onStatusChange" bind:chapteredit="onChapterEdit" bind:riskcheck="onRiskCheck" />
    <!-- 免责声明：报告正文最末（附录之后、转发按钮之前）静态合规小字 -->
    <view class="report-disclaimer" wx:if="{{disclaimer}}">{{disclaimer}}</view>
    <view class="report-footer">
      <button wx:if="{{!isShared}}" class="footer-share pressable" open-type="share" aria-label="转发客户">转发报告给客户</button>
      <button wx:if="{{!isShared}}" class="footer-analyze pressable" bindtap="onDeepAnalysis" aria-label="深度分析">深度分析</button>
      <view wx:if="{{isShared}}" class="share-watermark">由保小秘生成 · 数据仅供参考</view>
    </view>
  </scroll-view>

  <chat-panel id="chatpanel" wx:if="{{!loading && !isShared}}" familyId="{{familyId}}" bindreportRefresh="onChatReportRefresh" bindcollapse="onChatCollapse" bindbusy="onChatBusy" />

  <!-- UI 审计 状态 S3：AI 深度分析中（可取消） -->
  <view class="analysis-mask" wx:if="{{analysisShow}}" catchtouchmove="onNoop">
    <view class="analysis-card">
      <view class="analysis-spinner"></view>
      <text class="analysis-title">AI 深度分析中</text>
      <text class="analysis-sec">已进行 {{analysisSec}}s，正在梳理保障缺口…</text>
      <button class="analysis-cancel pressable" bindtap="onAnalysisCancel">取消分析</button>
    </view>
  </view>
  <!-- FAB 栏提到页面层，确保 position:fixed 相对视口生效 -->
  <view class="fab-wrap" wx:if="{{!loading && !isShared}}">
    <view class="fab-bar">
      <view class="fab-inner" catchtap="onFabTap">
        <view class="fab-upload pressable" catchtap="onUploadFab" aria-label="上传保单"><image class="fab-upload-icon" src="/images/upload.svg" mode="aspectFit" /></view>
        <view class="fab-input">
          <input class="fab-real-input" value="{{fabText}}" placeholder="问小秘..." bindinput="onFabInput" bindconfirm="onFabSend" confirm-type="send" bindfocus="onFabFocus" aria-label="输入消息" />
        </view>
        <view class="fab-send pressable {{(!fabText || chatBusy) ? 'is-disabled' : ''}}" bindtap="onFabSend" aria-label="发送消息"><text class="fab-arrow">→</text></view>
      </view>
    </view>
  </view>




  <!-- 成员管理 Sheet（家庭结构标题 [编辑] 进入） -->
  <view class="member-manage-overlay" wx:if="{{showMemberManage}}" catchtap="closeMemberManage" catchtouchmove="onNoop">
    <view class="member-manage" catchtap="onSheetNoop">
      <view class="mm-grabber"></view>
      <!-- UI 审计 #⑤：成员管理 Sheet 补显式关闭按钮（原仅遮罩 catchtap，可发现性弱） -->
      <view class="mm-close pressable" bindtap="closeMemberManage" aria-label="关闭"><image class="mm-close-icon" src="/images/close.svg" mode="aspectFit" /></view>
      <view class="mm-title">家庭成员</view>
      <scroll-view class="mm-list" scroll-y>
        <view class="mm-item pressable" wx:for="{{memberManageList}}" wx:key="member_id" data-mid="{{item.member_id}}" catchtap="onMemberManageEdit">
          <text class="mm-name">{{item.name}}</text>
          <text class="mm-role">{{item.display}}</text>
          <text class="mm-edit">编辑</text>
          <!-- 家庭结构可编辑性：删除成员（catchtap 阻止冒泡到行编辑；软删走 _syncMembers diff） -->
          <view class="mm-del pressable" catchtap="onMemberManageDelete" data-mid="{{item.member_id}}" aria-label="删除成员">删除</view>
        </view>
      </scroll-view>
      <view class="mm-divider"></view>
      <button class="mm-add pressable" bindtap="onMemberManageAdd" aria-label="添加成员">+ 添加成员</button>
    </view>
  </view>

  <!-- 保单明细 sheet：复用统一 edit-sheet（view 态只读 → [编辑] 切编辑态 → [保存]；与 OCR 结果 sheet 完全复用） -->
  <edit-sheet visible="{{showEdit}}" title="{{editTitle}}" fields="{{editFields}}" mode="{{sheetMode}}" saving="{{editSaving}}" bindclose="onCloseEdit" bindsave="onSaveEdit" />
</view>
  <!-- OCR 全流程组件（跳过家庭匹配，默认当前家庭） -->
  <ocr-flow id="ocrFlow" skipMatch familyId="{{familyId}}" bind:saved="onOcrFlowSaved" />
