.page { min-height:100vh; background:var(--bg-root); display:flex; flex-direction:column }
.content { flex:1 }

/* Hero 保障覆盖检查卡（结论先行） */
.hero { margin:var(--sp-5) var(--sp-5) var(--sp-4); padding:var(--sp-7) var(--sp-6); border-radius:var(--r-xl); background:var(--bg-card); border:1rpx solid var(--border); box-shadow:var(--shadow-md); animation:cardReveal var(--dur-glacial) var(--ease-out-expo) both; }
.hero-title { font-size:var(--fs-caption); font-weight:var(--fw-bold); color:var(--accent-deep); letter-spacing:var(--ls-wide); margin-bottom:var(--sp-5); padding-bottom:var(--sp-4); border-bottom:1rpx solid var(--border-accent); }
.hero-alert { display:flex; align-items:flex-start; gap:var(--sp-3); padding:var(--sp-3) 0; }
.hero-alert-icon { font-size:var(--fs-caption); line-height:var(--lh-body); flex-shrink:0; }
.hero-alert-text { font-size:var(--fs-body); line-height:var(--lh-body); flex:1; color:var(--text-primary); }
.hero-alert.is-warn .hero-alert-text { color:var(--red); font-weight:var(--fw-medium); }
.hero-alert.is-ok .hero-alert-text { color:var(--green-report, #4A9C6D); }
.hero-summary-line { margin-top:var(--sp-5); padding-top:var(--sp-4); border-top:1rpx solid var(--border); font-size:var(--fs-caption); color:var(--text-secondary); line-height:var(--lh-body); }
.hero-advice { margin-top:var(--sp-3); font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); border-radius:var(--r-md); padding:var(--sp-3) var(--sp-4); line-height:var(--lh-body); }

/* 摘要数字卡（总保费/总保额/保单数） */
.summary-cards { margin:0 var(--sp-5) var(--sp-5); display:flex; gap:var(--sp-3); animation:cardReveal var(--dur-glacial) var(--ease-out-expo) 0.1s both; }
.sc-card { flex:1; display:flex; flex-wrap:wrap; align-items:baseline; justify-content:center; gap:var(--sp-1); background:var(--bg-card); border:1rpx solid var(--border); border-radius:var(--r-lg); padding:var(--sp-5) var(--sp-3); box-shadow:var(--shadow-sm); }
.sc-val { font-size:var(--fs-2xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); line-height:var(--lh-none); font-variant-numeric:tabular-nums; }
.sc-unit { font-size:var(--fs-tiny); color:var(--text-secondary); }
.sc-lbl { width:100%; text-align:center; font-size:var(--fs-tiny); color:var(--text-tertiary); margin-top:var(--sp-2); letter-spacing:var(--ls-wide); }

.title-bar { display:flex; align-items:flex-start; padding:0 var(--sp-5); }
.report-title { flex:1; min-width:0; padding:var(--sp-5) 0 var(--sp-3); display:flex; flex-direction:column; gap:var(--sp-1); }
.title-name { font-size:var(--fs-3xl); font-weight:var(--fw-bold); color:var(--text-primary); letter-spacing:var(--ls-wide); font-family:var(--font-serif); }
.title-sub { font-size:var(--fs-caption); font-weight:var(--fw-normal); color:var(--text-secondary); letter-spacing:var(--ls-wide); }
.summary-block { margin:var(--sp-2) var(--sp-5) var(--sp-5); padding:var(--sp-5); background:var(--bg-card); border-radius:var(--r-xl); box-shadow:none; border:1rpx solid var(--border); display:flex; gap:var(--sp-3); align-items:stretch; flex-wrap:wrap; }
.summary-bar { width:3rpx; min-height:36rpx; background:var(--accent-muted); border-radius:2rpx; flex-shrink:0; }
.summary-text { font-size:var(--fs-body); color:var(--text-primary); line-height:var(--lh-body); flex:1 }
.summary-basis { font-size:var(--fs-tiny); color:var(--text-disabled); width:100%; margin-top:var(--sp-2); padding-left:var(--sp-4); }

.content-pad { height:calc(128rpx + 24rpx); height:calc(128rpx + env(safe-area-inset-bottom) + 24rpx) }

/* ========== 保单明细只读 Sheet ========== */
.policy-sheet-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-dim); z-index:var(--z-sheet); animation:fadeIn var(--dur-base) var(--ease-out); -webkit-backdrop-filter:blur(8rpx); backdrop-filter:blur(8rpx); }
.policy-sheet { position:absolute; bottom:0; left:0; right:0; background:var(--bg-surface); border-radius:var(--r-2xl) var(--r-2xl) 0 0; padding:var(--sp-4) var(--sp-6); padding-bottom:calc(var(--sp-6) + env(safe-area-inset-bottom)); animation:slideUp var(--dur-base) var(--ease-spring); box-shadow:var(--shadow-sheet); }
.ps-grabber { width:64rpx; height:6rpx; border-radius:3rpx; background:var(--border); margin:0 auto var(--sp-6); }
.ps-title { font-size:var(--fs-xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); text-align:center; margin-bottom:var(--sp-6); }
.ps-body { max-height:55vh; overflow:hidden; }
.ps-row { display:flex; justify-content:space-between; gap:var(--sp-4); padding:var(--sp-4) 0; border-bottom:1rpx solid var(--border); }
.ps-row-lbl { font-size:var(--fs-caption); color:var(--text-tertiary); flex-shrink:0; letter-spacing:var(--ls-wide); }
.ps-row-val { font-size:var(--fs-body); color:var(--text-primary); font-weight:var(--fw-medium); text-align:right; flex:1; min-width:0; word-break:break-all; font-variant-numeric:tabular-nums; }
.ps-divider { height:1rpx; background:var(--border-accent); margin:var(--sp-6) 0 var(--sp-5); }
.ps-edit-btn { width:100%; height:88rpx; background:var(--accent); color:var(--color-on-accent); font-size:var(--fs-lg); font-weight:var(--fw-semi); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:none; }

/* ========== 成员管理 Sheet ========== */
.member-manage-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-dim); z-index:var(--z-sheet); animation:fadeIn var(--dur-base) var(--ease-out); -webkit-backdrop-filter:blur(8rpx); backdrop-filter:blur(8rpx); }
.member-manage { position:absolute; bottom:0; left:0; right:0; background:var(--bg-surface); border-radius:var(--r-2xl) var(--r-2xl) 0 0; padding:var(--sp-4) var(--sp-6); padding-bottom:calc(var(--sp-6) + env(safe-area-inset-bottom)); animation:slideUp var(--dur-base) var(--ease-spring); box-shadow:var(--shadow-sheet); }
.mm-grabber { width:64rpx; height:6rpx; border-radius:3rpx; background:var(--border); margin:0 auto var(--sp-6); }
.mm-title { font-size:var(--fs-xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); text-align:center; margin-bottom:var(--sp-6); }
.mm-list { max-height:50vh; overflow:hidden; }
.mm-item { display:flex; align-items:center; gap:var(--sp-4); padding:var(--sp-4) var(--sp-2); border-bottom:1rpx solid var(--border); }
.mm-name { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); flex:1; }
.mm-role { font-size:var(--fs-caption); color:var(--text-tertiary); }
.mm-edit { font-size:var(--fs-caption); color:var(--accent-deep); }
.mm-divider { height:1rpx; background:var(--border-accent); margin:var(--sp-6) 0 var(--sp-5); }
.mm-add { width:100%; height:88rpx; background:var(--accent); color:var(--color-on-accent); font-size:var(--fs-lg); font-weight:var(--fw-semi); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:none; }

/* ========== FAB 栏（页面层，position:fixed 可靠） ========== */
.fab-wrap { position:fixed; bottom:0; left:0; right:0; z-index:101; background:var(--bg-surface); padding-bottom:0px; padding-bottom:env(safe-area-inset-bottom); border-top:1rpx solid var(--border); box-shadow:var(--shadow-sheet); }
.fab-bar { padding:var(--sp-4) var(--sp-5) }
.fab-inner { display:flex; align-items:center; height:88rpx; padding:0 var(--sp-1) }
.fab-upload { width:auto; height:88rpx; border-radius:var(--r-full); background:var(--accent-dim); display:flex; align-items:center; justify-content:center; gap:var(--sp-1-5); padding:0 var(--sp-5); flex-shrink:0 }
.fab-plus { font-size:var(--fs-display); color:var(--accent); font-weight:var(--fw-normal); line-height:var(--lh-none) }
.fab-upload-label { font-size:var(--fs-caption); color:var(--accent-deep) }
.fab-input { flex:1; height:88rpx; margin:0 var(--sp-3); background:var(--bg-input); border-radius:var(--r-full); display:flex; align-items:center; padding:0 var(--sp-5); transition:box-shadow var(--dur-fast) var(--ease-out); }
.fab-input-active { background:var(--bg-card); box-shadow:0 0 0 2rpx var(--accent); }
.fab-real-input { width:100%; height:100%; font-size:var(--fs-body); color:var(--text-primary) }
.fab-send { width:88rpx; height:88rpx; border-radius:var(--r-full); background:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform var(--dur-fast) var(--ease-out); }
.fab-send:not(.is-disabled):active { transform:scale(0.92); }
.fab-send.is-disabled { background:var(--accent-muted); box-shadow:none; }
.fab-arrow { font-size:var(--fs-body); color:var(--color-on-accent); font-weight:var(--fw-bold); line-height:var(--lh-none); display:inline-block; transform:rotate(-90deg) }

/* 封面元数据（日期/编号/印章 — 报告仪式感） */
.report-meta { display:flex; align-items:center; gap:var(--sp-3); padding:0 var(--sp-5) var(--sp-3); }
.report-meta-text { font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:var(--ls-wide); font-variant-numeric:tabular-nums; font-family:var(--font-serif); }
.report-meta-line { flex:1; height:1rpx; background:var(--border-accent); }
.report-seal { font-size:var(--fs-tiny); color:var(--text-tertiary); font-family:var(--font-serif); flex-shrink:0; }
/* ④ 封面底部分割线：渐变淡出 */
.report-divider { margin:0 var(--sp-5) var(--sp-3); height:1rpx; background:var(--border); }

.update-toast { position:fixed; top:0; left:0; right:0; z-index:var(--z-toast); padding:var(--sp-4) var(--sp-6); padding-top:var(--sp-4); padding-top:calc(var(--sp-4) + env(safe-area-inset-top)); background:linear-gradient(180deg,var(--accent-deep),var(--accent)); color:var(--color-on-accent); font-size:var(--fs-caption); text-align:center; transform:translateY(-120%); transition:transform 0.35s var(--ease-spring); letter-spacing:var(--ls-wide); font-family:var(--font-serif); }
.update-toast.show { transform:translateY(0) }

.gap-section { margin:var(--sp-2) var(--sp-5) var(--sp-4) }
.gap-section-title { font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary); margin-bottom:var(--sp-4) }
.gap-card { background:var(--bg-surface); border-radius:var(--r-xl); padding:var(--sp-5); margin-bottom:var(--sp-4); border:1rpx solid var(--border) }
.gap-card-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--sp-3) }
.gap-cat { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary) }
.gap-priority { font-size:var(--fs-tiny); padding:var(--sp-1) var(--sp-3); border-radius:var(--r-full); }
.gap-priority-high { background:var(--red-dim); color:var(--red) }
.gap-priority-medium { background:var(--amber-dim); color:var(--amber) }
.gap-priority-low { background:var(--accent-dim); color:var(--accent-deep) }
.gap-card-body { display:flex; align-items:baseline; gap:var(--sp-3); margin-bottom:var(--sp-2) }
.gap-gap { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--red) }
.gap-blocked { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--amber) }
.gap-rel { font-size:var(--fs-tiny); color:var(--text-tertiary) }
.gap-rel-estimated { color:var(--amber) }
.gap-rel-blocked { color:var(--red) }
.gap-basis { font-size:var(--fs-caption); color:var(--text-tertiary); line-height:var(--lh-body); margin-bottom:var(--sp-1) }
.gap-hint { font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); padding:var(--sp-2) var(--sp-3); border-radius:var(--r-md); margin-top:var(--sp-2) }

.loading { display:flex; justify-content:center; padding-top:var(--sp-6) }
.loading-text { text-align:center; font-size:var(--fs-caption); color:var(--text-secondary); margin-top:var(--sp-5); animation:fadeIn var(--dur-slow) var(--ease-out) 0.5s both; }

/* 骨架屏 — 圆角与真实卡片一致 */
.skeleton-wrap { width:100%; padding:0 var(--sp-5); }
.sk-title-bar { display:flex; align-items:center; justify-content:space-between; padding:var(--sp-5) 0 var(--sp-3); }
.sk-title { width:55%; height:40rpx; border-radius:var(--r-sm); }
.sk-btn { width:56rpx; height:56rpx; border-radius:50%; }
.sk-summary { width:100%; height:88rpx; border-radius:var(--r-2xl); margin:var(--sp-2) 0; }
.sk-block-card { width:100%; height:200rpx; border-radius:var(--r-lg); margin-bottom:var(--sp-4-5); }
.sk-shimmer { background:linear-gradient(90deg,var(--bg-input) 25%,var(--accent-dim) 37%,var(--bg-input) 63%); background-size:400% 100%; animation:shimmer 1.8s ease infinite; }
