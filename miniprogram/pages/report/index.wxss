.page { height:100vh; background:var(--bg-root); display:flex; flex-direction:column; overflow:hidden }
/* 2026-09-13：报告页字号局部回调（只作用于滚动内容区，不影响页面层操作 UI）。
   一、正文类再降（"正文再小一点"）：--fs-reading / --fs-base 32 → 30rpx（16 → 15px）。
       为什么是 15px 而非 14px：14px 与次要信息档 --fs-caption（28rpx = 14px）撞号，
       正文会与"单位/时间戳/表格数值"变成同一层级、层级被压平。30rpx 这个长文专用档
       正是为此存在（见 app.wxss 里 --fs-reading 的注释）。
   二、标题档保持上一轮的降幅：--fs-lg 32 / --fs-xl 36rpx，仍比正文高 2~4rpx，层级清晰。
   三、不动信息类（caption 28 / tiny 24），也不动 --fs-body——hero 告警是 2~3 行短句，
       保留 32rpx；顺带也就无需同步 .hero-alert-dot 的固定偏移（它按 32rpx 首行高算的）。
   注：CSS 自定义属性沿 DOM 继承、不受组件样式隔离影响，故这一处覆盖即可作用于其下所有组件
   （report-markdown / markdown-render）；而挂页面层的操作界面（成员 Sheet / 信息核实 / 对话面板）
   不在 .content 内，按钮文案不受影响。 */
.content { flex:1; min-height:0; --fs-reading: 30rpx; --fs-base: 30rpx; --fs-lg: 32rpx; --fs-xl: 36rpx }

/* 保障摘要 + 覆盖检查融合卡：数据在上，检查在下（原独立 Hero 卡已并入） */
/* 正文卡片间距：sp-6（24rpx，与卡内 padding 同值，紧凑连贯） */
.summary-card { margin:0 var(--sp-5) var(--sp-7); padding:var(--sp-6); border-radius:var(--r-xl); background:var(--bg-card); border:1rpx solid var(--border); box-shadow:var(--shadow-md); animation:cardReveal var(--dur-glacial) var(--ease-out-expo) both; }
.summary-card-title { font-size:var(--fs-lg); font-weight:var(--fw-bold); color:var(--accent-deep); letter-spacing:var(--ls-wide); font-family:var(--font-serif); margin-bottom:var(--sp-5); padding-bottom:var(--sp-4); border-bottom:1rpx solid var(--border-accent); }
.summary-card-grid { display:flex; gap:var(--sp-3); }
/* 覆盖检查区：与摘要数据分隔，卡内下半区（分隔线统一 --border-accent） */
/* 审计·顾问视角：总保额下区分一年期短险（防保额虚高误导），弱化次级注记样式 */
.summary-note { margin-top:var(--sp-3); font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:0.5rpx; }
/* 审计 C1：AI 一句话结论（引语式金色竖线，置保障摘要数字与覆盖检查之间） */
.hero-conclusion { margin-top:var(--sp-5); padding-left:var(--sp-4); border-left:4rpx solid var(--accent-deep); font-family:var(--font-serif); font-size:var(--fs-base); color:var(--text-primary); line-height:var(--lh-body); }
/* P1-C（2026-09-05）：AI 结论来源徽标（与下方规则版覆盖检查区分，防客户误读 AI 为系统计算） */
.hero-conclusion-tag { display:inline-block; font-size:var(--fs-tiny); color:var(--accent-deep); border:1rpx solid var(--border-accent); border-radius:6rpx; padding:0 8rpx; margin-right:10rpx; vertical-align:2rpx; }
.summary-check { margin-top:var(--sp-5); padding-top:var(--sp-4); border-top:1rpx solid var(--border-accent); }
.hero-alert { display:flex; align-items:flex-start; gap:var(--sp-3); padding:var(--sp-3) 0; }
/* 2026-09-12 解耦：原 margin-top:calc(var(--fs-body) * var(--lh-body) / 2 - 5rpx) 把"首行光学中心"
   绑死两个 token 的乘积——任何人按字号/行高建议调整 token 时，红/黄/绿点会整体偏移而这行无人想起。
   改固定偏移：22rpx = 首行光学中心(32rpx×1.7÷2 = 27.2) − 点半径 5rpx 的整数近似。
   2026-09-12 字号整体上调一档后同步从 18rpx → 22rpx——这正是解耦的收益：只需改这一个数，
   不必推演两个 token 的乘积。 */
.hero-alert-dot { width:10rpx; height:10rpx; border-radius:50%; margin-top:22rpx; flex-shrink:0; background:var(--ok); }
.hero-alert.is-warn .hero-alert-dot { background:var(--red); }
.hero-alert-text { font-size:var(--fs-body); line-height:var(--lh-body); flex:1; color:var(--text-primary); }
.hero-alert.is-warn .hero-alert-text { color:var(--red); font-weight:var(--fw-medium); }
.hero-alert.is-ok .hero-alert-text { color:var(--ok-deep); }
/* 2026-09-10 三态：无确切缺口但存在「无法计算」（如缺收入的寿险/意外）→ 黄点警示，
   原实现归入 is-ok 绿点"保障覆盖完整"，把未知状态说成了完整 */
.hero-alert.is-unknown .hero-alert-dot { background:var(--amber); }
.hero-alert.is-unknown .hero-alert-text { color:var(--amber-deep); }
/* 结论先行：汇总居上（semibold 深色，区别于论据），论据列表随后 */
.hero-summary-lead { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); line-height:var(--lh-body); margin-bottom:var(--sp-2); }
/* 行动建议：与上方点评诊断分隔——伪元素画独立分隔线（块外，不与建议块上边框融合；色统一 --border-accent） */
.hero-advice { margin-top:var(--sp-5); padding-top:var(--sp-4); border-top:1rpx solid var(--border-accent); font-size:var(--fs-base); color:var(--accent-deep); line-height:var(--lh-body); }


/* 全链路审计 UC4：无保单空状态卡（与首页/客户列表空状态同构：描边卡 + 引导按钮） */
.empty-report { margin:0 var(--sp-5) var(--sp-6); padding:var(--sp-10) var(--sp-6); border-radius:var(--r-xl); background:var(--bg-card); border:1rpx dashed var(--border-accent); display:flex; flex-direction:column; align-items:center; text-align:center; }
.empty-report-icon { font-size:var(--fs-3xl); margin-bottom:var(--sp-4); opacity:0.6; }
.empty-report-title { font-size:var(--fs-xl); font-weight:var(--fw-semi); color:var(--text-primary); font-family:var(--font-serif); margin-bottom:var(--sp-3); letter-spacing:var(--ls-wide); }
.empty-report-desc { font-size:var(--fs-base); color:var(--text-secondary); line-height:var(--lh-body); max-width:480rpx; }

.title-bar { display:flex; align-items:flex-start; padding:0 var(--sp-5); }
.report-title { flex:1; min-width:0; padding:var(--sp-7) 0 var(--sp-5); display:flex; flex-direction:column; gap:var(--sp-2); }
.title-name { font-size:var(--fs-display); font-weight:var(--fw-bold); color:var(--text-primary); letter-spacing:var(--ls-wide); font-family:var(--font-serif); }
/* flex-wrap：页头时间接上"数据更新于"标签后变长（多 5 字），窄屏下让 meta 换到第二行，而不是挤压副标题 */
.title-subrow { display:flex; align-items:baseline; justify-content:space-between; gap:var(--sp-3); flex-wrap:wrap; }
.title-sub { font-size:var(--fs-caption); font-weight:var(--fw-normal); color:var(--text-secondary); letter-spacing:var(--ls-wide); }
/* 报告生成时间（副标题层级，衬线小字区别于主副标题） */
.title-meta { font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:var(--ls-wide); font-variant-numeric:tabular-nums; flex-shrink:0; }

/* 保障分析生成时间（分析卡头下方，tini 次级说明，不占标题区主位） */
.deep-meta { display:block; font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-body); margin:var(--sp-1) 0 var(--sp-4); }
/* 时效标识（owner）：数据已更新、保障分析待刷新（暖金胶囊弱提示） */
.title-stale { align-self:flex-start; font-size:var(--fs-tiny); color:var(--amber-deep); background:var(--amber-dim); padding:4rpx 14rpx; border-radius:999rpx; }
/* 定性模式常驻披露（2026-09-18 报告页审计）：tier=degraded → 报告不含量化测算。
   与 .title-stale 同处页头，但语义更重（影响整份报告的可解读性，不是"待刷新"这种弱提示），
   故用中性卡片底 + 左侧金色色条，避免与琥珀胶囊混淆；触控热区沿用伪元素外扩 88rpx 基准。 */
.title-qual { align-self:stretch; display:flex; align-items:center; gap:var(--sp-3); margin-top:var(--sp-2); padding:var(--sp-2) var(--sp-3); background:var(--bg-card); border-left:4rpx solid var(--accent-deep); border-radius:var(--r-lg); }
.title-qual-text { flex:1; font-size:var(--fs-caption); color:var(--text-secondary); line-height:var(--lh-body); }
.title-qual-act { position:relative; flex-shrink:0; font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--accent-deep); }
.title-qual-act::after { content:''; position:absolute; border:none; left:-20rpx; right:-20rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.title-qual-act:active { opacity:0.6; }
/* 活报告模型（2026-09）：待澄清项（owner）——完善信息引导，轻卡片 */
/* 2026-09-09 色彩语义收敛：原用 --amber-dim 与「风险/警示」同色，引导类内容改中性底，
   让暖金只承担「AI 产出」、浅红只承担「风险」 */
.deep-clarify { margin:0 var(--sp-5) var(--sp-4); padding:var(--sp-4); background:var(--bg-input); border-radius:12rpx; }
.deep-clarify-title { font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--amber-deep); margin-bottom:var(--sp-2); }
.deep-clarify-item { display:flex; align-items:center; justify-content:space-between; padding:8rpx 0; }
.deep-clarify-label { font-size:var(--fs-base); color:var(--text-secondary); flex:1; margin-right:var(--sp-3); }
.deep-clarify-act { font-size:var(--fs-caption); color:var(--amber-deep); flex-shrink:0; }
/* 活报告模型（2026-09）挂载点③：客户版沟通桥引导（水印上方正向提示） */
.share-guide { font-size:var(--fs-caption); color:var(--text-secondary); text-align:center; margin-bottom:var(--sp-2); line-height:var(--lh-body); padding:0 var(--sp-6); }
/* 标题区域与正文分隔线（2026-09-06 强化 2rpx，明确标题区与正文区分界；距正文 sp-5 与章节 h1n 标题节奏对齐） */
.title-divider { margin:0 var(--sp-5) var(--sp-6); height:2rpx; background:var(--border-accent); }
/* ===== 阶段一报告主体：保单整理（2026-10-13）=====
   信息密度优先、克制用色：暖金只用于中性标识，红/绿不用于判断（不出建议、不加形容词）。 */
.sum-card { margin:0 var(--sp-5) var(--sp-5); padding:26rpx 28rpx; background:var(--bg-card, #FFFDF9); border:1rpx solid var(--border, #E8E0D5); border-radius:var(--r-lg, 20rpx); }
.sum-grid { display:flex; }
.sum-item { flex:1; }
.sum-label { font-size:var(--fs-tiny, 24rpx); color:var(--text-tertiary, #857256); }
.sum-value { margin-top:6rpx; font-size:var(--fs-lg, 36rpx); font-weight:var(--fw-semi, 600); color:var(--text-primary, #1A1A2E); }
.sum-value-lg { margin-top:6rpx; font-size:var(--fs-display, 48rpx); font-weight:var(--fw-bold, 700); color:var(--text-primary, #1A1A2E); letter-spacing:var(--ls-tight, -0.5rpx); }
.sum-wide { margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid var(--border, #E8E0D5); }
.sum-note { margin-top:8rpx; font-size:var(--fs-tiny, 24rpx); color:var(--text-tertiary, #857256); line-height:var(--lh-body, 1.7); }
.tags { display:flex; flex-wrap:wrap; margin-top:10rpx; }
.tag { margin:0 12rpx 12rpx 0; padding:6rpx 18rpx; border-radius:999rpx; background:var(--accent-dim, rgba(201,169,110,0.12)); color:var(--accent-deep, #8B6F3C); font-size:var(--fs-caption, 28rpx); }
.tag-empty { font-size:var(--fs-caption, 28rpx); color:var(--text-tertiary, #857256); }
.sec-title { margin:0 var(--sp-5) 14rpx; font-size:var(--fs-caption, 28rpx); color:var(--text-tertiary, #857256); letter-spacing:var(--ls-wide, 1rpx); }
.mem-hd { display:flex; align-items:baseline; }
.mem-name { font-size:var(--fs-lg, 36rpx); font-weight:var(--fw-semi, 600); color:var(--text-primary, #1A1A2E); }
.mem-role { margin-left:12rpx; font-size:var(--fs-caption, 28rpx); color:var(--text-secondary, #6E5A3E); }
.mem-src { margin-left:auto; font-size:var(--fs-tiny, 24rpx); color:var(--text-tertiary, #857256); }
.mem-meta { margin-top:6rpx; font-size:var(--fs-caption, 28rpx); color:var(--text-secondary, #6E5A3E); }
.pol { margin-top:20rpx; padding-top:20rpx; border-top:1rpx dashed var(--border, #E8E0D5); }
.pol-title { display:flex; align-items:baseline; }
.pol-name { flex:1; font-size:var(--fs-base, 32rpx); color:var(--text-primary, #1A1A2E); }
.pol-cat { margin-left:12rpx; font-size:var(--fs-tiny, 24rpx); color:var(--text-tertiary, #857256); }
.pol-row { display:flex; margin-top:8rpx; font-size:var(--fs-caption, 28rpx); }
.pol-row .k { width:160rpx; color:var(--text-tertiary, #857256); }
.pol-row .v { flex:1; color:var(--text-secondary, #6E5A3E); }
.pol-flags { display:flex; flex-wrap:wrap; margin-top:10rpx; }
.flag { margin-right:12rpx; padding:4rpx 14rpx; border-radius:var(--r-sm, 8rpx); font-size:var(--fs-tiny, 24rpx); }
.flag-term { background:var(--amber-dim, #F5ECCE); color:var(--amber-deep, #7C5E1C); }
.flag-low { background:var(--bg-input, #F5F0EB); color:var(--text-secondary, #6E5A3E); }
.pol-empty { margin-top:14rpx; font-size:var(--fs-caption, 28rpx); color:var(--text-tertiary, #857256); }
.pend { padding:14rpx 0; border-bottom:1rpx solid var(--border, #E8E0D5); }
.pend:last-child { border-bottom:none; padding-bottom:0; }
.pend-name { font-size:var(--fs-caption, 28rpx); color:var(--text-primary, #1A1A2E); }
.pend-detail { margin-top:4rpx; font-size:var(--fs-caption, 28rpx); color:var(--text-secondary, #6E5A3E); }
/* 原 AI 分析报告的展开/收起（默认收起） */
.legacy-toggle { display:flex; align-items:center; justify-content:center; margin:0 var(--sp-5) var(--sp-5); padding:20rpx; border:1rpx dashed var(--border, #E8E0D5); border-radius:var(--r-md, 16rpx); }
.legacy-toggle:active { opacity:0.7 }
.legacy-toggle-text { font-size:var(--fs-caption, 28rpx); color:var(--text-secondary, #6E5A3E) }
.legacy-toggle-go { margin-left:12rpx; font-size:var(--fs-caption, 28rpx); color:var(--text-tertiary, #857256) }




/* ========== 免责声明（报告正文最末，转发按钮之前） ========== */
.report-disclaimer { padding:var(--sp-2) var(--sp-5) var(--sp-4); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-loose); text-align:center; }

/* ========== 底部操作（转发 + 深度分析，设计稿 v4） ========== */
.report-footer { display:flex; gap:var(--sp-4); padding:var(--sp-4) var(--sp-5); }
/* 2026-09-18 报告页审计：owner 模式下方有 FAB 条承担安全区（.fab-wrap 自带 env()），此处再加会多出约 34px 空隙；
   shared 模式无 FAB、scroll-view 直达屏幕底 → 仅该模式补底部安全区 */
.report-footer--shared { padding-bottom:calc(var(--sp-4) + env(safe-area-inset-bottom)); }
.report-footer .footer-share, .report-footer .footer-export { margin:0; }
/* UI 打磨：footer 按钮 88→80rpx，弱化与底部 FAB 输入条 88rpx 双条带的层叠拥挤 */
/* 2026-09-02：深度分析生成入口已移至结论下的 deep-entry，footer 移除 analyze 按钮 */
.footer-share, .footer-export { flex:1; height:80rpx; display:flex; align-items:center; justify-content:center; font-size:var(--fs-body); border-radius:var(--r-lg); line-height:normal; margin:0; }
.footer-share { background:var(--bg-surface); color:var(--text-primary); border:1rpx solid var(--border); }
.footer-export { background:var(--accent); color:var(--btn-text-on-accent); font-weight:var(--fw-medium); border:none; margin-left:var(--sp-3); }
.footer-share::after, .footer-export::after { border:none; }
/* 分享模式（客户查看）底部水印 */
.share-watermark { flex:1; display:flex; align-items:center; justify-content:center; font-size:var(--fs-tiny); color:var(--text-tertiary); }

/* ========== 客户档案要点（facts 时间线，2026-09-12） ========== */
/* 复盘场景补口：facts 此前只落库无渲染。默认折叠，展开后为"时间 + 事实"两列列表 */
.facts-card { margin:var(--sp-6) var(--sp-5); padding:var(--sp-5) var(--sp-5) var(--sp-4); background:var(--bg-card); border-radius:var(--r-xl); border:1rpx solid var(--border); box-shadow:var(--shadow-sm); }
.facts-head { display:flex; align-items:center; gap:var(--sp-3); }
.facts-title { font-family:var(--font-serif); font-size:var(--fs-lg); font-weight:var(--fw-normal); color:var(--text-primary); letter-spacing:var(--ls-wide); }
.facts-count { font-size:var(--fs-tiny); color:var(--text-tertiary); }
.facts-arrow { margin-left:auto; font-size:var(--fs-tiny); color:var(--accent-deep); }
.facts-list { margin-top:var(--sp-4); }
.facts-item { display:flex; gap:var(--sp-3); padding:var(--sp-2) 0; border-bottom:1rpx solid var(--border); }
.facts-item:last-child { border-bottom:none; }
/* 2026-09-12：tiny 20→24rpx 后日期列需同步放宽（否则"2026-09-12"会被挤成两行） */
.facts-time { flex-shrink:0; width:150rpx; font-size:var(--fs-tiny); color:var(--text-tertiary); }
.facts-text { flex:1; font-size:var(--fs-base); color:var(--text-primary); line-height:var(--lh-body); word-break:break-word; }
.facts-more { padding-top:var(--sp-2); font-size:var(--fs-tiny); color:var(--text-tertiary); text-align:center; }
/* 2026-09-14 四档结构：关键属性（常驻）/ 需要留意 / 待核实 / 记录时间线 */
.facts-sec { padding:var(--sp-4) 0 var(--sp-2); font-size:var(--fs-caption); color:var(--text-tertiary); letter-spacing:var(--ls-wide); }
.facts-sec:first-child { padding-top:0; }
.facts-member { display:flex; flex-direction:column; gap:2rpx; padding:var(--sp-2) 0; border-bottom:1rpx solid var(--border); }
.facts-member:last-child { border-bottom:none; }
.facts-member-name { font-size:var(--fs-base); color:var(--text-primary); font-weight:var(--fw-medium); }
.facts-member-text { font-size:var(--fs-caption); color:var(--text-secondary); line-height:var(--lh-body); word-break:break-word; }
/* 需要留意（constraint）：暖金强调——项目语义色只有 ok 系（无红/黄），保持克制不刺眼 */
.facts-warn { display:flex; gap:var(--sp-2); padding:var(--sp-2) 0; }
.facts-mark { flex-shrink:0; width:32rpx; height:32rpx; line-height:32rpx; text-align:center; border-radius:var(--r-full); font-size:var(--fs-tiny); background:var(--accent-dim); color:var(--accent-deep); margin-top:4rpx; }
.facts-mark--muted { background:transparent; color:var(--text-tertiary); }
.facts-warn-text { flex:1; font-size:var(--fs-base); color:var(--text-primary); line-height:var(--lh-body); word-break:break-word; }
/* 待核实（lead）：整体弱化 + "未确认"标记（防止被当成客户确认的事实） */
.facts-lead { display:flex; gap:var(--sp-2); align-items:baseline; padding:var(--sp-2) 0; }
.facts-lead-text { flex:1; font-size:var(--fs-base); color:var(--text-secondary); line-height:var(--lh-body); word-break:break-word; }
.facts-lead-tag { flex-shrink:0; font-size:var(--fs-tiny); color:var(--text-tertiary); border:1rpx solid var(--border); border-radius:var(--r-full); padding:0 var(--sp-2); }

/* ========== 客户版预览（2026-09-12） ========== */
/* 入口：owner 侧自检"这份报告能否拿出手"，不占 footer 主按钮位 */
.preview-entry { display:flex; justify-content:center; padding:0 var(--sp-5) var(--sp-2); }
.preview-entry-btn { position:relative; font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); border-radius:var(--r-full); padding:var(--sp-2) var(--sp-5); }
/* 触控热区：伪元素透明外扩至 ≥88rpx */
.preview-entry-btn::after { content:''; position:absolute; left:-20rpx; right:-20rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.preview-entry-btn:active { opacity:0.6; }
/* 成交标记开启态（owner）：与预览按钮同排，开启后实心强调 */
.preview-entry-btn.is-on { background:var(--ok-dim); color:var(--ok-deep); font-weight:var(--fw-semi); }
/* 反馈入口（MVP 验证）：正文末一行，克制不抢主视觉 */
.feedback-row { display:flex; flex-direction:column; align-items:center; gap:var(--sp-3); padding:var(--sp-4) var(--sp-5) var(--sp-2); }
.feedback-q { font-size:var(--fs-caption); color:var(--text-secondary); }
.feedback-btns { display:flex; gap:var(--sp-4); }
.feedback-btn { font-size:var(--fs-caption); color:var(--accent-deep); background:var(--bg-input); border-radius:var(--r-full); padding:var(--sp-2) var(--sp-6); position:relative; }
.feedback-btn::after { content:''; position:absolute; left:0; right:0; top:50%; height:88rpx; transform:translateY(-50%); }
.feedback-btn:active { opacity:0.6; }
/* 预览态顶部提示条：2026-09-12 移出 scroll-view，改作页面级固定条。
   原为 position:sticky top:0 z-index:30，与组件内 .toc（sticky top:0 z-index:20）争夺同一
   吸附位 → 目录被完全覆盖且点不到。现由 .page 的 flex 列布局天然固定在顶部（不滚动，故
   无需 sticky）；flex-shrink:0 防被 scroll-view 挤压；z-index 仅用于压住滚动内容的投影。
   有意不纳入宽屏限宽名单：它是"模式提示"色带，全宽更符合顶部条语义（正文块才需要 720 居中）。 */
.preview-bar { flex-shrink:0; position:relative; z-index:30; display:flex; align-items:center; justify-content:space-between; gap:var(--sp-3); padding:var(--sp-3) var(--sp-5); background:var(--accent-dim); border-bottom:1rpx solid var(--border-accent); }
.preview-bar-text { font-size:var(--fs-caption); color:var(--accent-deep); }
.preview-bar-exit { position:relative; flex-shrink:0; font-size:var(--fs-caption); font-weight:var(--fw-semi); color:var(--accent-deep); }
.preview-bar-exit::after { content:''; position:absolute; left:-20rpx; right:-20rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.preview-bar-exit:active { opacity:0.6; }

/* ========== 成员管理 Sheet ========== */
.member-manage-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-dim); z-index:var(--z-sheet); animation:fadeIn var(--dur-base) var(--ease-out); -webkit-backdrop-filter:blur(8rpx); backdrop-filter:blur(8rpx); }
.member-manage { position:absolute; bottom:0; left:0; right:0; background:var(--bg-surface); border-radius:var(--r-2xl) var(--r-2xl) 0 0; padding:var(--sp-4) var(--sp-6); padding-bottom:calc(var(--sp-6) + env(safe-area-inset-bottom)); animation:slideUp var(--dur-base) var(--ease-spring); box-shadow:var(--shadow-sheet); max-height:85vh; display:flex; flex-direction:column; }
.mm-grabber { width:64rpx; height:6rpx; border-radius:3rpx; background:var(--border); margin:0 auto var(--sp-6); flex-shrink:0; }
.mm-title { font-size:var(--fs-xl); font-weight:var(--fw-bold); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); text-align:center; margin-bottom:var(--sp-6); flex-shrink:0; }
.mm-list { flex:1; height:0; min-height:0; }
.mm-item { display:flex; align-items:center; gap:var(--sp-4); padding:var(--sp-4) var(--sp-2); border-bottom:1rpx solid var(--border); }
.mm-name { font-size:var(--fs-body); font-weight:var(--fw-semi); color:var(--text-primary); flex:1; }
.mm-role { font-size:var(--fs-caption); color:var(--text-tertiary); }
/* UI 打磨：编辑入口统一 pill（与章节卡 [编辑] / risk [核对] 同构） */
.mm-edit { font-size:var(--fs-caption); color:var(--accent-deep); background:var(--accent-dim); border-radius:var(--r-full); padding:var(--sp-2) var(--sp-4); }
.mm-divider { height:1rpx; background:var(--border-accent); margin:var(--sp-6) 0 var(--sp-5); flex-shrink:0; }
/* UI 审计 #②：#⑤：accent 白字改深色；成员管理 Sheet 显式关闭按钮 */
.mm-add { width:100%; height:88rpx; background:var(--accent); color:var(--btn-text-on-accent); font-size:var(--fs-lg); font-weight:var(--fw-semi); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:none; flex-shrink:0; }
/* UI 审计 视觉 S2：关闭按钮 padding 扩点击区（64+24=88rpx），负 margin 抵消视觉占位 */
.mm-close { position:absolute; top:20rpx; right:20rpx; width:64rpx; height:64rpx; padding:12rpx; margin:-12rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; }
.mm-close:active { background:var(--accent-dim); }
.mm-close-icon { width:36rpx; height:36rpx; opacity:0.5; }
/* 家庭结构可编辑性：成员删除按钮（右侧红字，弱化视觉与"编辑"区分） */
.mm-del { font-size:var(--fs-caption); color:var(--red); padding:var(--sp-2) var(--sp-3); border-radius:var(--r-full); }
.mm-del:active { background:var(--red-dim); }

/* ========== FAB 栏（页面层，position:fixed 可靠） ========== */
/* 流式吸底：page 固定 100vh + scroll-view flex:1，FAB 栏正常流在底部（避免 fixed 在 scroll-view 页面的兼容问题）
   面板展开时输入栏须浮于遮罩(--z-overlay:90)/面板(--z-panel:100)之上，否则被遮罩盖住导致"输入区域消失"；
   110 < --z-sheet:200，保单/成员 Sheet 打开时仍正常压住 FAB 栏 */
.fab-wrap { position:relative; z-index:110; flex-shrink:0; background:var(--bg-surface); padding-bottom:0px; padding-bottom:env(safe-area-inset-bottom); border-top:1rpx solid var(--border); box-shadow:var(--shadow-sheet); }
.fab-bar { padding:var(--sp-4) var(--sp-5) }
.fab-inner { display:flex; align-items:center; height:88rpx; padding:0 var(--sp-1) }
.fab-upload { width:88rpx; height:88rpx; border-radius:50%; background:linear-gradient(135deg, var(--accent-deep) 0%, #6A5425 100%); box-shadow:0 8rpx 24rpx rgba(201,169,110,0.3); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform var(--dur-fast) var(--ease-out) }
.fab-upload:active { transform:scale(0.92); opacity:0.9 }
.fab-upload-icon { width:44rpx; height:44rpx; filter:brightness(0) invert(1) }
.fab-input { flex:1; height:88rpx; margin:0 var(--sp-3); background:var(--bg-input); border-radius:var(--r-full); display:flex; align-items:center; padding:0 var(--sp-5); }
.fab-real-input { width:100%; height:100%; font-size:var(--fs-body); color:var(--text-primary) }
.fab-send { width:88rpx; height:88rpx; border-radius:var(--r-full); background:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform var(--dur-fast) var(--ease-out); }
.fab-send:not(.is-disabled):active { transform:scale(0.92); }
.fab-send.is-disabled { background:var(--accent-muted); box-shadow:none; }
/* UI 审计 #②：accent 白字不达标改深色；禁用态白字 1.47:1 提升为 --text-disabled（2.25:1，禁用控件 WCAG 豁免） */
/* UI 打磨：去掉 rotate(-90deg)（文本箭头旋转 iOS 渲染锯齿），水平 → 直发 */
.fab-arrow { font-size:var(--fs-body); color:var(--text-primary); font-weight:var(--fw-bold); line-height:var(--lh-none); display:inline-block; }
.fab-send.is-disabled .fab-arrow { color:var(--text-disabled); }




.loading { display:flex; justify-content:center; padding-top:var(--sp-6) }
.loading-text { text-align:center; font-size:var(--fs-caption); color:var(--text-secondary); margin-top:var(--sp-5); animation:fadeIn var(--dur-slow) var(--ease-out) 0.5s both; }

/* UI 审计 R-S1：加载失败错误态（含重试/返回首页出口） */
.load-error { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:0 var(--sp-7); }
.load-error-title { font-family:var(--font-serif); font-size:var(--fs-2xl); font-weight:var(--fw-semi); color:var(--text-primary); margin-bottom:var(--sp-3); }
.load-error-sub { font-size:var(--fs-caption); color:var(--text-tertiary); margin-bottom:var(--sp-7); }
.load-error-btn { width:320rpx; height:88rpx; background:var(--accent); color:var(--btn-text-on-accent); font-size:var(--fs-base); font-weight:var(--fw-semi); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; border:none; margin-bottom:var(--sp-3); }
.load-error-btn::after { border:none }
.load-error-btn--ghost { background:var(--bg-card); color:var(--text-secondary); border:1rpx solid var(--border); }

/* UI 审计 状态 S3：深度分析取消弹层 */
.analysis-mask { position:fixed; inset:0; background:var(--overlay-inner); z-index:300; display:flex; align-items:center; justify-content:center; }
.analysis-card { width:520rpx; background:var(--bg-card); border-radius:var(--r-xl); padding:var(--sp-8) var(--sp-7); display:flex; flex-direction:column; align-items:center; gap:var(--sp-3); }
.analysis-spinner { width:56rpx; height:56rpx; border:6rpx solid var(--border); border-top-color:var(--accent); border-radius:50%; animation:spin 0.9s linear infinite; }
.analysis-title { font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); }
.analysis-sec { font-size:var(--fs-caption); color:var(--text-tertiary); }
.analysis-cancel { margin-top:var(--sp-4); background:var(--bg-card); color:var(--text-secondary); border:1rpx solid var(--border); font-size:var(--fs-base); width:240rpx; height:80rpx; display:flex; align-items:center; justify-content:center; border-radius:var(--r-lg); }
.analysis-cancel::after { border:none }

/* readiness 门禁（2026-08）：深度分析前置检查清单（对齐 analysis 弹层视觉语言，token 驱动深色自适应） */
.readiness-mask { position:fixed; inset:0; background:var(--overlay-inner); z-index:300; display:flex; align-items:center; justify-content:center; }
.readiness-card { width:560rpx; max-height:80vh; background:var(--bg-card); border-radius:var(--r-xl); padding:var(--sp-8) var(--sp-7); display:flex; flex-direction:column; gap:var(--sp-3); }
.readiness-title { font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); text-align:center; }
.readiness-sub { font-size:var(--fs-caption); color:var(--text-tertiary); text-align:center; }
.readiness-body { flex:1; min-height:0; max-height:48vh; margin-top:var(--sp-2); }
.rd-dim { margin-bottom:var(--sp-4); }
.rd-dim-head { display:flex; align-items:center; gap:var(--sp-2); padding:var(--sp-2) 0; border-bottom:1rpx solid var(--border); }
.rd-dim-status { font-size:var(--fs-base); width:40rpx; text-align:center; }
.rd-ok { color:var(--text-tertiary); }
/* 2026-09-12 可访问性：--accent(#C9A96E) 白底对比度仅 2.24:1（AA 需 4.5:1），换 --accent-deep
   (#8B6F3C)=4.58:1 达标——项目本就收敛出 *-deep 专供文字，这里此前漏用。 */
.rd-warn { color:var(--accent-deep); }
.rd-block { color:var(--accent-deep); font-weight:var(--fw-bold); }
.rd-dim-title { font-size:var(--fs-base); font-weight:var(--fw-semi); color:var(--text-primary); }
.rd-dim-count { margin-left:auto; font-size:var(--fs-caption); color:var(--text-tertiary); }
.rd-item { display:flex; align-items:center; justify-content:space-between; padding:var(--sp-2) 0; }
.rd-item-label { font-size:var(--fs-base); color:var(--text-secondary); }
.rd-fix { position:relative; background:var(--bg-card); color:var(--accent-deep); border:1rpx solid var(--accent-deep); font-size:var(--fs-caption); height:56rpx; line-height:56rpx; padding:0 var(--sp-4); border-radius:var(--r-full); margin:0; }
/* 触控热区：原 56rpx（28px）低于 88rpx 基准；伪元素透明外扩（保留 button 默认边框的 border:none 复位） */
.rd-fix::after { content:''; position:absolute; border:none; left:-12rpx; right:-12rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.readiness-actions { display:flex; flex-direction:column; gap:var(--sp-2); margin-top:var(--sp-3); }
.rd-btn { height:84rpx; border-radius:var(--r-lg); font-size:var(--fs-base); display:flex; align-items:center; justify-content:center; margin:0; }
.rd-btn--primary { background:var(--accent); color:var(--btn-text-on-accent); }
.rd-btn--primary::after { border:none }
.rd-btn--disabled { background:var(--bg-disabled); color:var(--text-disabled); }
.rd-btn--disabled::after { border:none }
.rd-btn--ghost { background:var(--bg-card); color:var(--text-secondary); border:1rpx solid var(--border); }
.rd-btn--ghost::after { border:none }

/* 画像确认（2026-08-30）：显著核对提示 + 成员/财务/保障摘要 */
.readiness-warn { background:var(--amber-dim); border:1rpx solid var(--border-accent); border-radius:var(--r-md); padding:var(--sp-3) var(--sp-4); }
.readiness-warn-text { font-size:var(--fs-caption); color:var(--amber-deep); line-height:var(--lh-body); }
.rd-member { padding:var(--sp-2) 0; border-bottom:1rpx solid var(--border); display:flex; flex-direction:column; gap:var(--sp-1); }
.rd-member-name { font-size:var(--fs-base); color:var(--text-primary); font-weight:var(--fw-medium); }
.rd-member-sub { font-size:var(--fs-caption); color:var(--text-tertiary); }
.rd-fin-row { display:flex; align-items:center; justify-content:space-between; padding:var(--sp-2) 0; }
.rd-fin-label { font-size:var(--fs-base); color:var(--text-secondary); }
.rd-fin-val { font-size:var(--fs-base); color:var(--text-primary); font-weight:var(--fw-semi); }
.rd-fin--missing { color:var(--amber-deep); }
.rd-empty { font-size:var(--fs-caption); color:var(--text-tertiary); padding:var(--sp-2) 0; }
.rd-gap { margin-top:var(--sp-2); padding-top:var(--sp-2); border-top:1rpx solid var(--border); }
.rd-gap-title { font-size:var(--fs-caption); color:var(--amber-deep); font-weight:var(--fw-semi); display:block; padding:var(--sp-2) 0; }

/* 深度分析（AI 专家解读，2026-08-30：纯展示无操作入口） */
.deep-analysis { margin:var(--sp-6) var(--sp-5); padding:var(--sp-6) var(--sp-5); background:var(--bg-card); border-radius:var(--r-xl); border:1rpx solid var(--border); box-shadow:var(--shadow-sm); }
.deep-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--sp-4); }
.deep-title { font-family:var(--font-serif); font-size:var(--fs-xl); font-weight:var(--fw-normal); color:var(--text-primary); letter-spacing:var(--ls-wide); }
.deep-badge { font-size:var(--fs-tiny); color:var(--accent-deep); background:var(--accent-dim); padding:var(--sp-1) var(--sp-3); border-radius:var(--r-full);
  /* V1.5：deep-head 内新增语气切换后，badge 用 auto 外边距保持右对齐（子元素 2 个或 3 个时视觉一致） */
  margin-left:auto; }
/* V1.5 语气切换（2026-09-12）：owner 可见；触控热区由伪元素外扩至 ≥88rpx */
.deep-tone { position:relative; font-size:var(--fs-tiny); color:var(--text-tertiary); margin-left:var(--sp-3); flex-shrink:0; }
.deep-tone::after { content:''; position:absolute; left:-20rpx; right:-20rpx; top:50%; height:88rpx; transform:translateY(-50%); }
.deep-tone:active { opacity:0.6 }
/* V1.5 隐私说明（2026-09-12）：核对弹窗内明确数据用途与隔离方式，降低敏感信息录入抵触 */
.readiness-privacy { font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-body); padding:var(--sp-3) 0 0; }
.deep-insights { display:flex; flex-direction:column; gap:var(--sp-3); margin-bottom:var(--sp-4); }
.deep-insight { display:flex; gap:var(--sp-2); padding:var(--sp-4); background:var(--accent-dim); border-radius:var(--r-lg); border-left:4rpx solid var(--accent); }
.deep-insight-text { font-size:var(--fs-base); color:var(--text-primary); line-height:var(--lh-body); }
.deep-sec { margin-bottom:var(--sp-4); }
.deep-sec-title { font-size:var(--fs-base); font-weight:var(--fw-semi); color:var(--text-secondary); margin-bottom:var(--sp-3); padding-left:var(--sp-3); border-left:4rpx solid var(--accent); }
.deep-disclaimer { font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-body); margin-top:var(--sp-2); }
/* 深度分析可选项（2026-09-02）：未生成入口卡 + 折叠摘要 + 展开/收起 */
.deep-entry { margin:var(--sp-6) var(--sp-5); padding:var(--sp-6) var(--sp-5); background:var(--bg-card); border-radius:var(--r-xl); border:1rpx dashed var(--accent); box-shadow:var(--shadow-sm); }
.deep-entry-desc { display:block; font-size:var(--fs-base); color:var(--text-secondary); line-height:var(--lh-body); margin-bottom:var(--sp-4); }
.deep-entry-btn { background:var(--accent); color:var(--btn-text-on-accent); border-radius:var(--r-lg); font-size:var(--fs-base); font-weight:var(--fw-medium); }
.deep-entry-btn::after { border:none; }
.deep-fold { display:flex; align-items:center; justify-content:space-between; gap:var(--sp-3); margin-top:var(--sp-2); }
.deep-fold-tip { flex:1; font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-body); }
.deep-fold-btn, .deep-act-btn { background:var(--accent); color:var(--btn-text-on-accent); border-radius:var(--r-lg); font-size:var(--fs-base); font-weight:var(--fw-medium); margin:0; padding:0 var(--sp-4); height:64rpx; line-height:64rpx; display:inline-flex; align-items:center; }
.deep-fold-btn::after, .deep-act-btn::after { border:none; }
.deep-actions { display:flex; justify-content:flex-end; gap:var(--sp-3); margin-top:var(--sp-3); }
.deep-act-btn--ghost { background:var(--bg-surface); color:var(--text-secondary); border:1rpx solid var(--border); }

/* 骨架屏 — 圆角与真实卡片一致 */
.skeleton-wrap { width:100%; padding:0 var(--sp-5); }
.sk-title-bar { display:flex; align-items:center; justify-content:space-between; padding:var(--sp-5) 0 var(--sp-3); }
.sk-title { width:55%; height:40rpx; border-radius:var(--r-sm); }
.sk-btn { width:56rpx; height:56rpx; border-radius:50%; }
.sk-summary { width:100%; height:88rpx; border-radius:var(--r-2xl); margin:var(--sp-2) 0; }
.sk-block-card { width:100%; height:200rpx; border-radius:var(--r-lg); margin-bottom:var(--sp-4-5); }
.sk-shimmer { background:linear-gradient(90deg,var(--bg-input) 25%,var(--accent-dim) 37%,var(--bg-input) 63%); background-size:400% 100%; animation:shimmer 1.8s ease infinite; }

/* 2026-09-06 宽屏行宽约束：PC/平板微信下报告正文区限宽居中，长文行宽回到舒适区（手机 <768px 不受影响） */
/* 2026-09-12 修复：原名单漏掉 V1.5 新增的三块（.facts-card/.preview-entry/.feedback-row）→
   它们在 720px 正文两侧"鼓出来"，其中 .facts-card 夹在两张限宽卡片中间最明显；
   同时删除 .hints 死名（区块已按审计 C4 删除，见 wxml 注释，规则本体亦无残留）。
   .preview-bar 有意不在名单：已改为页面级全宽模式提示条（见其规则注释）。 */
@media (min-width: 768px) {
  .title-bar, .title-divider, .summary-card, .empty-report,
  .deep-entry, .deep-analysis, .deep-clarify, .report-disclaimer, .report-footer,
  .facts-card, .preview-entry, .feedback-row {
    width: 720px; max-width: calc(100vw - 96px); box-sizing: border-box;
    margin-left: auto; margin-right: auto;
  }
}

/* UI 审计 P1：暗色下 FAB 栏图标/箭头不可见（--accent 变浅金 #D4B87E，白图标 1.3:1 / 箭头 1.45:1）
   覆盖为固定深金渐变 + 深色箭头（与 app.wxss .fab 暗色覆盖一致） */
@media (prefers-color-scheme: dark) {
  .fab-upload { background: linear-gradient(135deg, #8B6F3C 0%, #6A5425 100%); }
  .fab-send { background: #8B6F3C; }
  .fab-send.is-disabled { background: var(--accent-muted); }
  .fab-arrow { color: var(--color-on-accent); }
}
