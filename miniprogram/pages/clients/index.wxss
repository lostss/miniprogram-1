.page { min-height:100vh; background:var(--bg-root); padding:0 var(--sp-6) calc(var(--sp-6) + env(safe-area-inset-bottom)); box-sizing:border-box; }
.search-bar { position:sticky; top:0; z-index:10; background:var(--bg-root); padding:var(--sp-4) 0; margin:0 -0rpx; }
.search-input { width:100%; height:88rpx; background:var(--bg-surface); border-radius:var(--r-xl); padding:0 var(--sp-6); font-size:var(--fs-base); box-sizing:border-box; box-shadow:var(--shadow-sm); border:2rpx solid transparent; transition:border-color var(--dur-fast) var(--ease-out); }
.search-input:focus { border-color:var(--accent); }

/* 空状态：与首页一致的卡片式流程插图 */
.empty { display:flex; flex-direction:column; align-items:center; padding-top:160rpx }
.empty-illu { display:flex; align-items:center; gap:var(--sp-4); margin-bottom:var(--sp-8) }
.empty-step { width:88rpx; height:88rpx; background:var(--bg-surface); border:1rpx solid var(--border); border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-sm); }
.empty-step-icon { width:48rpx; height:48rpx; opacity:0.35 }
.empty-arrow { font-size:var(--fs-caption); color:var(--accent-muted); letter-spacing:var(--ls-wider) }
.empty-text { font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary) }
.empty-sub { font-size:var(--fs-caption); color:var(--text-tertiary); margin-top:var(--sp-3); letter-spacing:var(--ls-wide) }

/* 加载提示 */
.loading-hint { text-align:center; font-size:var(--fs-caption); color:var(--text-tertiary); padding:var(--sp-6) 0; display:flex; align-items:center; justify-content:center; gap:var(--sp-3) }
.loading-pulse { width:12rpx; height:12rpx; border-radius:50%; background:var(--accent); animation:pulse 1.2s var(--ease-out) infinite }
