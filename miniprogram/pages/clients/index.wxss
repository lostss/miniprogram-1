/* ========== 页面容器 ========== */
.page { min-height:100vh; background:var(--bg-root); padding:0 var(--sp-6) calc(var(--sp-6) + env(safe-area-inset-bottom)); box-sizing:border-box }

/* ========== 搜索栏 ========== */
.search-bar { position:sticky; top:0; z-index:10; background:var(--bg-root); padding:var(--sp-4) 0 }
.search-wrap { position:relative }
.search-input { width:100%; height:72rpx; background:var(--bg-surface); border-radius:var(--r-xl); padding:0 64rpx 0 var(--sp-5); font-size:var(--fs-base); box-sizing:border-box; border:1rpx solid transparent; transition:border-color var(--dur-fast) var(--ease-out) }
.search-input:focus { border-color:var(--accent) }
.search-clear { position:absolute; right:var(--sp-3); top:50%; transform:translateY(-50%); width:48rpx; height:48rpx; display:flex; align-items:center; justify-content:center; font-size:24rpx; color:var(--text-tertiary); border-radius:50% }
.search-clear:active { background:var(--bg-input) }

/* ========== 卡片间距 ========== */
.card-wrap { margin-bottom:var(--sp-4) }
.card-removing { animation:fadeOut 0.25s var(--ease-out) forwards; pointer-events:none }
@keyframes fadeOut {
  from { opacity:1; transform:scale(1) }
  to { opacity:0; transform:scale(0.95) }
}

/* ========== 加载提示 ========== */
.loading-hint { text-align:center; padding:var(--sp-6) 0 }
.loading-pulse { display:inline-block; width:12rpx; height:12rpx; border-radius:50%; background:var(--accent); animation:pulse 1.2s var(--ease-out) infinite }

/* ========== 空状态 ========== */
.empty { display:flex; flex-direction:column; align-items:center; padding-top:160rpx }
.empty-text { font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary) }
.empty-sub { font-size:var(--fs-caption); color:var(--text-tertiary); margin-top:var(--sp-3); letter-spacing:var(--ls-wide) }
.empty-btn { margin-top:var(--sp-8); height:80rpx; padding:0 var(--sp-8); background:var(--accent); color:var(--color-on-accent); font-size:var(--fs-base); font-weight:var(--fw-semi); border-radius:var(--r-full); display:flex; align-items:center; justify-content:center; border:none }
.empty-btn::after { border:none }
