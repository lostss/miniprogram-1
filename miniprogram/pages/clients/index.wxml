<!-- 客户列表页 v2.0 -->
<view class="page page-view">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrap">
      <!-- 2026-09-12：文案修正——服务端是双路匹配（family_name + 成员 name），原"搜索客户姓名"低估了能力 -->
      <input class="search-input" value="{{keyword}}" placeholder="搜索客户或成员姓名" bindinput="onSearch" aria-label="搜索客户" />
      <view class="search-clear pressable" wx:if="{{keyword}}" bindtap="onClearSearch">✕</view>
    </view>
    <!-- 2026-09-12 显式建档入口：无保单也能建客户（第一次见面、还没拿到保单时最需要） -->
    <view class="create-btn pressable" bindtap="onCreateFamily" aria-label="新建客户">＋</view>
  </view>

  <!-- 加载中：骨架屏（UI 审计 状态 M5：与首页 sk-client-card 风格统一） -->
  <block wx:if="{{loading}}">
    <view class="sk-client-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-ring"></view>
      <view class="sk-body">
        <view class="sk-row"><view class="sk-name sk-shimmer"></view></view>
        <view class="sk-row"><view class="sk-label sk-shimmer"></view><view class="sk-label sk-shimmer" style="margin-left:16rpx"></view></view>
        <view class="sk-time sk-shimmer"></view>
      </view>
    </view>
  </block>

  <!-- 列表 -->
  <view class="card-wrap {{removingId === item._id ? 'card-removing' : ''}}" wx:for="{{families}}" wx:key="_id" wx:for-index="idx">
    <client-card client="{{item}}" bindtap="onClientTap" bind:longpress="onClientLongPress" data-idx="{{idx}}" />
  </view>

  <!-- 审计 P2-16：listFamilies 上限 100，超出时明示（原静默截断，用户以为客户只有这些） -->
  <view class="empty-sub" wx:if="{{!loading && truncated}}" style="padding:var(--sp-4) 0">已显示前 100 位客户，可搜索客户或成员姓名精确查找</view>

  <!-- 错误态：加载失败优先于搜索空态（客户列表审计 P1-1：网络/数据库失败不伪装"未找到"） -->
  <view class="empty" wx:if="{{!loading && families.length === 0 && loadError}}">
    <text class="empty-text">加载失败</text>
    <text class="empty-sub">请检查网络后重试</text>
    <button class="empty-btn pressable" bindtap="onRetryLoad">重新加载</button>
  </view>

  <!-- 空态：搜索无结果 -->
  <view class="empty" wx:elif="{{!loading && families.length === 0 && keyword}}">
    <text class="empty-text">未找到"{{keyword}}"</text>
    <text class="empty-sub">换个关键词试试</text>
  </view>

  <!-- 空态：无任何客户 -->
  <view class="empty" wx:elif="{{!loading && families.length === 0}}">
    <text class="empty-text">尚无客户档案</text>
    <text class="empty-sub">拍照上传保单自动建档，也可直接手动新建</text>
    <button class="empty-btn pressable" bindtap="onGoUpload">去首页上传</button>
    <button class="empty-btn empty-btn--ghost pressable" bindtap="onCreateFamily">手动新建客户</button>
  </view>
</view>
