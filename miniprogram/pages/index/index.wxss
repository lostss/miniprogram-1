/* ========== 页面容器 ========== */
/* 底部留白须躲开吸底按钮条。2026-10-17 起 .create-bar 为 fixed 一行：
   padding --sp-4 + 按钮 96rpx + --sp-4（合计约 128rpx）+ safe-area。
   原留白 176rpx（为 96rpx 圆形 FAB + 48rpx 底距预留）刚好够，且留了余量 → 不改。
   若将来调高按钮或加第二行动作，此处必须同步，否则最后一张卡的长按删除触点会落在遮挡区。
   2026-10-13 合并页：并入库列表页的 min-height:100vh + box-sizing（列表页需要撑满视口底色）。 */
.page { min-height:100vh; box-sizing:border-box; background:var(--bg-root); padding:0 var(--sp-6); padding-bottom:calc(176rpx + env(safe-area-inset-bottom)) }
/* 2026-09-22 修复（UX 审计 P2）：原 `overflow:hidden` 在空态把超出视口的内容直接**裁掉且无法滚动**
   （空态实测约 780rpx 起：brand-header 120 + 上传框 200 + 步骤 80 + 提示 100 + 新增建档入口 88+48），
   系统大字号/小屏机型下底部内容不可达。改为可滚动（无溢出时行为与原来一致）。 */
.page-fixed { overflow-y:auto; -webkit-overflow-scrolling:touch }

/* ========== 品牌头 ========== */
/* 2026-10-17：副标题移除（产品名已自解释）→ .brand-slogan 规则一并删除。
   只剩一行标题，下边距由 --sp-7 收到 --sp-6：原间距是给"标题+副标题"两行留的呼吸感，
   单行时留 40rpx 会显得标题与列表脱开。 */
.brand-header { padding-top:var(--sp-13); padding-bottom:var(--sp-6) }
.brand-title { font-family:var(--font-serif); font-size:var(--fs-display); font-weight:var(--fw-normal); color:var(--text-primary); letter-spacing:var(--ls-wide); line-height:var(--lh-tight) }

/* ========== 搜索栏（2026-10-13 合并自客户列表页）========== */
/* 2026-10-17：右侧「＋」已移除（新建客户统一到底部吸底按钮）→ 搜索框独占整行。
   flex 保留：.search-wrap 用 flex:1 撑满，清除按钮 absolute 定位于其内部。 */
.search-bar { position:sticky; top:0; z-index:10; background:var(--bg-root); padding:var(--sp-4) 0; display:flex; align-items:center; gap:var(--sp-3) }
.search-wrap { position:relative; flex:1; min-width:0 }
.search-input { width:100%; height:72rpx; background:var(--bg-surface); border-radius:var(--r-xl); padding:0 64rpx 0 var(--sp-5); font-size:var(--fs-base); box-sizing:border-box; border:1rpx solid transparent; transition:border-color var(--dur-fast) var(--ease-out) }
.search-input:focus { border-color:var(--accent) }
/* UI 审计 视觉 S2：清除按钮 padding 扩点击区；去固定宽高（content-box 下 48+24*2=96rpx 盒，✕ 居中于 96rpx 中心=偏下 12rpx） */
.search-clear { position:absolute; right:var(--sp-3); top:50%; transform:translateY(-50%); padding:24rpx; display:flex; align-items:center; justify-content:center; font-size:var(--fs-caption); line-height:1; color:var(--text-tertiary); border-radius:50% }
.search-clear:active { background:var(--bg-input) }

/* ========== 空态建档引导 ========== */
.orb-stage { display:flex; flex-direction:column; align-items:center; padding-top:80rpx; transition:opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out) }
.upload-box { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:var(--sp-5); width:280rpx; height:200rpx; border:2rpx dashed var(--border-accent); border-radius:var(--r-xl); background:var(--bg-surface); transition:border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out) }
.upload-box:active { border-color:var(--accent); background:var(--accent-dim) }
.upload-box-icon { width:56rpx; height:56rpx }
/* 2026-10-13：入口为"新建客户"（上传移入客户详情页）——不加新图标资源，
   沿用既有视觉容器，用文字"＋"承担图标语义（与搜索栏 ＋ 一致） */
.upload-box-plus { font-size:64rpx; line-height:1; color:var(--accent-deep, #8B6F3C) }
.upload-box-text { font-size:var(--fs-base); color:var(--text-tertiary); letter-spacing:var(--ls-wide) }
.onboard-steps { display:flex; align-items:center; margin-top:80rpx; gap:0 }
.ob-step { display:flex; flex-direction:column; align-items:center; gap:var(--sp-3) }
.ob-step-num { width:56rpx; height:56rpx; border-radius:50%; background:var(--bg-surface); border:1rpx solid var(--border); display:flex; align-items:center; justify-content:center; font-family:var(--font-serif); font-size:var(--fs-body); color:var(--text-tertiary) }
.ob-step-text { font-size:var(--fs-caption); color:var(--text-tertiary); letter-spacing:var(--ls-wide) }
.ob-step-line { width:48rpx; height:1rpx; background:var(--border); margin-bottom:28rpx }

/* UI 审计 R-M5：加载错误态（空态下替代建档引导，不伪装"尚无客户"） */
.load-error { display:flex; flex-direction:column; align-items:center; gap:var(--sp-3); margin-top:var(--sp-6) }
.load-error-text { font-size:var(--fs-caption); color:var(--text-tertiary) }
.load-error-retry { font-size:var(--fs-caption); color:var(--accent-deep); padding:var(--sp-2) var(--sp-5); border:1rpx solid var(--border-accent); border-radius:var(--r-full) }

/* ========== 新建客户弹窗（2026-10-17）========== */
/* 遮罩：点遮罩不关闭（JS 里 onCreateMaskTap 为空实现）—— 表单类弹窗防误触丢输入。
   层级 300 高于吸底条（--z-panel:100），否则按钮会浮在遮罩上被误点。 */
.cf-mask { position:fixed; inset:0; z-index:300; background:var(--overlay-inner); display:flex; align-items:center; justify-content:center; padding:0 var(--sp-7) }
/* 弹窗不设固定高度：键盘弹起时 adjust-position 会把整卡上推，写死高度会裁掉底部按钮 */
.cf-card { width:100%; max-width:600rpx; background:var(--bg-card); border-radius:var(--r-xl); padding:var(--sp-8) var(--sp-7) var(--sp-7); box-shadow:0 16rpx 48rpx rgba(0,0,0,0.16) }
.cf-title { font-family:var(--font-serif); font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary); letter-spacing:var(--ls-wide); margin-bottom:var(--sp-6) }

/* 名称输入：72rpx 输入框与搜索框同高（同一页面的两种输入不该有不同手感） */
.cf-input { width:100%; height:80rpx; box-sizing:border-box; padding:0 var(--sp-5); background:var(--bg-input); border:1rpx solid transparent; border-radius:var(--r-md); font-size:var(--fs-body); color:var(--text-primary) }
/* 错误态用边框 + 文案双重标记：只改边框时，色弱用户看不出区别 */
.cf-input.is-error { border-color:#B00020 }
.cf-ph { color:var(--text-tertiary) }
.cf-error { margin-top:var(--sp-2); font-size:var(--fs-caption); color:#B00020 }

.cf-row { display:flex; align-items:center; justify-content:space-between; margin-top:var(--sp-6) }
.cf-label { font-size:var(--fs-base); color:var(--text-primary) }
.cf-stepper { display:flex; align-items:center; gap:var(--sp-4); background:var(--bg-input); border-radius:var(--r-full); padding:var(--sp-1) var(--sp-2) }
/* 步进器：56rpx 视觉 + 伪元素把热区扩到 88rpx（全站最小触点基线）。
   2026-10-18 修（审计 P1）：上一版注释就写着"凑够 88rpx 热区"，但**代码里没有 ::after** ——
   实际点按区只有 28px，是漏网的小触点。注释与实现不一致比没注释更贵，这里补齐。 */
.cf-step { position:relative; width:56rpx; height:56rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--bg-card); color:var(--accent-deep); font-size:var(--fs-lg); line-height:1 }
.cf-step::after { content:''; position:absolute; left:50%; top:50%; width:88rpx; height:88rpx; transform:translate(-50%,-50%) }
.cf-step.is-off { color:var(--text-tertiary); opacity:0.5 }
.cf-count { min-width:120rpx; text-align:center; font-size:var(--fs-base); color:var(--text-primary); font-variant-numeric:tabular-nums }
.cf-count.is-empty { color:var(--text-tertiary); font-size:var(--fs-caption) }
.cf-hint { margin-top:var(--sp-3); font-size:var(--fs-tiny); color:var(--text-tertiary); line-height:var(--lh-snug) }

/* 按钮行：取消弱化（左）、创建为主（右）—— 与报告页各弹窗的操作区顺序一致 */
.cf-actions { display:flex; gap:var(--sp-4); margin-top:var(--sp-8) }
.cf-btn { flex:1; height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:var(--r-full); font-size:var(--fs-base); font-weight:var(--fw-semi); letter-spacing:var(--ls-wide) }
.cf-btn--ghost { background:transparent; color:var(--text-secondary); border:1rpx solid var(--border) }
.cf-btn--primary { background:var(--accent); color:var(--btn-text-on-accent) }
.cf-btn.is-disabled, .cf-btn.is-loading { opacity:0.55 }

/* ========== 吸底「新建客户」按钮条（2026-10-17 替代右下角 FAB）========== */
/* 底衬用自上而下的渐变收边（不是实色块）：列表滚到底时卡片从按钮条后透出，
   既保证文字对比度，又不切出一条生硬的白色横条。 */
.create-bar { position:fixed; left:0; right:0; bottom:0; padding:var(--sp-4) var(--sp-6) calc(var(--sp-4) + env(safe-area-inset-bottom));
  background:linear-gradient(to top, var(--bg-root) 72%, transparent);
  z-index:var(--z-panel); transform:translateY(120%); opacity:0;
  transition:transform 0.32s var(--ease-spring), opacity 0.22s var(--ease-out); pointer-events:none }
.create-bar--show { transform:translateY(0); opacity:1; pointer-events:auto }
.create-bar-btn { width:100%; height:96rpx; display:flex; align-items:center; justify-content:center; gap:var(--sp-2);
  background:linear-gradient(135deg, var(--accent-deep) 0%, #6A5425 100%); color:var(--color-on-accent, #FFFFFF);
  font-size:var(--fs-base); font-weight:var(--fw-semi); letter-spacing:var(--ls-wide);
  border:none; border-radius:var(--r-full); box-shadow:0 6rpx 20rpx var(--accent-glow); line-height:1 }
/* 原生 button 的 ::after 默认画 1px 边框，必须清掉，否则与圆角错位 */
.create-bar-btn::after { border:none }
.create-bar-btn:active { opacity:0.9; transform:scale(0.985) }
/* 暗色对比度：暗色下 --accent-deep 变亮金，白字对比度跌到 2.2:1 → 固定深金渐变。
   ⚠️ 必须写在本文件（不是 app.wxss）：同优先级下页面 wxss 后于全局生效，
   放全局会被上面的 background 简写整条覆盖 —— 原 .fab 的暗色覆盖就是这么失效的。 */
@media (prefers-color-scheme: dark) {
  .create-bar-btn { background:linear-gradient(135deg, #8B6F3C 0%, #6A5425 100%) }
}

/* ========== 列表 ========== */
.client-stagger { margin-bottom:var(--sp-4); animation:cardUp var(--dur-slow) var(--ease-out) both }
.client-stagger:nth-child(1) { animation-delay:0s }
.client-stagger:nth-child(2) { animation-delay:0.08s }
.client-stagger:nth-child(3) { animation-delay:0.16s }
.card-removing { animation:fadeOut 0.25s var(--ease-out) forwards; pointer-events:none }
@keyframes fadeOut {
  from { opacity:1; transform:scale(1) }
  to { opacity:0; transform:scale(0.95) }
}

/* ========== 骨架屏 ========== */
/* UI 审计：骨架屏边框 rgba(0,0,0,0.04) 统一为 --border token（暗色模式适配） */
.sk-client-card { display:flex; align-items:center; padding:var(--sp-5) var(--sp-5) var(--sp-5) 0; margin-bottom:var(--sp-4); background:var(--bg-card); border-radius:var(--r-xl); border:1rpx solid var(--border) }
.sk-body { flex:1; min-width:0; padding-left:var(--sp-5) }
.sk-row { display:flex; align-items:baseline; line-height:var(--lh-snug); margin-bottom:var(--sp-3) }
.sk-shimmer { background:var(--border) }
.sk-name { display:inline-block; width:120rpx; height:28rpx; border-radius:6rpx }
.sk-label { display:inline-block; width:60rpx; height:22rpx; border-radius:6rpx; margin-left:var(--sp-3) }
.sk-time { display:block; width:160rpx; height:20rpx; border-radius:6rpx }
/* 2026-10-17：.sk-ring 随圆环一起移除（骨架屏必须与真实卡片同构，否则加载完成后高度跳动） */

/* ========== 空状态（搜索无结果 / 截断提示）========== */
/* 说明：原客户列表页的 .empty-btn / .empty-btn--ghost（"去首页上传"/"手动新建客户"）未随合并带入 ——
   合并后无客户时由 .orb-stage 的建档引导承担主入口，搜索无结果只提示换词，无按钮。 */
.empty { display:flex; flex-direction:column; align-items:center; padding-top:160rpx }
.empty-text { font-size:var(--fs-lg); font-weight:var(--fw-semi); color:var(--text-primary); font-family:var(--font-serif); letter-spacing:var(--ls-wide); }
.empty-sub { font-size:var(--fs-caption); color:var(--text-tertiary); margin-top:var(--sp-3); letter-spacing:var(--ls-wide) }

/* ========== 列表尾部口径提示（2026-10-17）========== */
/* 长按删除是隐式手势，此前无任何文字说明；同时给出客户总数。
   刻意做到最弱：tiny + tertiary + 居中，只在滚到底时被读到，不参与首屏竞争。 */
.list-foot { font-size:var(--fs-tiny); color:var(--text-tertiary); text-align:center; letter-spacing:var(--ls-wide); padding:var(--sp-8) 0 var(--sp-3) }
