/* ========== 页面容器 ========== */
.page { background:var(--bg-root); padding:0 var(--sp-6); padding-bottom:calc(120rpx + env(safe-area-inset-bottom)) }
.page-fixed { overflow:hidden }

/* ========== 品牌头 ========== */
.brand-header { padding-top:80rpx; padding-bottom:var(--sp-7) }
.brand-title { font-family:var(--font-serif); font-size:var(--fs-display); font-weight:var(--fw-normal); color:var(--text-primary); letter-spacing:var(--ls-wide); line-height:var(--lh-tight) }
.brand-slogan { font-family:var(--font-serif); font-size:var(--fs-tiny); color:var(--text-tertiary); margin-top:var(--sp-3); letter-spacing:6rpx }

/* ========== 空态上传引导 ========== */
.orb-stage { display:flex; flex-direction:column; align-items:center; padding-top:80rpx; transition:opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out) }
.orb-stage--done { opacity:0; transform:translateY(-20rpx); pointer-events:none; height:0; overflow:hidden; padding-top:0; margin:0 }
.upload-box { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:var(--sp-5); width:280rpx; height:200rpx; border:2rpx dashed var(--border-accent); border-radius:var(--r-xl); background:var(--bg-surface); transition:border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out) }
.upload-box:active { border-color:var(--accent); background:var(--accent-dim) }
.upload-box-icon { width:56rpx; height:56rpx }
.upload-box-text { font-size:var(--fs-base); color:var(--text-tertiary); letter-spacing:var(--ls-wide) }
.onboard-steps { display:flex; align-items:center; margin-top:80rpx; gap:0 }
.ob-step { display:flex; flex-direction:column; align-items:center; gap:var(--sp-3) }
.ob-step-num { width:56rpx; height:56rpx; border-radius:50%; background:var(--bg-surface); border:1rpx solid var(--border); display:flex; align-items:center; justify-content:center; font-family:var(--font-serif); font-size:var(--fs-body); color:var(--text-tertiary) }
.ob-step-text { font-size:var(--fs-tiny); color:var(--text-tertiary); letter-spacing:2rpx }
.ob-step-line { width:48rpx; height:1rpx; background:var(--border); margin-bottom:28rpx }
.empty-hint { text-align:center; padding-top:100rpx }
.empty-hint text { font-size:var(--fs-tiny); color:var(--text-disabled); letter-spacing:2rpx }

/* UI 审计 R-M5：首页加载错误态 */
.load-error { display:flex; flex-direction:column; align-items:center; gap:var(--sp-3); margin-top:var(--sp-6) }
.load-error-text { font-size:var(--fs-caption); color:var(--text-tertiary) }
.load-error-retry { font-size:var(--fs-caption); color:var(--accent-deep); padding:var(--sp-2) var(--sp-5); border:1rpx solid var(--border-accent); border-radius:var(--r-full) }

/* ========== FAB ========== */
.fab { position:fixed; right:var(--sp-6); bottom:calc(var(--sp-8) + env(safe-area-inset-bottom)); width:96rpx; height:96rpx; border-radius:50%; background:linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%); box-shadow:0 8rpx 24rpx rgba(201,169,110,0.3); display:flex; align-items:center; justify-content:center; z-index:var(--z-panel); transform:scale(0); opacity:0; transition:transform 0.35s var(--ease-spring), opacity 0.25s var(--ease-out) }
.fab--show { transform:scale(1); opacity:1 }
.fab:active { transform:scale(0.92); opacity:0.9 }
.fab-icon { width:44rpx; height:44rpx; filter:brightness(0) invert(1) }

/* ========== 客户列表 ========== */
.clients-section { margin-top:var(--sp-7) }
.section-header { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:var(--sp-6) }
.section-title { font-family:var(--font-serif); font-size:var(--fs-base); font-weight:var(--fw-normal); color:var(--text-secondary); letter-spacing:var(--ls-wider) }
.section-more { display:flex; align-items:center; padding:var(--sp-2) var(--sp-4); margin:-8rpx -16rpx 0 0; font-size:var(--fs-caption); color:var(--text-tertiary) }
.section-more-arrow { margin-left:var(--sp-1); font-size:var(--fs-body) }
.client-stagger { animation:cardUp var(--dur-slow) var(--ease-out) both }
.client-stagger:nth-child(1) { animation-delay:0s }
.client-stagger:nth-child(2) { animation-delay:0.08s }
.client-stagger:nth-child(3) { animation-delay:0.16s }
.card-removing { animation:fadeOut 0.25s var(--ease-out) forwards; pointer-events:none }
@keyframes fadeOut {
  from { opacity:1; transform:scale(1) }
  to { opacity:0; transform:scale(0.95) }
}

/* ========== 骨架屏 ========== */
.sk-client-card { display:flex; align-items:center; padding:var(--sp-5) var(--sp-5) var(--sp-5) 0; margin-bottom:var(--sp-5); background:var(--bg-card); border-radius:var(--r-xl); border:1rpx solid rgba(0,0,0,0.04) }
.sk-body { flex:1; min-width:0; padding-left:var(--sp-5) }
.sk-row { display:flex; align-items:baseline; line-height:var(--lh-snug); margin-bottom:var(--sp-3) }
.sk-shimmer { background:var(--border) }
.sk-name { display:inline-block; width:120rpx; height:28rpx; border-radius:6rpx }
.sk-label { display:inline-block; width:60rpx; height:22rpx; border-radius:6rpx; margin-left:var(--sp-3) }
.sk-time { display:block; width:160rpx; height:20rpx; border-radius:6rpx }
.sk-ring { width:80rpx; height:80rpx; border-radius:50%; flex-shrink:0; margin-left:var(--sp-4-5); margin-right:var(--sp-5) }
