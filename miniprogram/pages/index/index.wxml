<!-- 保小秘 首页 -->
<view class="page page-view {{recentClients.length === 0 && !loadingClients && !ocrBusy ? 'page-fixed' : ''}}">
  <!-- 品牌头 -->
  <view class="brand-header">
    <view class="brand-title">上传保单，秒出报告</view>
    <view class="brand-slogan">AI保单整理助手</view>
  </view>

  <!-- 空态：上传引导 -->
  <view class="orb-stage {{recentClients.length > 0 ? 'orb-stage--done' : ''}}" wx:if="{{!ocrBusy && !loadingClients}}">
    <view class="upload-box pressable" bindtap="onUploadTap" aria-label="拍照上传保单">
      <image class="upload-box-icon" src="/images/upload.svg" mode="aspectFit" />
      <text class="upload-box-text">点击上传保单</text>
    </view>
    <view class="onboard-steps" wx:if="{{recentClients.length === 0}}">
      <view class="ob-step">
        <view class="ob-step-num">1</view>
        <text class="ob-step-text">拍照上传保单</text>
      </view>
      <view class="ob-step-line"></view>
      <view class="ob-step">
        <view class="ob-step-num">2</view>
        <text class="ob-step-text">AI 智能识别分析</text>
      </view>
      <view class="ob-step-line"></view>
      <view class="ob-step">
        <view class="ob-step-num">3</view>
        <text class="ob-step-text">生成保障报告</text>
      </view>
    </view>
  </view>

  <!-- 客户列表 -->
  <view class="clients-section" wx:if="{{recentClients.length > 0 || loadingClients}}">
    <view class="section-header">
      <text class="section-title">最近客户</text>
      <view class="section-more pressable" bindtap="onViewAll" aria-label="查看全部客户">
        <text>全部</text>
        <text class="section-more-arrow">→</text>
      </view>
    </view>
    <block wx:if="{{loadingClients}}">
      <view class="sk-client-card" wx:for="{{3}}" wx:for-index="sk" wx:key="sk">
        <view class="sk-body">
          <view class="sk-row"><view class="sk-shimmer sk-name"></view><view class="sk-shimmer sk-label"></view></view>
          <view class="sk-shimmer sk-time"></view>
        </view>
        <view class="sk-shimmer sk-ring"></view>
      </view>
    </block>
    <block wx:else>
      <view class="client-stagger {{removingId === item._id ? 'card-removing' : ''}}" wx:for="{{recentClients}}" wx:key="_id" wx:for-index="idx">
        <client-card client="{{item}}" bindtap="onClientTap" bind:longpress="onClientLongPress" data-idx="{{idx}}" />
      </view>
    </block>
  </view>

  <!-- 空态无客户：底部提示 -->
  <view class="empty-hint" wx:if="{{recentClients.length === 0 && !ocrBusy && !loadingClients}}">
    <text>支持 JPG / PNG · 一次最多 9 张</text>
  </view>
</view>

<!-- FAB（非空态显示） -->
<view class="fab {{recentClients.length > 0 && !ocrBusy ? 'fab--show' : ''}}" bindtap="onUploadTap" aria-label="拍照上传保单">
  <image class="fab-icon" src="/images/upload.svg" mode="aspectFit" />
</view>

<!-- OCR 全流程组件 -->
<ocr-flow id="ocrFlow" bind:busychange="onOcrBusy" bind:saved="onOcrSaved" bind:savedhome="onOcrSavedHome" bind:discarded="onOcrDiscarded" />
