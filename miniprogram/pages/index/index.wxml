<!-- 客户列表（2026-10-13 合并页：原首页 + 原客户列表页合一，同时是小程序根页面）
     合并后只呈现一件事：我的客户。空态=建档引导（原首页 onboarding），非空=搜索+全量列表。
     ⚠️ ocr-flow 与 FAB 必须留在 .page 之外（见文件末尾注释）。 -->
<view class="page page-view {{families.length === 0 && !loading && !keyword && !ocrBusy ? 'page-fixed' : ''}}">
  <!-- 品牌头（2026-10-17 用户决策：主标题「家庭保单整理助手」，**副标题移除**）。
       演进：原「把散落的保单整理清楚」+「AI保单整理助手」两句同义 → 改主标题为产品名、
       把旧主标题下沉为副标题 → 再去掉副标题（产品名本身已说清是什么，列表页不需要第二行自我描述）。
       ⚠️ 副标题的 wxss 规则（.brand-slogan）一并删除，勿只删 WXML 留下死样式。 -->
  <view class="brand-header">
    <view class="brand-title">家庭保单整理助手</view>
  </view>

  <!-- 搜索栏：≥8 位客户（或已有搜索词）才出现。
       2026-10-17：原条件 `families.length > 0` → 只有 1 个客户时也占一行、且搜索是纯噪音。 -->
  <view class="search-bar" wx:if="{{families.length >= 8 || keyword}}">
    <view class="search-wrap">
      <!-- 2026-09-12：文案修正——服务端是双路匹配（family_name + 成员 name），原"搜索客户姓名"低估了能力 -->
      <input class="search-input" value="{{keyword}}" placeholder="搜索客户或成员姓名" bindinput="onSearch" aria-label="搜索客户" />
      <view class="search-clear pressable" wx:if="{{keyword}}" bindtap="onClearSearch">✕</view>
    </view>
    <!-- 2026-10-17：原搜索栏右侧「＋」已移除——新建客户入口统一收到底部吸底按钮（避免两处重复入口） -->
  </view>

  <!-- 加载中：骨架屏（UI 审计 状态 M5：与列表卡片同构） -->
  <block wx:if="{{loading && families.length === 0}}">
    <view class="sk-client-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-body">
        <view class="sk-row"><view class="sk-shimmer sk-name"></view><view class="sk-shimmer sk-label"></view></view>
        <view class="sk-shimmer sk-time"></view>
      </view>
    </view>
  </block>

  <!-- 列表 -->
  <view class="client-stagger {{removingId === item._id ? 'card-removing' : ''}}" wx:for="{{families}}" wx:key="_id" wx:for-index="idx">
    <client-card client="{{item}}" bindtap="onClientTap" bind:longpress="onClientLongPress" data-idx="{{idx}}" />
  </view>

  <!-- 审计 P2-16：listFamilies 上限 100，超出时明示（原静默截断，用户以为客户只有这些） -->
  <view class="empty-sub" wx:if="{{!loading && truncated}}" style="padding:var(--sp-4) 0">已显示前 100 位客户，可搜索客户或成员姓名精确查找</view>

  <!-- 2026-10-17：列表尾部口径提示。长按删除是**隐式手势**，全站此前没有一处文字说明
       （顾问不知道能删）；顺带给出客户总数，替代被移除的圆环所提供的"规模感"。
       搜索态不显示：此时 families 是命中集，写"共 N 位客户"会误导。 -->
  <view class="list-foot" wx:if="{{!loading && families.length > 0 && !keyword}}">共 {{families.length}} 位客户 · 长按卡片可删除</view>

  <!-- 错误态：加载失败优先于空态与搜索空态（客户列表审计 P1-1：网络/数据库失败不伪装"未找到"）。
       ⚠️ 三种空态各自写全条件、**不用 wx:elif** —— 上方截断提示与列表也是独立 wx:if，
          wx:elif 必须紧邻前一个 wx:if 兄弟节点，中间夹一个 wx:if 会把链断掉。 -->
  <view class="load-error" wx:if="{{!loading && families.length === 0 && loadError}}">
    <text class="load-error-text">客户列表加载失败</text>
    <view class="load-error-retry pressable" bindtap="onRetryLoad">点击重试</view>
  </view>

  <!-- 空态：搜索无结果 -->
  <view class="empty" wx:if="{{!loading && families.length === 0 && !loadError && keyword}}">
    <text class="empty-text">未找到"{{keyword}}"</text>
    <text class="empty-sub">换个关键词试试</text>
  </view>

  <!-- 空态：无任何客户 → 建档引导（原首页 onboarding；上传入口 2026-10-13 已移入客户详情页，
       先建客户再进详情页上传 → 上传时家庭已确定，省掉"这张保单属于谁"的匹配推断） -->
  <view class="orb-stage" wx:if="{{!loading && families.length === 0 && !loadError && !keyword}}">
    <view class="upload-box pressable" bindtap="onCreateFamily" aria-label="新建客户">
      <text class="upload-box-plus">＋</text>
      <text class="upload-box-text">新建客户</text>
    </view>
    <view class="onboard-steps">
      <view class="ob-step">
        <view class="ob-step-num">1</view>
        <text class="ob-step-text">新建客户（名称 / 人数）</text>
      </view>
      <view class="ob-step-line"></view>
      <view class="ob-step">
        <view class="ob-step-num">2</view>
        <text class="ob-step-text">进入客户后上传保单，AI 识别</text>
      </view>
      <view class="ob-step-line"></view>
      <view class="ob-step">
        <view class="ob-step-num">3</view>
        <text class="ob-step-text">生成保单整理报告</text>
      </view>
    </view>
  </view>
</view>

<!-- 新建客户弹窗（2026-10-17：名称 + 人数一次性录入）
     为什么不用 wx.showModal(editable)：① 它一次只能收一个字段 → 名称/人数必须拆成两步；
     ② 它**先关弹窗再回调**，名称为空时只剩一个 toast，输入框连同已打的字一起消失
     （用户实报的正是这个）。自定义弹窗把校验留在原地：空名称标红、输入不丢、人数由步进器限死。
     ⚠️ 必须在 .page 之外：.page-view 的常驻 transform 会为 position:fixed 后代建立包含块。 -->
<view class="cf-mask" wx:if="{{createModal.visible}}" catchtouchmove="onNoop" bindtap="onCreateMaskTap">
  <view class="cf-card" catchtap="onNoop">
    <view class="cf-title">新建客户</view>

    <input class="cf-input {{createModal.error ? 'is-error' : ''}}" value="{{createModal.name}}"
           placeholder="客户名称，如：李姐-转介绍" placeholder-class="cf-ph"
           maxlength="20" focus="{{createModal.visible}}" disabled="{{createModal.submitting}}"
           cursor-spacing="32" bindinput="onCreateNameInput" aria-label="客户名称" />
    <!-- 校验就地报错：不用 toast（toast 不指向具体字段，也没有"改哪"的提示） -->
    <view class="cf-error" wx:if="{{createModal.error}}">{{createModal.error}}</view>

    <view class="cf-row">
      <!-- 2026-10-17：口语化桥接 —— 上一行刚填"客户名称"，这里问"家里几口人"才不自相矛盾
           （两层术语：客户=档案，家庭=档案里的人）。 -->
      <text class="cf-label">家里几口人</text>
      <view class="cf-stepper">
        <view class="cf-step pressable {{createModal.count <= 0 || createModal.submitting ? 'is-off' : ''}}" bindtap="onCountMinus" aria-label="减少一位家庭成员">−</view>
        <text class="cf-count {{createModal.count === 0 ? 'is-empty' : ''}}">{{createModal.count > 0 ? createModal.count + ' 人' : '暂不填'}}</text>
        <view class="cf-step pressable {{createModal.count >= 10 || createModal.submitting ? 'is-off' : ''}}" bindtap="onCountPlus" aria-label="增加一位家庭成员">+</view>
      </view>
    </view>
    <view class="cf-hint">人数用于先建占位成员（成员1、成员2…），姓名与角色可在客户页补充；不确定就留空。</view>

    <view class="cf-actions">
      <view class="cf-btn cf-btn--ghost pressable {{createModal.submitting ? 'is-disabled' : ''}}" bindtap="onCreateCancel">取消</view>
      <view class="cf-btn cf-btn--primary pressable {{createModal.submitting ? 'is-loading' : ''}}" bindtap="onCreateSubmit">{{createModal.submitting ? '创建中...' : '创建'}}</view>
    </view>
  </view>
</view>

<!-- 吸底「新建客户」按钮（2026-10-17 用户决策，替代右下角 FAB）：
     ① 带文字 → 消除「＋」在新客户 / 上传保单 / 新报告之间的语义歧义；
     ② 吸底一行比悬浮圆点更符合"列表为主体、动作为辅"的层级（原 FAB 是页面上唯一的强调色元素）。
     ⚠️ 必须留在 .page 之外：.page-view 带常驻 transform（pageEnter 动画），
        transform 会为 position:fixed 后代建立包含块 → 写进 .page 内会相对容器定位而错位。
     显隐沿用原 FAB 口径：非空态（有客户）且 OCR 弹层未占用时才出现；
     空态由下方建档引导承担同一动作，避免两个入口并列。 -->
<view class="create-bar {{families.length > 0 && !ocrBusy ? 'create-bar--show' : ''}}">
  <button class="create-bar-btn pressable" bindtap="onCreateFamily" aria-label="新建客户">＋ 新建客户</button>
</view>

<!-- OCR 全流程组件 —— ⚠️ 必须留在 .page 之外（与上面 FAB 同理），勿以"结构整洁"为由移入。
     2026-09-18 布局审计曾建议移入 .page，已查实**不可移动**：.page-view 带常驻 transform
     （pageEnter 动画 + fill-mode both → 终帧 translateY(0) 仍非 none），而 transform 会为
     position:fixed 后代建立包含块 → 本组件内 .ocr-mask（fixed 全屏遮罩）会改为相对 .page-view
     定位而错乱。app.wxss 对该动画已注明"不放在 page 选择器上"即为此原因。
     职责：未完成批次恢复（checkResume）+ 保存后跳转；上传入口在报告页（客户详情页）内。 -->
<ocr-flow id="ocrFlow" bind:busychange="onOcrBusy" bind:saved="onOcrSaved" bind:savedhome="onOcrSavedHome" bind:discarded="onOcrDiscarded" />
