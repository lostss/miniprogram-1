<!-- 保单整理报告（探索版 · MVP 内测）：只做归集/汇总/标注，不出建议、不加形容词 -->
<view class="page page-view">

  <!-- 加载态 -->
  <view class="sk-card" wx:if="{{loading && !view}}">
    <view class="sk-line sk-w60 sk-shimmer"></view>
    <view class="sk-line sk-shimmer"></view>
    <view class="sk-line sk-w80 sk-shimmer"></view>
  </view>

  <!-- 失败态（含"还没有客户档案"） -->
  <view class="empty" wx:elif="{{error}}">
    <view class="empty-text">{{error}}</view>
    <view class="empty-btn pressable" bindtap="onRetry">重试</view>
  </view>

  <block wx:if="{{view}}">
    <!-- 客户切换（多客户时才出现） -->
    <scroll-view class="fam-strip" scroll-x wx:if="{{families.length > 1}}">
      <view class="fam-chip pressable {{item.id === familyId ? 'fam-chip-on' : ''}}"
            wx:for="{{families}}" wx:key="id" data-id="{{item.id}}" bindtap="onSwitchFamily">{{item.name}}</view>
    </scroll-view>

    <!-- ① 抬头：来源与时间 -->
    <view class="hd">
      <view class="hd-name">{{view.header.familyName}}</view>
      <view class="hd-meta">{{view.header.memberCount}} 位成员 · {{view.header.policyCount}} 张保单</view>
      <view class="hd-src" wx:if="{{view.summary.memberNote}}">{{view.summary.memberNote}}</view>
      <view class="hd-src" wx:if="{{view.header.dataAt}}">数据更新于 {{view.header.dataAt}}</view>
    </view>

    <!-- ② 一屏汇总 -->
    <view class="card">
      <view class="sum-grid">
        <view class="sum-item">
          <view class="sum-label">保单张数</view>
          <view class="sum-value">{{view.summary.policyCount}}</view>
        </view>
        <view class="sum-item">
          <view class="sum-label">年缴保费合计</view>
          <view class="sum-value">{{view.summary.annualPremiumText}}</view>
        </view>
      </view>
      <view class="sum-note" wx:if="{{view.summary.premiumNote}}">{{view.summary.premiumNote}}</view>
      <view class="sum-wide">
        <view class="sum-label">保额合计</view>
        <view class="sum-value-lg">{{view.summary.totalSumAssuredText}}</view>
        <view class="sum-note" wx:if="{{view.summary.shortTermCount > 0}}">
          其中一年期 {{view.summary.shortTermCount}} 张 · {{view.summary.shortTermSumAssuredText}}（每年需续保）
        </view>
      </view>
      <view class="sum-wide">
        <view class="sum-label">已覆盖险种</view>
        <view class="tags">
          <view class="tag" wx:for="{{view.summary.categories}}" wx:key="*this">{{item}}</view>
          <view class="tag-empty" wx:if="{{view.summary.categories.length === 0}}">暂无</view>
        </view>
      </view>
    </view>

    <!-- ③ 按成员分组（含无保单成员） -->
    <view class="sec-title">按成员整理</view>
    <view class="card" wx:for="{{view.groups}}" wx:key="memberId" wx:for-item="g">
      <view class="mem-hd">
        <view class="mem-name">{{g.name}}</view>
        <view class="mem-role" wx:if="{{g.role}}">{{g.role}}</view>
        <view class="mem-src">{{g.source}}</view>
      </view>
      <view class="mem-meta">{{g.policyCount}} 张保单 · 保额 {{g.sumAssuredText}}</view>

      <view class="pol-empty" wx:if="{{g.policyCount === 0}}">这 1 位成员名下暂无保单记录</view>

      <view class="pol" wx:for="{{g.policies}}" wx:key="id" wx:for-item="p">
        <view class="pol-title">
          <text class="pol-name">{{p.productName}}</text>
          <text class="pol-cat">{{p.category}}</text>
        </view>
        <view class="pol-row"><text class="k">保额</text><text class="v">{{p.sumAssuredText}}</text></view>
        <view class="pol-row"><text class="k">{{p.premiumLabel}}</text><text class="v">{{p.annualPremiumText}}</text></view>
        <view class="pol-row"><text class="k">保障期间</text><text class="v">{{p.period}}</text></view>
        <view class="pol-row"><text class="k">生效日</text><text class="v">{{p.effectiveDate}}</text></view>
        <view class="pol-flags">
          <text class="flag flag-term" wx:if="{{p.shortTerm}}">一年期 · 每年需续保</text>
          <text class="flag flag-low" wx:if="{{p.lowConfidence}}">含待核对字段</text>
        </view>
      </view>
    </view>

    <!-- ④ 未匹配保单 -->
    <block wx:if="{{view.unassigned.length > 0}}">
      <view class="sec-title">未归入成员（被保人不在成员名单）</view>
      <view class="card">
        <view class="pol" wx:for="{{view.unassigned}}" wx:key="id" wx:for-item="p">
          <view class="pol-title"><text class="pol-name">{{p.productName}}</text><text class="pol-cat">{{p.category}}</text></view>
          <view class="pol-row"><text class="k">被保人</text><text class="v">{{p.insuredName}}</text></view>
          <view class="pol-row"><text class="k">保额</text><text class="v">{{p.sumAssuredText}}</text></view>
        </view>
      </view>
    </block>

    <!-- ⑤ 待完善 -->
    <block wx:if="{{view.pending.length > 0}}">
      <view class="sec-title">待完善（{{view.pending.length}} 项）</view>
      <view class="card">
        <view class="pend" wx:for="{{view.pending}}" wx:key="index">
          <view class="pend-name">{{item.productName}}</view>
          <view class="pend-detail">{{item.detail}}</view>
        </view>
      </view>
    </block>

    <!-- ⑥ 来源与免责 -->
    <view class="foot">
      <view class="foot-line">数据来源：该客户已录入的保单记录（含 OCR 识别结果与人工修正）。</view>
      <view class="foot-line">本页只做整理与呈现，不含任何建议、测算或结论；金额为保单载明值。</view>
      <view class="foot-line" wx:if="{{view.pending.length > 0}}">标注为「待完善」的条目需人工核对后再采信。</view>
    </view>
  </block>
</view>
