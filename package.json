{
  "name": "miniprogram-1",
  "version": "1.0.0",
  "private": true,
  "description": "微信小程序保单管理 - 单元测试",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sync:shared": "node scripts/sync-shared.js",
    "check:shared": "node scripts/sync-shared.js --check",
    "check": "node scripts/sync-shared.js --check && jest --silent --coverage",
    "lint": "eslint cloudfunctions miniprogram tests",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0"
  }
}